#!/bin/sh
# pre-push - run ops\run-gates.ps1 and refuse the push unless it passes.
#
# WHY THIS EXISTS (2026-09-09). ThriftyCrew's own CLAUDE.md said "ops/run-gates.ps1 is the change-time
# gate and runs on every push". It did not, and had not since 2026-08-11. gates.yml ran `on: push` to
# main plus pull_request until commit b8b5ac1c9, when GitHub-hosted Actions minutes were exhausted and
# all three workflows went `workflow_dispatch`-only together. RUNTIME-MAP recorded that for daily.yml
# and heartbeat.yml and never named gates.yml, so the CHANGE-TIME gate went quiet as collateral of a
# cost decision about scheduled jobs. No pre-push hook existed. No scheduled task calls run-gates.
#
# So for a month a push was gated exactly as much as the person pushing chose to gate it, while the
# instructions every session reads asserted otherwise. This restores the property at zero money cost.
#
# ONCE PER PUSH, NOT ONCE PER COMMIT. That is the point and it is why this is cheaper than the habit it
# replaces: a session that makes four commits and pushes once now runs the full 306 gates ONCE. On
# 2026-09-09 the gate went from 78s to 51s by dispatching into one pool instead of four, so the price
# of this hook is about 51 seconds of a manual push.
#
# WHY NOT RUN ONLY THE GATES A CHANGE CAN AFFECT. Measured, not assumed: the longest single gate is
# ~31s inside a 51s wall, and the expensive static detectors - audit-guard-contract, audit-write-only-
# reports, audit-source-control-bytes, audit-script-census - all scan the WHOLE TREE, so no file-based
# selection can skip them. A perfect selector would save about 20 seconds, in exchange for making "no
# gate matched your change" and "the gates found nothing" the same bytes. That is the shape
# .claude/rules/ops-and-gates.md warns about and how a gate goes quietly unfirable. Not worth 20s.
#
# THE EXIT CODE IS READ, NEVER THE TALLY. run-gates: 0 = passed, 1 = at least one gate failed,
# 3 = COULD NOT EVALUATE - nothing was judged, which is never the tree being clean. A 3 has SEVERAL causes and
# the refusal below reads which one from the gate's own blind= marker: discovery collapsing, no gate worker slot
# inside the wait, a push the remote will already reject, a pool that returned a different number of results than
# it dispatched, or a self-test that exited 0 without its own verdict. A 3 is NEVER a pass and is refused here as
# loudly as a 1, whichever cause it was and even when the gate named none.
#
# IT STANDS IN FRONT OF THE AUTOMATED PUSHES TOO, deliberately, and that is worth knowing before it
# surprises somebody: the ~07:00 bot and wave-publish both push. run-gates is HERMETIC - it reads
# source and frozen fixtures, never a board - so ordinary daily data churn CANNOT fail it. An automated
# push is blocked only when the SOURCE is genuinely broken, which is exactly when it should be. The
# refusal goes to stderr and lands in the caller's log.
#
# BYPASS IS DELIBERATE AND LOUD: `git push --no-verify`. A gate with no escape hatch is a gate somebody
# uninstalls. ops\audit-hook-installed.ps1 asserts this file is live, so skipping it is a choice
# somebody made rather than a state nobody noticed.
#
# Install:  powershell -File ops\install-hooks.ps1

# A push that only DELETES refs introduces no new code to gate. stdin carries one line per ref as
# "<local ref> <local sha> <remote ref> <remote sha>", and an all-zero local sha is a deletion.
# READ BEFORE ANYTHING ASKS GIT FOR THE TREE (2026-09-11). The tree refusal below used to come first, so
# while the shared repository was bare a push that only deleted a branch was refused along with every
# other push. A deletion carries no code for the gate to read and needs no working tree to judge.
# The ref lines are kept for the test-auditors check below, which needs to know WHAT is being pushed.
refs="${TMPDIR:-/tmp}/tc-prepush-refs-$$.txt"
: > "$refs"
have_work=0
while read -r lref lsha rref rsha; do
  [ -z "$lsha" ] && continue
  echo "$lref $lsha $rref $rsha" >> "$refs"
  case "$lsha" in
    *[!0]*) have_work=1 ;;
  esac
done
if [ "$have_work" -eq 0 ]; then
  rm -f "$refs"
  exit 0
fi

repo="$(git rev-parse --show-toplevel 2>/dev/null)"
# NO WORKING TREE IS A REFUSAL, NOT A PASS (2026-09-10). This line used to `exit 0`. While the shared
# repository was turned bare by the incident described below the unset line, --show-toplevel failed in
# every checkout, and a sibling session's push at 05:28:19 went out through this hook with no gate run
# and no log. A hook that cannot find the tree it is meant to gate has verified nothing - the same rule
# this file already applies to a missing gate.
if [ -z "$repo" ]; then
  rm -f "$refs"
  echo "pre-push: REFUSING - git could not resolve this checkout's working tree, so nothing gated this push." >&2
  echo "          If 'git config core.bare' says true in a checkout, the shared config is damaged: repair that first." >&2
  echo "          Bypass with: git push --no-verify" >&2
  exit 1
fi
gate="$repo/ops/run-gates.ps1"

# A MISSING GATE MUST NOT READ AS A PASS. That is the fail-open-reads-as-empty class, and it is exactly
# how a guard stops guarding without anyone editing it. Same rule the pre-commit hook states.
if [ ! -f "$gate" ]; then
  rm -f "$refs"
  echo "pre-push: REFUSING - ops/run-gates.ps1 is missing, so nothing verified this push." >&2
  echo "          Restore it, or push with --no-verify if you have decided that is right." >&2
  exit 1
fi

ta="$repo/ops/prepush-test-auditors.ps1"
if [ ! -f "$ta" ]; then
  rm -f "$refs"
  echo "pre-push: REFUSING - ops/prepush-test-auditors.ps1 is missing, so nothing can say whether this push blinds a guard." >&2
  echo "          Restore it, or push with --no-verify if you have decided that is right." >&2
  exit 1
fi

# THE GATE RUNS WITH NO REPOSITORY ENVIRONMENT (2026-09-10). A push from a LINKED worktree makes git
# export GIT_DIR=<common .git>/worktrees/<name> to this hook; a push from the main checkout exports
# none, which is why nobody had seen this. run-gates inherited it, and so did its hermetic git
# self-tests: their temp-repo `git init` and `git config user.name` landed on the SHARED repository.
# Measured on the first push from a detached gate-check checkout: core.bare=true, user.name=Session,
# user.email=t@t, core.autocrlf=false and commit.gpgsign=false written into the common .git/config,
# and every checkout on the box then refused `git status` until it was repaired by hand. The gate
# needs none of these - run-gates finds the repo from its own path - and `repo` above is already
# resolved. ops/test-prepush-hook.ps1 drives this hook from a linked worktree in a sandbox.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

# SEED A BLIND CHECKOUT ONCE, BEFORE THE GATE (2026-09-11). meal-prep/db/built is gitignored and
# .worktreeinclude structurally CANNOT carry it: Claude Code's candidate list is built with
# `git ls-files --directory`, which collapses a fully-ignored directory to ONE line - measured that day as
# 1 line against 1,168 files on disk. So a fresh worktree has no built card, and feed-covers-published and
# wave-preaudit could not look. Both now report that BLIND rather than FAIL, which stops the refusal; this
# makes them actually LOOK, which is the half that restores the coverage. Measured 2026-09-11: 31 of 106
# worktrees had no card, and 18 of 53 failed gate runs that day failed on nothing else
# (design/PLAN-gate-queue-2026-09-11.md).
#
# BEST EFFORT, NEVER A VERDICT. Seeding is an enabler, not a check, so a seed that cannot run must not
# refuse the push - the gates then report BLIND, which is the honest outcome and is printed. That is why
# this does not follow the "a missing gate is a refusal" rule the blocks above apply: those decide, this
# one only supplies. It runs at most once per checkout, because the guard below sees the seeded card.
seedcard="$repo/meal-prep/db/built/american-goulash-pasta.body.html"
seeder="$repo/ops/seed-worktree.ps1"
if [ ! -f "$seedcard" ] && [ -f "$seeder" ]; then
  echo "pre-push: this checkout has no built cards, so two gates would be BLIND - seeding once (47 MB)." >&2
  powershell -NoProfile -ExecutionPolicy Bypass -File "$seeder" -Target "$repo" >&2 || \
    echo "pre-push: seeding did not complete; the gates will report BLIND rather than fail." >&2
fi

# ONE PUSH AT A TIME ON THIS BOX (2026-09-11, design/PLAN-push-livelock-2026-09-11.md).
# git fixes a push's refs when it connects, and the remote updates a ref only if it STILL holds the sha this hook was
# handed. So a push is a compare-and-swap whose critical section is this whole hook. Measured that day across 11
# consecutive attempts from one session: 577 to 1,840 s each, run-gates PASSED every time, and every single one was
# rejected with "cannot lock ref 'refs/heads/main' ... is at X but expected Y" while other sessions landed every 15 to
# 25 minutes. That is the starvation of the longest transaction under optimistic concurrency control, and the slowest
# push converges on never landing however green its gates are. The retry is not free either: the session must rebase,
# a rebase is genuinely new content, so the recorded verdict correctly does not apply and all 341 to 368 gates run
# again. Eleven attempts, eleven full gates, nothing landed.
#
# SERIALISING COSTS NO THROUGHPUT. refs/heads/main is ALREADY serialised - one push lands at a time whatever anyone
# does - so today's parallelism is not parallel landing, it is parallel GATING of which all but one result is thrown
# away. ops/probe-push-throughput.ps1 is the harness that holds that claim to account, and its numbers are in
# design/MEASURE-push-lock-2026-09-11.md.
#
# UNLOCKED IS NOT A REFUSAL. This is a FAIRNESS device; the gate is what makes a push safe, and nothing in the lock
# reads a tree. This file is installed in the SHARED .git and stands in front of every checkout on this box, most of
# them older than this change, so every lock path degrades to the behaviour of the day before it existed: no holder
# script in the pushing checkout, a wedged queue, or anything thrown, and the push simply races for the ref as it
# always did. It is said out loud either way.
lockdir=""
release_push_lock() {
  if [ -n "$lockdir" ]; then
    : > "$lockdir/release" 2>/dev/null
    # The directory goes too: one per push would otherwise accumulate in %TEMP% forever, and the estate's
    # test-suites-leak-temp-dirs rule puts that on whoever allocated it. This does NOT wait for the holder to
    # notice - a `wait` here could block the hook's exit if the holder ever hung - so removing the release file
    # out from under it falls back to its SECOND end condition, the watched hook process disappearing, which is
    # about to happen anyway and is checked every 250 ms.
    rm -rf "$lockdir" 2>/dev/null
    lockdir=""
  fi
}
# EVERY EXIT PATH RELEASES, including the ones below this line that were written before the lock existed and the ones
# a future change adds. A trap is the only way to get that property without editing each of them.
trap release_push_lock EXIT
holder="$repo/ops/hold-push-lock.ps1"
# AND WHEN THIS CHECKOUT IS OLDER, THE MAIN ONE'S COPY (2026-09-12). The line above resolves the holder from the
# PUSHING checkout, so the lock reached only the worktrees that had rebased since it shipped - and a fairness device
# that reaches some of the queue is worse than none: the sessions that updated queue politely while the ones that did
# not sail past them to the ref. MEASURED that morning: 30 of 132 worktrees carried this script, 9 pushes were queued
# on the lock with the oldest waiting 13 minutes, and pushes from the other 102 were landing straight past them.
# The hook itself is installed in the SHARED .git and is always current, so it can reach the main checkout's copy,
# which is current too. hold-push-lock resolves lib\push-lock.ps1 from its OWN directory, so main's copy runs against
# main's library rather than an older worktree's.
# STILL NEVER A REFUSAL. If git cannot name the main checkout, or it has no copy either, $holder simply stays missing
# and this push races for the ref exactly as it did the day before the lock existed.
if [ ! -f "$holder" ]; then
  common="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  case "$common" in
    */.git)
      main_checkout="${common%/.git}"
      if [ -f "$main_checkout/ops/hold-push-lock.ps1" ]; then
        holder="$main_checkout/ops/hold-push-lock.ps1"
        echo "pre-push: this checkout has no push-lock holder, using the main checkout's - otherwise this push would jump the queue others are waiting in." >&2
      fi
      ;;
  esac
fi
if [ -f "$holder" ]; then
  lockdir="${TMPDIR:-/tmp}/tc-pushlock-$$"
  rm -rf "$lockdir"; mkdir -p "$lockdir"
  lockdir_win="$lockdir"
  if command -v cygpath >/dev/null 2>&1; then
    lockdir_win="$(cygpath -w "$lockdir")"
  fi
  # THE WINDOWS PID, NEVER `$$` (2026-09-11, and this silently disabled the whole lock in its first version).
  # The holder releases as soon as the hook it watches is gone, and it asks Get-Process. Git Bash's `$$` is an MSYS
  # pid from a DIFFERENT namespace: measured here, `$$` was 172200 while the real Windows pid was 135392, and
  # `Get-Process -Id 172200` threw ProcessCommandException. Test-TcProcessAlive reads a thrown
  # ProcessCommandException as "gone" - which is the right default for a pid it cannot find - so the holder decided
  # the hook was dead about 250 ms after taking the lock, and handed it straight back. Every sandbox case still
  # passed, because none of them could see WHEN the lock was released; the gate stub now takes that reading.
  # /proc/<pid>/winpid is the MSYS translation. With no /proc the watch is simply not armed, and the release file
  # plus the hang guard end the hold - degrade, never a refusal.
  lockwatch="$(cat /proc/$$/winpid 2>/dev/null)"
  case "$lockwatch" in
    ''|*[!0-9]*) lockwatch=0 ;;
  esac
  # </dev/null so the background child cannot inherit this hook's stdin, which the ref loop above has already read.
  powershell -NoProfile -ExecutionPolicy Bypass -File "$holder" -SignalDir "$lockdir_win" -WatchPid "$lockwatch" \
    > /dev/null 2>&1 < /dev/null &
  lockpid=$!
  echo "pre-push: waiting for the machine-wide push lock, so this push is not beaten to the ref after it passes." >&2
  # BOUNDED BY THE HOLDER BEING ALIVE, not by a clock here: the holder's own wait is the queue's, and a holder that
  # died without writing its state must not leave this hook waiting for a file nobody will write.
  while [ ! -f "$lockdir/state" ] && kill -0 "$lockpid" 2>/dev/null; do
    sleep 1
  done
  if [ -f "$lockdir/state" ]; then
    echo "pre-push: push lock - $(head -n 1 "$lockdir/state")" >&2
  else
    echo "pre-push: the push lock holder exited without saying anything, so this push races for the ref as it did before." >&2
    release_push_lock
  fi
fi

echo "pre-push: running ops/run-gates.ps1 (about 51s) - once for this push, not once per commit." >&2

# REDIRECT, THEN READ THE STATUS, THEN GREP THE FILE. Reading a status through a pipe gives the LAST
# stage's, not the gate's, which this estate has a memory about.
log="${TMPDIR:-/tmp}/tc-prepush-$$.log"
# THE GATE IS TOLD WHAT THIS PUSH IS (2026-09-11). Given the refs and the remote's URL it can ask whether any of
# them still holds the sha git handed this hook, and refuse in seconds - before queueing for a gate worker slot and
# running every gate - when another push has already landed and the remote will reject this one whatever the gates
# say (lib/push-landable.ps1). The path crosses into PowerShell in Windows form; with no cygpath the gate simply
# cannot read the file and decides nothing, which is the same as a remote it cannot reach.
refs_win="$refs"
if command -v cygpath >/dev/null 2>&1; then
  refs_win="$(cygpath -w "$refs")"
fi
# ONLY TO A GATE THAT ACCEPTS THEM. This hook is installed in the SHARED .git, so it stands in front of every
# checkout on this box, and most of them are older than this change. run-gates declares [CmdletBinding()], which
# makes an undeclared argument a HARD ERROR - so handing -PushRefsFile to an older copy would refuse every push from
# every worktree until each one rebased. The flags go only to a gate whose own source names them; an older checkout
# is gated exactly as it was before.
if grep -q "PushRefsFile" "$gate" 2>/dev/null; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$gate" -PushRefsFile "$refs_win" -PushRemote "$2" > "$log" 2>/dev/null
else
  powershell -NoProfile -ExecutionPolicy Bypass -File "$gate" > "$log" 2>/dev/null
fi
rc=$?

if [ "$rc" -eq 0 ]; then
  tail -n 1 "$log" >&2
  rm -f "$log"

  # TEST-AUDITORS BEFORE A GUARD-TOUCHING PUSH (2026-09-10, design/PLAN-zero-alert-days-2026-09-10.md
  # Phase 5). run-gates is hermetic and cannot reach grocery/test-auditors.ps1, which reads the boards, so
  # a commit that broke it went out past a clean gate (queue 2026-09-10-4ac6ae), and three "a GUARD has
  # gone blind" alerts in 20 days were a triage session's own in-flight edits. The check derives the
  # suite's inputs from its source, does NOT run it for a push that touches none of them, and refuses
  # only a failing case the daily chain's known-failures record does not already hold. A checkout with
  # no boards is exit 3 and refused, because a could-not-evaluate is never a pass. The whole account,
  # and the measurements behind each choice, are in the script's header.
  talog="${TMPDIR:-/tmp}/tc-prepush-ta-$$.log"
  powershell -NoProfile -ExecutionPolicy Bypass -File "$ta" -RefsFromStdin < "$refs" > "$talog" 2>/dev/null
  tarc=$?
  rm -f "$refs"
  grep -v -E "^PREPUSH-TEST-AUDITORS-COMPLETE" "$talog" >&2
  # An exit 0 counts only with the completion marker as the last line: a check that died early has
  # not decided anything.
  if [ "$tarc" -eq 0 ] && tail -n 1 "$talog" | grep -q -E "^PREPUSH-TEST-AUDITORS-COMPLETE"; then
    rm -f "$talog"
    exit 0
  fi
  echo "" >&2
  if [ "$tarc" -eq 0 ]; then
    echo "pre-push: BLOCKED - the test-auditors check exited 0 without its completion marker, so it decided nothing." >&2
  elif [ "$tarc" -eq 3 ]; then
    echo "pre-push: BLOCKED - the test-auditors check COULD NOT EVALUATE (exit 3). That is not a pass." >&2
  else
    echo "pre-push: BLOCKED - the test-auditors check exited $tarc. This push leaves a watcher that cannot see its own bug." >&2
    echo "          Fix the cause, never the guard and never the known-failures record." >&2
  fi
  echo "          full output kept at: $talog" >&2
  echo "          Bypass with: git push --no-verify" >&2
  exit 1
fi
rm -f "$refs"

echo "" >&2
if [ "$rc" -eq 3 ]; then
  # NAME THE CAUSE THE GATE ACTUALLY REPORTED (2026-09-12). This block said "that means gate discovery is
  # broken" for every 3, and by 2026-09-11 a 3 had at least three causes: discovery collapsing, the machine-wide
  # gate worker queue not moving for 20 minutes, and a push the remote will already reject. That afternoon a
  # standalone run-gates and then a push both waited about 20 minutes for one of the 10 slots while roughly 30
  # other run-gates processes queued and the box sat near 87%, and the hook told the pusher their discovery was
  # broken. A refusal that points at the wrong cause sends somebody to debug a walk that is fine, and the next
  # thing they reach for is --no-verify - so it must name what run-gates said, or say plainly that it could not
  # tell. THE REFUSAL IS UNCONDITIONAL EITHER WAY: every branch below falls through to the same exit 1.
  #
  # TWO READS, MARKER FIRST. Exit-Guard writes "RUN-GATES-COMPLETE blind=<token>" as the last line and the
  # token travels with the exit, so it is the reliable one. Two exit-3 paths carry no token - the pool-size
  # mismatch writes no marker at all, and the no-verdict path's marker counts suites - so the COULD NOT
  # EVALUATE line is the fallback, and a 3 with neither is reported as exactly that.
  blind="$(grep -o 'RUN-GATES-COMPLETE blind=[A-Za-z0-9_-]*' "$log" 2>/dev/null | tail -n 1 | sed 's/.*blind=//')"
  reason="$(grep -E '^run-gates: COULD NOT EVALUATE' "$log" 2>/dev/null | tail -n 1)"
  echo "pre-push: BLOCKED - run-gates COULD NOT EVALUATE (exit 3). A 3 is NEVER a pass." >&2
  case "$blind" in
    no-gate-worker-slot)
      echo "          CAUSE: no gate worker slot. The 10 machine-wide slots stayed held by other gate runs and" >&2
      echo "          the queue did not move, so NOTHING was run. That is CONTENTION on this box, not a broken" >&2
      echo "          tree and nothing wrong with this checkout. Let the other runs drain and push again; the" >&2
      echo "          gate's own line below says how long it waited and how many runs were ahead of it." >&2
      ;;
    push-cannot-land)
      echo "          CAUSE: this push can no longer land - the remote moved while it waited, so no gate was run" >&2
      echo "          for it. Fetch, rebase onto what the remote holds now, and push again." >&2
      ;;
    no-selftests|selftest-discovery-collapsed)
      echo "          CAUSE: gate DISCOVERY is broken. run-gates found no self-tests, or far fewer than this tree" >&2
      echo "          holds, so it refused to judge. Fix the walk; a tree that cannot be examined is not a clean one." >&2
      ;;
    ?*)
      echo "          CAUSE: the gate reported blind=$blind. Read its own line below before doing anything else." >&2
      ;;
    *)
      if [ -n "$reason" ]; then
        echo "          The gate named no blind= cause, so its own COULD NOT EVALUATE line below is the whole" >&2
        echo "          account. Read it rather than assuming which of the causes this was." >&2
      else
        echo "          The gate said nothing about WHY, so this refusal cannot name a cause. Read the full output" >&2
        echo "          below and let it say which cause this was; every guess here has been wrong at least once." >&2
      fi
      ;;
  esac
else
  echo "pre-push: BLOCKED - run-gates exited $rc. This tree must not be pushed until it passes." >&2
  echo "          Fix the cause, never the gate." >&2
fi
grep -E "^  FAIL|^run-gates: (FAILED|COULD NOT)" "$log" 2>/dev/null | head -12 >&2
echo "          full gate output kept at: $log" >&2
echo "          Bypass with: git push --no-verify" >&2
exit 1
