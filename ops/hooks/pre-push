#!/bin/sh
# pre-push - run ops\run-gates.ps1 and refuse the push unless it passes.
#
# WHY THIS EXISTS (2026-09-09). ThriftyCrew's own CLAUDE.md said "ops/run-gates.ps1 is the change-time
# gate and runs on every push". It did not, and had not since 2026-08-11. gates.yml ran `on: push` to
# main plus pull_request until commit b8b5ac1c9, when GitHub-hosted Actions minutes were exhausted and
# all three workflows went `workflow_dispatch`-only together. RUNTIME-MAP recorded that for daily.yml
# and heartbeat.yml and never named gates.yml, so the CHANGE-TIME gate went quiet as collateral of a
# cost decision about scheduled jobs. No pre-push hook existed. No scheduled task calls run-gates.
#
# So for a month a push was gated exactly as much as the person pushing chose to gate it, while the
# instructions every session reads asserted otherwise. This restores the property at zero money cost.
#
# ONCE PER PUSH, NOT ONCE PER COMMIT. That is the point and it is why this is cheaper than the habit it
# replaces: a session that makes four commits and pushes once now runs the full 306 gates ONCE. On
# 2026-09-09 the gate went from 78s to 51s by dispatching into one pool instead of four, so the price
# of this hook is about 51 seconds of a manual push.
#
# WHY NOT RUN ONLY THE GATES A CHANGE CAN AFFECT. Measured, not assumed: the longest single gate is
# ~31s inside a 51s wall, and the expensive static detectors - audit-guard-contract, audit-write-only-
# reports, audit-source-control-bytes, audit-script-census - all scan the WHOLE TREE, so no file-based
# selection can skip them. A perfect selector would save about 20 seconds, in exchange for making "no
# gate matched your change" and "the gates found nothing" the same bytes. That is the shape
# .claude/rules/ops-and-gates.md warns about and how a gate goes quietly unfirable. Not worth 20s.
#
# THE EXIT CODE IS READ, NEVER THE TALLY. run-gates: 0 = passed, 1 = at least one gate failed,
# 3 = COULD NOT EVALUATE, which means discovery is broken rather than the tree being clean. A 3 is
# NEVER a pass and is refused here as loudly as a 1.
#
# IT STANDS IN FRONT OF THE AUTOMATED PUSHES TOO, deliberately, and that is worth knowing before it
# surprises somebody: the ~07:00 bot and wave-publish both push. run-gates is HERMETIC - it reads
# source and frozen fixtures, never a board - so ordinary daily data churn CANNOT fail it. An automated
# push is blocked only when the SOURCE is genuinely broken, which is exactly when it should be. The
# refusal goes to stderr and lands in the caller's log.
#
# BYPASS IS DELIBERATE AND LOUD: `git push --no-verify`. A gate with no escape hatch is a gate somebody
# uninstalls. ops\audit-hook-installed.ps1 asserts this file is live, so skipping it is a choice
# somebody made rather than a state nobody noticed.
#
# Install:  powershell -File ops\install-hooks.ps1

# A push that only DELETES refs introduces no new code to gate. stdin carries one line per ref as
# "<local ref> <local sha> <remote ref> <remote sha>", and an all-zero local sha is a deletion.
# READ BEFORE ANYTHING ASKS GIT FOR THE TREE (2026-09-11). The tree refusal below used to come first, so
# while the shared repository was bare a push that only deleted a branch was refused along with every
# other push. A deletion carries no code for the gate to read and needs no working tree to judge.
# The ref lines are kept for the test-auditors check below, which needs to know WHAT is being pushed.
refs="${TMPDIR:-/tmp}/tc-prepush-refs-$$.txt"
: > "$refs"
have_work=0
while read -r lref lsha rref rsha; do
  [ -z "$lsha" ] && continue
  echo "$lref $lsha $rref $rsha" >> "$refs"
  case "$lsha" in
    *[!0]*) have_work=1 ;;
  esac
done
if [ "$have_work" -eq 0 ]; then
  rm -f "$refs"
  exit 0
fi

repo="$(git rev-parse --show-toplevel 2>/dev/null)"
# NO WORKING TREE IS A REFUSAL, NOT A PASS (2026-09-10). This line used to `exit 0`. While the shared
# repository was turned bare by the incident described below the unset line, --show-toplevel failed in
# every checkout, and a sibling session's push at 05:28:19 went out through this hook with no gate run
# and no log. A hook that cannot find the tree it is meant to gate has verified nothing - the same rule
# this file already applies to a missing gate.
if [ -z "$repo" ]; then
  rm -f "$refs"
  echo "pre-push: REFUSING - git could not resolve this checkout's working tree, so nothing gated this push." >&2
  echo "          If 'git config core.bare' says true in a checkout, the shared config is damaged: repair that first." >&2
  echo "          Bypass with: git push --no-verify" >&2
  exit 1
fi
gate="$repo/ops/run-gates.ps1"

# A MISSING GATE MUST NOT READ AS A PASS. That is the fail-open-reads-as-empty class, and it is exactly
# how a guard stops guarding without anyone editing it. Same rule the pre-commit hook states.
if [ ! -f "$gate" ]; then
  rm -f "$refs"
  echo "pre-push: REFUSING - ops/run-gates.ps1 is missing, so nothing verified this push." >&2
  echo "          Restore it, or push with --no-verify if you have decided that is right." >&2
  exit 1
fi

ta="$repo/ops/prepush-test-auditors.ps1"
if [ ! -f "$ta" ]; then
  rm -f "$refs"
  echo "pre-push: REFUSING - ops/prepush-test-auditors.ps1 is missing, so nothing can say whether this push blinds a guard." >&2
  echo "          Restore it, or push with --no-verify if you have decided that is right." >&2
  exit 1
fi

# THE GATE RUNS WITH NO REPOSITORY ENVIRONMENT (2026-09-10). A push from a LINKED worktree makes git
# export GIT_DIR=<common .git>/worktrees/<name> to this hook; a push from the main checkout exports
# none, which is why nobody had seen this. run-gates inherited it, and so did its hermetic git
# self-tests: their temp-repo `git init` and `git config user.name` landed on the SHARED repository.
# Measured on the first push from a detached gate-check checkout: core.bare=true, user.name=Session,
# user.email=t@t, core.autocrlf=false and commit.gpgsign=false written into the common .git/config,
# and every checkout on the box then refused `git status` until it was repaired by hand. The gate
# needs none of these - run-gates finds the repo from its own path - and `repo` above is already
# resolved. ops/test-prepush-hook.ps1 drives this hook from a linked worktree in a sandbox.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

echo "pre-push: running ops/run-gates.ps1 (about 51s) - once for this push, not once per commit." >&2

# REDIRECT, THEN READ THE STATUS, THEN GREP THE FILE. Reading a status through a pipe gives the LAST
# stage's, not the gate's, which this estate has a memory about.
log="${TMPDIR:-/tmp}/tc-prepush-$$.log"
# THE GATE IS TOLD WHAT THIS PUSH IS (2026-09-11). Given the refs and the remote's URL it can ask whether any of
# them still holds the sha git handed this hook, and refuse in seconds - before queueing for a gate worker slot and
# running every gate - when another push has already landed and the remote will reject this one whatever the gates
# say (lib/push-landable.ps1). The path crosses into PowerShell in Windows form; with no cygpath the gate simply
# cannot read the file and decides nothing, which is the same as a remote it cannot reach.
refs_win="$refs"
if command -v cygpath >/dev/null 2>&1; then
  refs_win="$(cygpath -w "$refs")"
fi
# ONLY TO A GATE THAT ACCEPTS THEM. This hook is installed in the SHARED .git, so it stands in front of every
# checkout on this box, and most of them are older than this change. run-gates declares [CmdletBinding()], which
# makes an undeclared argument a HARD ERROR - so handing -PushRefsFile to an older copy would refuse every push from
# every worktree until each one rebased. The flags go only to a gate whose own source names them; an older checkout
# is gated exactly as it was before.
if grep -q "PushRefsFile" "$gate" 2>/dev/null; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$gate" -PushRefsFile "$refs_win" -PushRemote "$2" > "$log" 2>/dev/null
else
  powershell -NoProfile -ExecutionPolicy Bypass -File "$gate" > "$log" 2>/dev/null
fi
rc=$?

if [ "$rc" -eq 0 ]; then
  tail -n 1 "$log" >&2
  rm -f "$log"

  # TEST-AUDITORS BEFORE A GUARD-TOUCHING PUSH (2026-09-10, design/PLAN-zero-alert-days-2026-09-10.md
  # Phase 5). run-gates is hermetic and cannot reach grocery/test-auditors.ps1, which reads the boards, so
  # a commit that broke it went out past a clean gate (queue 2026-09-10-4ac6ae), and three "a GUARD has
  # gone blind" alerts in 20 days were a triage session's own in-flight edits. The check derives the
  # suite's inputs from its source, does NOT run it for a push that touches none of them, and refuses
  # only a failing case the daily chain's known-failures record does not already hold. A checkout with
  # no boards is exit 3 and refused, because a could-not-evaluate is never a pass. The whole account,
  # and the measurements behind each choice, are in the script's header.
  talog="${TMPDIR:-/tmp}/tc-prepush-ta-$$.log"
  powershell -NoProfile -ExecutionPolicy Bypass -File "$ta" -RefsFromStdin < "$refs" > "$talog" 2>/dev/null
  tarc=$?
  rm -f "$refs"
  grep -v -E "^PREPUSH-TEST-AUDITORS-COMPLETE" "$talog" >&2
  # An exit 0 counts only with the completion marker as the last line: a check that died early has
  # not decided anything.
  if [ "$tarc" -eq 0 ] && tail -n 1 "$talog" | grep -q -E "^PREPUSH-TEST-AUDITORS-COMPLETE"; then
    rm -f "$talog"
    exit 0
  fi
  echo "" >&2
  if [ "$tarc" -eq 0 ]; then
    echo "pre-push: BLOCKED - the test-auditors check exited 0 without its completion marker, so it decided nothing." >&2
  elif [ "$tarc" -eq 3 ]; then
    echo "pre-push: BLOCKED - the test-auditors check COULD NOT EVALUATE (exit 3). That is not a pass." >&2
  else
    echo "pre-push: BLOCKED - the test-auditors check exited $tarc. This push leaves a watcher that cannot see its own bug." >&2
    echo "          Fix the cause, never the guard and never the known-failures record." >&2
  fi
  echo "          full output kept at: $talog" >&2
  echo "          Bypass with: git push --no-verify" >&2
  exit 1
fi
rm -f "$refs"

echo "" >&2
if [ "$rc" -eq 3 ]; then
  echo "pre-push: BLOCKED - run-gates COULD NOT EVALUATE (exit 3). A 3 is never a pass, and the gate's own" >&2
  echo "          reason is the line below: broken discovery, a queue that stopped moving, or a push that" >&2
  echo "          can no longer land because the remote moved (rebase and push again)." >&2
else
  echo "pre-push: BLOCKED - run-gates exited $rc. This tree must not be pushed until it passes." >&2
  echo "          Fix the cause, never the gate." >&2
fi
grep -E "^  FAIL|^run-gates: (FAILED|COULD NOT)" "$log" 2>/dev/null | head -12 >&2
echo "          full gate output kept at: $log" >&2
echo "          Bypass with: git push --no-verify" >&2
exit 1
