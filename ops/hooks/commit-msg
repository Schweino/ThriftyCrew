#!/usr/bin/env bash
# commit-msg - three checks on the message of the commit being made, in this order:
#   1. refuse a message that begins with a UTF-8 byte order mark (every commit);
#   2. STORE CITATION: a Claude session's code commit names what the knowledge store told it (ops/store_citation.py);
#   3. PLAN CITATION: a Claude session's commit that changes a file an under-way plan names cites that plan
#      (ops/plan_citation.py, W7.2 of design/PLAN-push-derived-conflicts-2026-09-23.md).
# 2 and 3 run from the COMMITTING checkout's own copy, judge only when CLAUDE_CODE_SESSION_ID is set, and both run
# before the hook decides, so one commit shows every finding at once. Anything they cannot evaluate is a BLIND line
# and never a refusal: each refuses on exit 10 and on no other code (2026-09-24 for 2, W7.2 for 3).
#
# THE BOM CHECK (1):
# WHY THIS EXISTS (2026-09-07). Commit 79c62b0f0's subject line starts EF BB BF:
#
#     $ git log -1 --format=%s 79c62b0f0 | head -c 6 | xxd -p
#     efbbbf546865
#
# Under PS 5.1 `Set-Content -Encoding utf8` writes a BOM, and the estate's own rule is that commit
# messages go in a FILE and ship with `git commit -F` (an inline -m executes backticks). So the rule
# that keeps backticks out of a commit is the same rule that put a BOM into one. The three characters
# then live inside the subject for ever: they break `git log --grep`, they sort oddly, and they show up
# as garbage in any reader that is not expecting a BOM mid-stream. Cosmetic, but permanent, and the
# fix cannot be retrospective - rewriting pushed history is worse than the blemish.
#
# WHY A commit-msg HOOK AND NOT pre-commit. A pre-commit hook CANNOT read the message it is about to
# commit: at that point .git/COMMIT_EDITMSG still holds the PREVIOUS commit's text, which is a trap
# this estate has already been bitten by. commit-msg receives the path to the real message as $1.
#
# WHY REFUSE RATHER THAN STRIP. A hook that silently rewrites what somebody wrote is a hook nobody can
# reason about, and the author is standing right there with the file open. It names the file and the
# one-line fix instead.
#
# Install:  powershell -File ops\install-hooks.ps1
set -u

msg="${1:-}"
[ -z "$msg" ] && exit 0
[ -f "$msg" ] || exit 0

# The first three BYTES, read as bytes. Reading this as text is how the BOM became invisible in the
# first place: most decoders swallow it and hand back a string that looks perfectly clean.
first3="$(head -c 3 "$msg" | od -An -tx1 | tr -d ' \n')"
if [ "$first3" = "efbbbf" ]; then
  echo "commit-msg: BLOCKED. The message file starts with a UTF-8 BOM (EF BB BF), which would land" >&2
  echo "            INSIDE the commit subject and stay there for the life of the repository." >&2
  echo "            This is what PS 5.1's \`Set-Content -Encoding utf8\` does. Write it BOM-less:" >&2
  echo "              [IO.File]::WriteAllText(\$p, \$body, (New-Object Text.UTF8Encoding(\$false)))" >&2
  echo "            or use ops\\new-commit-message.ps1, then re-run the commit." >&2
  echo "            File: $msg" >&2
  exit 1
fi

# STORE CITATION (Brad, 2026-09-18). A Claude session's commit that changes code names the knowledge-store
# files it used, or says what it searched and found nothing. ops/store_citation.py holds the rule, its
# warn-then-refuse date and its fixtures; this only calls it. A human or the bot (no CLAUDE_CODE_SESSION_ID)
# is not judged, and a missing interpreter or script is never a refusal.
#
# A CHECKOUT WITH NO COPY OF THE RULE SAYS SO (2026-09-23, W0.2 of
# design/PLAN-brain-consults-on-code-and-analysis-2026-09-22.md). The rule runs from the COMMITTING checkout's
# own copy, so a branch can test its own edit to it. This hook is shared by every checkout, though, and on
# 2026-09-22 57 of 92 checkouts had no ops/store_citation.py at all: their commits were never judged and the
# hook said nothing. A could-not-look is never a refusal, and it is never silent either.
#
# IT FAILS OPEN, LIKE PLAN CITATION BELOW (Brad's ruling, 2026-09-24: "Match plan-citation (Recommended)"). Until that
# day this block refused on ANY non-zero code, so a traceback in store_citation.py refused the commit. Its ONE refusal
# code is now 10 (its REFUSE_EXIT, the same value plan_citation.py uses); every other non-zero code is printed as BLIND
# and the commit goes through.
py="/c/Codex/Python312/python.exe"
top="$(git rev-parse --show-toplevel 2>/dev/null)"
refuse=0
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  if [ ! -f "$top/ops/store_citation.py" ]; then
    echo "store-citation: BLIND - this checkout has no ops/store_citation.py; the commit is not judged" >&2
  elif [ ! -x "$py" ]; then
    echo "store-citation: BLIND - no interpreter at $py; the commit is not judged" >&2
  else
    "$py" "$top/ops/store_citation.py" --commit-msg "$msg"
    src=$?
    case "$src" in
      0) ;;
      10) refuse=1 ;;
      *) echo "store-citation: BLIND - ops/store_citation.py exited $src, which is not a verdict (only 0 and 10 are); the commit is not judged" >&2 ;;
    esac
  fi
fi

# PLAN CITATION (W7.2 of design/PLAN-push-derived-conflicts-2026-09-23.md, 2026-09-23). A Claude session's commit
# that changes a file named by a plan on origin/main whose Status line says ruled or build under way carries a
# `Plan: <that plan>` line or `Plan-not-applicable: <reason>`. On 2026-09-23 a sibling session changed
# ops/push-main.ps1 54 minutes after that plan named it, cited nothing, and the design was built twice.
# ops/plan_citation.py holds the rule, its warn-then-refuse date (Brad's D18: refuse from 7 days after landing) and
# its fixtures; this only calls it.
# IT FAILS OPEN. The script's ONE refusal code is 10 (its REFUSE_EXIT). Every other non-zero code - a traceback's 1, an
# unopenable file's 2, a killed interpreter - is printed as BLIND and the commit goes through, so a broken copy of the
# rule in some checkout can never refuse a commit. A missing script or interpreter is BLIND too, and never silent.
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  if [ ! -f "$top/ops/plan_citation.py" ]; then
    echo "plan-citation: BLIND - this checkout has no ops/plan_citation.py; the commit is not judged" >&2
  elif [ ! -x "$py" ]; then
    echo "plan-citation: BLIND - no interpreter at $py; the commit is not judged" >&2
  else
    "$py" "$top/ops/plan_citation.py" --commit-msg "$msg"
    prc=$?
    case "$prc" in
      0) ;;
      10) refuse=1 ;;
      *) echo "plan-citation: BLIND - ops/plan_citation.py exited $prc, which is not a verdict (only 0 and 10 are); the commit is not judged" >&2 ;;
    esac
  fi
fi
[ "$refuse" -eq 0 ] || exit 1
exit 0
