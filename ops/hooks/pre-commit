#!/usr/bin/env bash
# pre-commit - run ops\verify-bulk-edit.ps1 on the STAGED set, and refuse the commit if it finds anything.
#
# WHY THIS EXISTS (2026-09-05). A regex sweep over 608 call sites in 191 files introduced six defects, and
# the estate already held a correct memo for every one of them. They did not fire, because a memo only works
# if someone stops and looks - and nobody stops before an edit they believe is mechanical.
#
# So verify-bulk-edit.ps1 was written as the enumeration those memos should have been. Within the hour,
# audit-guard-contract flagged it:
#
#     ! DEAD: verify-bulk-edit.ps1 is a detector that NOTHING in production calls
#
# A checker you have to remember to run has exactly the disease of the notes it replaced. This hook is the
# repair lane: it fires on every commit in this repo whether anyone remembers it or not.
#
# IT ALSO CATCHES THE BOT. On the day this was written push-data.ps1 ran `git add -A` on the real working
# tree and committed AND PUSHED an unverified sweep to main under the message "Local browser-store refresh"
# - a tree in which 27 scripts threw at startup. That job does not read anyone's instructions, and telling a
# spawned agent "never git add -A" does nothing about it. A hook is the only thing in the path of BOTH a
# careless human and an automated one.
#
# THE SWEEP WAS 325 FILES, NOT 202 (measured 2026-09-06 from `git show --stat 3c44d0c1`): 192 .ps1 plus 133
# others - 95 under grocery\out, 9 source files under grocery\, 4 under meal-prep\db, site\tools and
# public\. The "202" written here on 2026-09-05 undercounted by the data half of the sweep.
#
# SECOND CHECK, ADDED 2026-09-06 (PLAN-top5 area 3). verify-bulk-edit judges the SHAPE of what is staged
# (BOM, line endings, a clean parse, resolvable calls) and would have passed all 192 of those files if they
# had merely been finished. verify-bot-commit-scope judges the SCOPE: a commit that identifies itself as
# the pipeline may only stage what lib\bot-paths.ps1 declares it owns. Sessions are untouched by it.
#
# BYPASS IS DELIBERATE BUT LOUD. `git commit --no-verify` skips this, which is correct for a genuine
# emergency; ops\audit-hook-installed.ps1 asserts the hook is present so that skipping it is a choice
# somebody made rather than a state nobody noticed.
#
# Install:  powershell -File ops\install-hooks.ps1
set -u

# Only the STAGED set matters: unstaged work in a shared tree belongs to another session, and failing a
# commit over someone else's in-flight edit is how a gate gets uninstalled.
staged="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)"
[ -z "$staged" ] && exit 0

repo="$(git rev-parse --show-toplevel 2>/dev/null)"
# NO WORKING TREE IS A REFUSAL, NOT A PASS (2026-09-11). This line used to `exit 0`, the shape that let a
# push out ungated on 2026-09-10 (ops/hooks/pre-push has the account). A hook that cannot find what it
# checks has checked nothing, so it refuses. No fixture reaches this branch: with core.bare=true git itself
# refused `git commit` from both the main checkout and a linked worktree with "this operation must be run in
# a work tree", before this hook ran (measured 2026-09-11, git 2.54). It stays for a git or caller that does not.
if [ -z "$repo" ]; then
  echo "pre-commit: REFUSING - git could not resolve this checkout's working tree, so nothing verified this commit." >&2
  echo "            If 'git config core.bare' says true in a checkout, the shared config is damaged: repair that first." >&2
  echo "            Bypass with: git commit --no-verify" >&2
  exit 1
fi

# THE CHECKERS DO NOT INHERIT THE REPOSITORY'S LOCATION (2026-09-11). Measured on git 2.54 in a sandbox: a
# commit from a LINKED worktree hands this hook GIT_DIR=<common .git>/worktrees/<name>, and a commit from the
# main checkout hands it none - the pre-push shape of 2026-09-10 exactly. Inside that hook
# `git -C <temp> config user.name X` wrote X into the MAIN repository's config, and after the hook's
# `git init <temp>` the next two commits from that worktree never reached the hook at all. No checker below
# builds a temp repo on its live path today; this is so that the next one to do so cannot reach the shared .git.
# GIT_INDEX_FILE IS KEPT, deliberately. It names the index being committed - `.git/index` for an ordinary
# commit, a lock file for `git commit -a` or `git commit -- <paths>` - and every checker below judges the
# STAGED set through it. Unset, a partial commit is judged against the on-disk index, which does not hold
# what is being committed: measured by mutation on 2026-09-11, verify-bulk-edit then answered BLIND and this
# hook refused EVERY `git commit -- <paths>`, the broken ones for the wrong reason. It still resolves with
# GIT_DIR gone: git runs a hook from the top of the
# working tree, which is where a relative value was written from. Because it stays, a checker that builds a
# temp repo still clears its own environment first (lib/git-repo-env.ps1): a temp-repo `git add` under this
# hook would write the commit's index. ops/test-precommit-hook.ps1 drives both halves from a linked worktree.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE
checker="$repo/ops/verify-bulk-edit.ps1"

# A MISSING CHECKER MUST NOT READ AS A PASS. That is the fail-open-reads-as-empty class, and it is exactly
# how a guard stops guarding without anyone editing it.
if [ ! -f "$checker" ]; then
  echo "pre-commit: REFUSING - ops/verify-bulk-edit.ps1 is missing, so nothing verified this commit." >&2
  echo "            Restore it, or commit with --no-verify if you have decided that is right." >&2
  exit 1
fi

out="$(powershell -NoProfile -ExecutionPolicy Bypass -File "$checker" -Staged 2>/dev/null)"
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "$out" >&2
  echo "" >&2
  echo "pre-commit: BLOCKED. The staged set fails a bulk-edit invariant (BOM state, line-ending style," >&2
  echo "            a clean parse, or a call to a function the file cannot resolve)." >&2
  echo "            Fix it, or use --no-verify if you have decided this is right." >&2
  exit 1
fi

# ---- SCOPE: an AUTOMATED commit may only stage what it owns -------------------------------------------
# A MISSING CHECKER MUST NOT READ AS A PASS - same rule as above, same reason.
scope="$repo/ops/verify-bot-commit-scope.ps1"
if [ ! -f "$scope" ]; then
  echo "pre-commit: REFUSING - ops/verify-bot-commit-scope.ps1 is missing, so a bot commit's scope was never checked." >&2
  echo "            Restore it, or commit with --no-verify if you have decided that is right." >&2
  exit 1
fi
sout="$(powershell -NoProfile -ExecutionPolicy Bypass -File "$scope" 2>/dev/null)"
src=$?
# 3 is BLIND (a bot commit with an empty staged set) - git has nothing to commit there anyway, and a
# could-not-evaluate must not read as a refusal on a commit that carries nothing.
if [ "$src" -eq 1 ]; then
  echo "$sout" >&2
  echo "" >&2
  echo "pre-commit: BLOCKED. This commit identifies as the pipeline but stages paths outside" >&2
  echo "            lib\\bot-paths.ps1. An automated commit stages its OWN outputs and nothing else." >&2
  echo "            Fix the staging, declare the path in lib\\bot-paths.ps1, or use --no-verify." >&2
  exit 1
fi

# ---- THIRD CHECK, ADDED 2026-09-07 (Brad's ruling 8) --------------------------------------------------
# A MATCHING-RULE change may not be committed unless the soundness baseline was accepted against THOSE
# rules. On 2026-09-06 commit b28788fa changed six commodities' rules at 05:45 with no -Accept and no
# guards; the board stopped three hours later and three of that day's nine alerts were its footprint.
# The two checks above judge the shape and the scope of what is staged. Neither can see that the
# MEANING of every product on the board just changed.
# A MISSING CHECKER MUST NOT READ AS A PASS - same rule as the two above, same reason.
cgate="$repo/ops/verify-commodities-gate.ps1"
if [ ! -f "$cgate" ]; then
  echo "pre-commit: REFUSING - ops/verify-commodities-gate.ps1 is missing, so a matching-rule change was never checked." >&2
  echo "            Restore it, or commit with --no-verify if you have decided that is right." >&2
  exit 1
fi
cout="$(powershell -NoProfile -ExecutionPolicy Bypass -File "$cgate" 2>/dev/null)"
crc=$?
if [ "$crc" -eq 1 ]; then
  echo "$cout" >&2
  exit 1
fi
exit 0
