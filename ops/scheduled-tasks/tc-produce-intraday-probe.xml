<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>BOUNDED probe for backlog I125 (Brad, 2026-09-12): reads 15 pinned produce prices at one chain store (Baker's Saddlecreek, through Kroger's public API) at 08:30, 15:30 and 20:00 on 2026-09-13 and 2026-09-14, then goes inert. The six triggers below are one-time on purpose, so nothing permanent is added to this box. grocery\probe-produce-intraday.ps1 carries the acceptance bar; grocery\produce-intraday-panel.json carries the panel and the SAME dates as these triggers, and the probe's self-test fails if the two disagree. When the last reading is done this task stops firing, health-heartbeat pages TASK STALE naming grocery\out\produce-intraday-verdict.json, and the probe, its panel, its census entry, its registry row and this file are all deleted together.</Description>
    <URI>\TC Produce Intraday Probe</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>__CURRENT_USER_SID__</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT20M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-09-13T08:30:00-05:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
    <TimeTrigger>
      <StartBoundary>2026-09-13T15:30:00-05:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
    <TimeTrigger>
      <StartBoundary>2026-09-13T20:00:00-05:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
    <TimeTrigger>
      <StartBoundary>2026-09-14T08:30:00-05:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
    <TimeTrigger>
      <StartBoundary>2026-09-14T15:30:00-05:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
    <TimeTrigger>
      <StartBoundary>2026-09-14T20:00:00-05:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\WINDOWS\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "C:\Codex\ThriftyCrew\grocery\probe-produce-intraday.ps1" -Read</Arguments>
    </Exec>
  </Actions>
</Task>
