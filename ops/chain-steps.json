{
  "schema": 1,
  "why": "The daily chain's step order as a declaration (Brad, 2026-10-02, D2 = A of design/PLAN-weekly-root-families-2026-10-02.md, Phase 5): each step of grocery/check-ad-cycles.ps1's PUBLISHING path (compare succeeded, guards did not block, no -NoPublish, a quarantine day included) in execution order, with the files it reads and writes. lib/chain-step-order.ps1 checks it from check-ad-cycles' own -SelfTest on every push: rule A refuses a step whose input is rewritten by a later step (queue 2026-09-28-c6bafd: export-feed read recipe-costs.json before top5-weekly wrote it), rule B refuses a declaration that is not the chain as written.",
  "how_to_edit": "Moving, adding or removing an invocation of a declared script (or of New-TcBoardPin, Step-TcBoardPin, Invoke-DeferPostBuild) in check-ad-cycles.ps1 means editing this list in the same change. site: literal:<script leaf> | call:<Command> | rerun (a re-run through a variable, not located). group: steps that run the same job; only a group's last step is graded. conditional: true for a step that runs only on some days (a quarantine, the consistency repair, one of the two post roads); rule A is graded with and without them. exempt: a read the order rule may not grade, with its reason; every exemption prints on every run.",
  "files": {
    "grocery/out/comparison-<date>.json": "the staple board compare-deals builds and apply-cell-quarantine rewrites",
    "grocery/out/verified-<week_of>.json": "the verified board the post ships when it is at least as new as the comparison",
    "grocery/out/board-pin.json": "the run's pinned generation (lib/board-pin.ps1)",
    "grocery/out/recipe-board.json": "the recipe ingredient board with this week's sale overlay",
    "grocery/out/smp-feed.json": "the price feed (also written to public/smp-feed.json)",
    "meal-prep/pipeline/v2-perserving.json": "the per-serving manifest; the feed's per_serving and top5-weekly read it",
    "grocery/out/recipe-costs.json": "top5-weekly's recipe week costs and membership, which the feed's recipe fields copy",
    "grocery/out/verified-history.json": "the MinStores-1 verified board price history banks"
  },
  "steps": [
    { "id": "compare-deals", "script": "grocery/compare-deals.ps1", "site": "literal:compare-deals.ps1",
      "reads": [], "writes": ["grocery/out/comparison-<date>.json"] },
    { "id": "verify-apply (the history input)", "script": "grocery/verify-apply.ps1", "group": "verify-history", "site": "literal:verify-apply.ps1",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/verified-history.json"],
      "exempt": { "grocery/out/comparison-<date>.json": "price history is banked from the board BEFORE guards ran, so on a quarantine day it banks the candidate a held cell replaced. Surfaced by this declaration 2026-10-02, not measured, not changed here (open item in the Phase 5 report)." } },
    { "id": "verify-apply (re-apply this week's verdicts)", "script": "grocery/verify-apply.ps1", "group": "board-generation", "site": "literal:verify-apply.ps1",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/verified-<week_of>.json"] },
    { "id": "board-pin (generation 1)", "script": "lib/board-pin.ps1", "group": "board-generation", "site": "call:New-TcBoardPin",
      "reads": ["grocery/out/comparison-<date>.json", "grocery/out/verified-<week_of>.json"], "writes": ["grocery/out/board-pin.json"] },
    { "id": "recipe-overlay", "script": "grocery/recipe-overlay.ps1", "site": "literal:recipe-overlay.ps1",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/recipe-board.json"],
      "exempt": { "grocery/out/comparison-<date>.json": "recipe-overlay reads the newest comparison (recipe-overlay.ps1 line 137) before guards can quarantine it. Whether a quarantined staple cell changes what it overlays is not measured (open item in the Phase 5 report)." } },
    { "id": "export-feed (daily)", "script": "grocery/export-feed.ps1", "site": "literal:export-feed.ps1",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/recipe-board.json", "meal-prep/pipeline/v2-perserving.json", "grocery/out/recipe-costs.json"],
      "writes": ["grocery/out/smp-feed.json"] },
    { "id": "compute-v2-perserving", "script": "meal-prep/pipeline/compute-v2-perserving.ps1", "site": "literal:compute-v2-perserving.ps1",
      "reads": ["grocery/out/smp-feed.json"], "writes": ["meal-prep/pipeline/v2-perserving.json"],
      "exempt": { "grocery/out/smp-feed.json": "needs a feed exported THIS run (the daily export runs before it) and reads only its ingredients and pricing_inputs (compute-v2-perserving.ps1 lines 234 and 245). The re-export after top5-weekly changes recipe fields only; a quarantine re-export changes held ingredient prices it does not see, a known lag not changed here." } },
    { "id": "guards", "script": "grocery/guards.ps1", "site": "literal:guards.ps1",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json"], "writes": [] },
    { "id": "apply-cell-quarantine", "conditional": true, "script": "grocery/apply-cell-quarantine.ps1", "group": "quarantine", "site": "literal:apply-cell-quarantine.ps1",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/comparison-<date>.json"] },
    { "id": "board-pin advance (after the quarantine)", "conditional": true, "script": "lib/board-pin.ps1", "group": "board-generation", "site": "call:Step-TcBoardPin",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/verified-<week_of>.json", "grocery/out/board-pin.json"] },
    { "id": "guards (over the quarantined board)", "conditional": true, "script": "grocery/guards.ps1", "site": "rerun",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json"], "writes": [] },
    { "id": "apply-cell-quarantine (reapply)", "conditional": true, "script": "grocery/apply-cell-quarantine.ps1", "group": "quarantine", "site": "literal:apply-cell-quarantine.ps1",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/comparison-<date>.json"] },
    { "id": "board-pin advance (after the reapply)", "conditional": true, "script": "lib/board-pin.ps1", "group": "board-generation", "site": "call:Step-TcBoardPin",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/verified-<week_of>.json", "grocery/out/board-pin.json"] },
    { "id": "guards (third run)", "conditional": true, "script": "grocery/guards.ps1", "site": "rerun",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json"], "writes": [] },
    { "id": "export-feed (quarantine)", "conditional": true, "script": "grocery/export-feed.ps1", "site": "literal:export-feed.ps1",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/recipe-board.json", "meal-prep/pipeline/v2-perserving.json", "grocery/out/recipe-costs.json"],
      "writes": ["grocery/out/smp-feed.json"] },
    { "id": "publish-deals-page -BuildOnly (the DeferPost road)", "conditional": true, "script": "grocery/publish-deals-page.ps1", "group": "post", "site": "call:Invoke-DeferPostBuild",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/verified-<week_of>.json"], "writes": [] },
    { "id": "publish-deals-page", "conditional": true, "script": "grocery/publish-deals-page.ps1", "group": "post", "site": "literal:publish-deals-page.ps1",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/verified-<week_of>.json"], "writes": [] },
    { "id": "guards (consistency auto-repair)", "conditional": true, "script": "grocery/guards.ps1", "site": "rerun",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json"], "writes": [] },
    { "id": "apply-cell-quarantine (consistency auto-repair)", "conditional": true, "script": "grocery/apply-cell-quarantine.ps1", "group": "quarantine", "site": "rerun",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/comparison-<date>.json"] },
    { "id": "board-pin advance (consistency auto-repair)", "conditional": true, "script": "lib/board-pin.ps1", "group": "board-generation", "site": "rerun",
      "reads": ["grocery/out/comparison-<date>.json"], "writes": ["grocery/out/verified-<week_of>.json", "grocery/out/board-pin.json"] },
    { "id": "guards (consistency auto-repair, over the quarantined board)", "conditional": true, "script": "grocery/guards.ps1", "site": "rerun",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json"], "writes": [] },
    { "id": "export-feed (consistency auto-repair quarantine)", "conditional": true, "script": "grocery/export-feed.ps1", "site": "rerun",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/recipe-board.json", "meal-prep/pipeline/v2-perserving.json", "grocery/out/recipe-costs.json"],
      "writes": ["grocery/out/smp-feed.json"] },
    { "id": "publish-deals-page (republish after the consistency repair)", "conditional": true, "script": "grocery/publish-deals-page.ps1", "group": "post", "site": "literal:publish-deals-page.ps1",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/verified-<week_of>.json"], "writes": [] },
    { "id": "top5-weekly", "script": "meal-prep/top5-weekly.ps1", "site": "literal:top5-weekly.ps1",
      "reads": ["meal-prep/pipeline/v2-perserving.json", "grocery/out/recipe-board.json", "grocery/out/comparison-<date>.json"], "writes": ["grocery/out/recipe-costs.json"] },
    { "id": "export-feed (after top5-weekly)", "script": "grocery/export-feed.ps1", "site": "literal:export-feed.ps1",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/recipe-board.json", "meal-prep/pipeline/v2-perserving.json", "grocery/out/recipe-costs.json"],
      "writes": ["grocery/out/smp-feed.json"] },
    { "id": "send-price-alerts", "script": "grocery/send-price-alerts.ps1", "site": "literal:send-price-alerts.ps1",
      "reads": ["grocery/out/board-pin.json", "grocery/out/comparison-<date>.json", "grocery/out/verified-<week_of>.json"], "writes": [] }
  ]
}
