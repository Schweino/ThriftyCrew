+"""import_all_selftest.py - a failed importer leaves nothing, and says so (2026-09-19).
+
+    python graph/import/import_all_selftest.py --selftest
+
+WHY THIS FILE EXISTS. `graph/import/import_all.py` is the nightly import - the daily chain reaches it
+through `grocery/audit-graph-gates.ps1 -> import_all.py --observations`. An importer that raised part
+way through wrote its finished rows straight into the connection's open transaction, and the NEXT
+importer's `db.conn.commit()` committed them along with its own. graph.db then held a HALF data set: a
+known-wrong set missing its newest rulings, an override set missing cells, every count still plausible.
+The run exited 0, the gates lane judged that index, the resolver resolved against it, and cell_state -
+whose git diff IS this estate's price history - was exported from it. Nothing anywhere said so.
+
+WHAT IT GUARDS, in the three places the repair lives:
+
+  1. each importer runs inside `GraphDB.step()`, so a failure contributes NOTHING and the index keeps
+     the whole previous set. Stale is a state a caller can see; half is not.
+  2. the derive + export phase is REFUSED after a failed step, and `--allow-partial` is the loud,
+     deliberate override.
+  3. the run exits 1 and its closing decision_log event is `import_incomplete` naming the failed steps,
+     so the durable trail carries the failure and not only this stdout.
+
+THE DENOMINATOR IS IN THE VERDICT LINE for the reason `.claude/rules/measurement.md` gives: `1 failed`
+is a mood, `1 of 5 failed` is a measurement, and only the second one shows a run that skipped four
+steps it meant to take.
+
+HERMETIC. Every case drives `import_all.main()` in-process against a FRESH TEMPORARY DATABASE in its
+own temp directory: `graphdb.DB_PATH` and `graphdb.GRAPH_DIR` are both pointed there, so the restore,
+the durable JSON export and the provenance trail all land in the temp tree, and `_append_jsonl` is
+replaced for the whole suite as a second guard. The importer list is a fixture, never the real one, so
+no case reads `grocery/`, and `derive_and_export` is replaced by a SPY, so the real resolve / cell_state
+/ export path - which writes tracked JSON under `graph/state/` - is never reachable from here. Nothing
+reads or writes `graph/sqlite/graph.db`. Every module attribute is restored in a `finally`.
+
+SCOPE OF A CLEAN REPORT: these cases drive the real `main()`, so a pass is evidence about the control
+flow that decides whether a half-loaded index becomes the day's answer. It says nothing about whether
+any individual importer parses its own file correctly, and the failure it injects is a raise - an
+importer that returns a WRONG count without raising is outside every case here.
+
+EXIT: 0 all cases pass, 1 at least one failed. Read the verdict LINE, not the number.
+"""
+from __future__ import annotations
+
+import io
+import json
+import os
+import shutil
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.normpath(os.path.join(HERE, "..", ".."))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(REPO, "graph", "lib"))
+
+import graphdb                                           # noqa: E402
+import importers                                         # noqa: E402
+import import_all                                        # noqa: E402
+
+_fails: list[str] = []
+_ran = 0
+CASES = 12
+TS = "2026-09-19T00:00:00"
+
+
+def T(label: str, ok: bool, got: str = "") -> None:
+    global _ran
+    _ran += 1
+    if ok:
+        print("  ok    " + label)
+    else:
+        _fails.append(label)
+        print("  FAILED " + label + ("   got: " + got if got else ""))
+
+
+# ---------------------------------------------------------------------------
+# Fixture importers: the shape of every real one - a loop over a file's entries
+# upserting as it goes, with nothing between the rows and the database.
+# ---------------------------------------------------------------------------
+
+def _make_importer(prefix: str, n: int, fail_at: int | None = None):
+    def fn(db, ts, run, **kwargs):
+        for i in range(n):
+            if fail_at is not None and i == fail_at:
+                raise ValueError("fixture: %s entry %d is malformed" % (prefix, i))
+            db.upsert_node("commodity:staple:%s-%d" % (prefix, i), "Commodity",
+                           "%s %d" % (prefix, i), ts)
+        return {prefix + "_rows": n}
+    return fn
+
+
+class _Spy:
+    """Stands in for derive_and_export. Records that it was reached, and reaches nothing."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, db, ts, run, totals, say):
+        self.calls += 1
+        totals["spy_derived"] = 1
+
+
+def _drive(tmp: str, name: str, argv: list[str], all_importers: list) -> dict:
+    """Run import_all.main() once, hermetically, and return everything a case may ask about."""
+    root = os.path.join(tmp, name)
+    os.makedirs(root)
+    spy = _Spy()
+    saved = (graphdb.DB_PATH, graphdb.GRAPH_DIR, importers.ALL_IMPORTERS,
+             importers.LANE_IMPORTERS, importers.import_observations,
+             import_all.derive_and_export, sys.argv)
+    buf = io.StringIO()
+    try:
+        graphdb.DB_PATH = os.path.join(root, "sqlite", "graph.db")
+        graphdb.GRAPH_DIR = root
+        importers.ALL_IMPORTERS = all_importers
+        importers.LANE_IMPORTERS = [("lane_fixture", _make_importer("lane", 1))]
+        importers.import_observations = _make_importer("obs", 1)
+        import_all.derive_and_export = spy
+        sys.argv = ["import_all.py"] + argv
+        stdout, sys.stdout = sys.stdout, buf
+        try:
+            rc = import_all.main()
+        finally:
+            sys.stdout = stdout
+    finally:
+        (graphdb.DB_PATH, graphdb.GRAPH_DIR, importers.ALL_IMPORTERS,
+         importers.LANE_IMPORTERS, importers.import_observations,
+         import_all.derive_and_export, sys.argv) = saved
+    return {"rc": rc, "out": buf.getvalue(), "spy": spy.calls,
+            "db": os.path.join(root, "sqlite", "graph.db"), "root": root}
+
+
+def _rows(db_path: str, prefix: str) -> int:
+    """How many of `prefix`'s rows the INDEX holds, asked by reopening the file: an
+    uncommitted row answers the connection that wrote it and nobody else."""
+    db = graphdb.GraphDB(db_path, restore_learning=False)
+    try:
+        return db.conn.execute("SELECT COUNT(*) FROM nodes WHERE id LIKE ?",
+                               ("commodity:staple:" + prefix + "-%",)).fetchone()[0]
+    finally:
+        db.conn.close()
+
+
