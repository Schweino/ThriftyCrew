+"""import_all_selftest.py - the nightly import's ATOMICITY and its verdict (2026-09-19).
+
+    python graph/import/import_all_selftest.py --selftest
+
+WHY THIS FILE EXISTS. `graph/import/import_all.py` is the daily chain's graph-gates lane and the
+README's rebuild road, and nothing ran any of its control flow: `importers_selftest.py` covers one
+importer's price handling, and the loop that decides what a failure MEANS had no fixture at all.
+
+WHAT IT GUARDS. An importer that raised partway used to leave its partial writes in graph.db and the
+run still exited 0. Three separate mechanisms made that possible and all three are fixtured here:
+
+  1. NOTHING BOUNDED ONE IMPORTER'S WRITES. The loop caught the exception and `continue`d, so the
+     rows written before the raise stayed in the open transaction and were committed by the NEXT
+     importer's `db.conn.commit()`. A known-wrong or override set two thirds loaded became the day's
+     index. Each importer now runs inside `db.step()`, a SAVEPOINT.
+  2. `import_observations` SAT OUTSIDE ANY try. A raise there propagated out of `with open_db()`,
+     whose `__exit__` declined to commit - and then called `close()`, which committed anyway.
+  3. THE RUN EXITED 0 AND THE INDEX SAID NOTHING. It now records `import_incomplete` naming the
+     steps it lost, skips the DESTRUCTIVE derived phase (`supersede_prune` deletes evidence and
+     `cell_state`'s git diff is the price history), and returns 1 - which
+     `grocery/audit-graph-gates.ps1` already reads as BLIND.
+
+HERMETIC. `graphdb.DB_PATH` points at a fresh file in a per-run temp directory, so `open_db()` never
+reaches `graph/sqlite/graph.db`; `importers.ALL_IMPORTERS`, `LANE_IMPORTERS` and
+`import_observations` are replaced with fixtures, so no capture file and no grocery/*.json is read;
+`GraphDB._append_jsonl` is replaced, so the tracked graph/provenance trail is never written; and the
+derived phase's three modules are replaced in `sys.modules` with recording fakes, so no resolver,
+state build or prune runs. Every substitution is restored in a `finally`. Nothing outside the temp
+directory is written.
+
+EXIT: 0 all cases pass, 1 at least one failed. Read the verdict LINE, not the number.
+"""
+from __future__ import annotations
+
+import io
+import contextlib
+import json
+import os
+import shutil
+import sys
+import tempfile
+import types
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.normpath(os.path.join(HERE, "..", ".."))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(REPO, "graph", "lib"))
+
+import graphdb                                           # noqa: E402
+import importers as I                                    # noqa: E402
+import import_all as IA                                  # noqa: E402
+
+_fails: list[str] = []
+_ran = 0
+CASES = 17
+TS = "2026-09-19T00:00:00"
+
+# Unique per call: two runs inside one second would otherwise share a run id, and every marker of
+# the second would merge into the first one's verdict.
+_seq = [0]
+
+
+def _run_id(kind: str, stamp: str) -> str:
+    _seq[0] += 1
+    return "run:%s:fixture%04d" % (kind, _seq[0])
+
+
+def T(label: str, ok: bool, got: str = "") -> None:
+    global _ran
+    _ran += 1
+    if ok:
+        print("  ok    " + label)
+    else:
+        _fails.append(label)
+        print("  FAILED " + label + ("   got: " + got if got else ""))
+
+
+# ---------------------------------------------------------------------------
+# fixture importers - the shape of the founding bug: N rows written, then a raise
+# ---------------------------------------------------------------------------
+def _good(prefix: str, n: int, ntype: str = "Store"):
+    def fn(db, ts, run, **kw):
+        for i in range(n):
+            db.upsert_node("%s:%d" % (prefix, i), ntype, "%s %d" % (prefix, i), ts)
+        return {prefix: n}
+    return fn
+
+
+def _half(prefix: str, written: int, ntype: str = "KnownWrong", exc=RuntimeError):
+    def fn(db, ts, run, **kw):
+        for i in range(written):
+            db.upsert_node("%s:%d" % (prefix, i), ntype, "%s %d" % (prefix, i), ts)
+        raise exc("%s source truncated after %d rows" % (prefix, written))
+    return fn
+
+
+def _node_ids(path: str) -> list[str]:
+    """Reopen the FILE. Reading the live connection cannot tell a committed row from one still
+    sitting in an open transaction, and that difference is the entire subject here."""
+    db = graphdb.GraphDB(path, restore_learning=False, health_warn=False)
+    try:
+        return [r[0] for r in db.conn.execute("SELECT id FROM nodes ORDER BY id")]
+    finally:
+        db.conn.close()
+
+
+def _health(path: str) -> dict:
+    db = graphdb.GraphDB(path, restore_learning=False, health_warn=False)
+    try:
+        return db.import_health()
+    finally:
+        db.conn.close()
+
+
+def _invoke(db_path: str, argv: list[str]) -> tuple[int, str]:
+    """Run import_all.main() against a temp index and capture what it said."""
+    graphdb.DB_PATH = db_path
+    buf = io.StringIO()
+    saved_argv = sys.argv
+    sys.argv = ["import_all.py"] + argv
+    try:
+        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
+            rc = IA.main()
+    except BaseException as e:                            # noqa: BLE001
+        # A raise out of main() is not a return code and must not be scored as one. Carrying the
+        # repr is what stops "the suite failed" from being a mystery: the first run of this file
+        # caught a TypeError here and the only symptom was a later case's missing database.
+        sys.argv = saved_argv
+        return ("raised:%r" % (e,)), buf.getvalue()
+    sys.argv = saved_argv
+    return rc, buf.getvalue()
+
+
+# ---------------------------------------------------------------------------
+# recording fakes for the derived phase
+# ---------------------------------------------------------------------------
+def _install_derive_fakes(calls: list, fail_at: str | None = None):
+    """Replace resolve/state/stage2_review with fakes that RECORD and optionally raise.
+
+    They write real rows, because the point of the derived-phase case is that the phase unwinds
+    as ONE unit - which cannot be asserted against a fake that touches no database.
+    """
+    def mark(name, db=None, node=None):
+        calls.append(name)
+        if db is not None and node is not None:
+            db.upsert_node(node, "AuditFinding", node, TS)
+        if fail_at == name:
+            raise RuntimeError("derived stage %s blew up" % name)
+
+    resolve = types.ModuleType("resolve")
+
