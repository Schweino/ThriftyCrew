diff --git a/grocery/replay-cursor-coverage.ps1 b/grocery/replay-cursor-coverage.ps1
new file mode 100644
index 000000000..0bec87005
--- /dev/null
+++ b/grocery/replay-cursor-coverage.ps1
@@ -0,0 +1,252 @@
+<#
+  replay-cursor-coverage.ps1 - replay every recorded cursor advance against the capture of its day,
+  and answer the one question the advance itself never recorded: did that capture actually cover the
+  rotation slice the cursor stepped over?
+
+  WHY THIS EXISTS (2026-09-19). Three advances skipped their slice for a whole 90-day rotation -
+  Sam's Club and Fareway on 2026-08-22, Walmart on 2026-08-30 - and finding them took a hand replay of
+  out\capture-cursor-log.jsonl against the captures of those days, with a commodity-search.json pulled
+  out of git history for each day because the term list moves and a slice is an INDEX into it. That is
+  an afternoon of archaeology for a question that will be asked again every time the rotation looks
+  slow, so the harness is committed rather than described: a measurement anyone may want to repeat
+  commits its harness, and a described probe rewritten later is a second harness however faithful the
+  description was.
+
+  IT IS A REPORT, NEVER A GATE, and it writes nothing. The numbers in $script:CursorStallDays' comment
+  block in capture-policy-lib.ps1 and in docs/CONTROL-CONSTANTS.md come from this script.
+
+  IT RUNS THROUGH THE PRODUCTION FUNCTION. Get-CaptureSliceCoverage decides coverage here exactly as it
+  does inside Step-CaptureCursor - a second implementation of "did the capture cover this" is the
+  duplicated-rule trap capture-policy-lib.ps1 exists to cure, and it would let the replay and the live
+  rule drift apart silently. The day's term list is supplied by pointing the library's policy root at a
+  temp directory holding that day's commodity-search.json and the current stores.json; nothing else in
+  the library is redirected.
+
+  WHAT A CLEAN REPORT MEANS (scope). UNSOUND and INCOMPLETE, both by construction:
+    * a day whose capture file has been deleted, or whose rows carry neither a capture_terms ledger nor
+      found_by_term + as_of, reads BLIND - the coverage is unknown, never zero;
+    * git history gives the term list as it was COMMITTED, and a same-day edit that was committed later
+      moves indices, so an old row's slice can be off by the terms added that day;
+    * the log records advances only, so a day the cursor was held leaves no line to judge.
+  So a row saying 0 of 7 is a candidate to read, not a verdict, and a page of clean rows does not prove
+  no slice was ever skipped.
+
+  Usage:
+      .\replay-cursor-coverage.ps1                       # every advance in the live log
+      .\replay-cursor-coverage.ps1 -Store 'Walmart' -Since 2026-08-25
+      .\replay-cursor-coverage.ps1 -SelfTest
+#>
+[CmdletBinding()]
+param(
+  [string]$OutDir = '',
+  [string]$Store = '',
+  [string]$Since = '',
+  [switch]$NoGitHistory,
+  [switch]$SelfTest
+)
+$ErrorActionPreference = 'Stop'
+$root = if ($PSScriptRoot) { $PSScriptRoot } else { Split-Path -Parent $MyInvocation.MyCommand.Path }
+. (Join-Path $root 'capture-policy-lib.ps1')
+. (Join-Path $root 'native-lib.ps1')
+
+# One scratch root per run, handed out through one function and removed in finally: two replays of the
+# same log in two sessions must not share a day-root, or one reads the other's term list.
+$script:RcScratch = Join-Path ([IO.Path]::GetTempPath()) ('rcc-' + [guid]::NewGuid().ToString('N').Substring(0, 12))
+
+function Get-RcDayRoot {
+  <#
+    A policy root for ONE day: that day's commodity-search.json (from git history when it can be read)
+    plus the current stores.json, which is only used to find where a store writes and has no index in it.
+    Returns a hashtable with Path and Source so the caller can print which list it judged against, because
+    "the current list" and "the list as it was" are different measurements and must not be reported alike.
+  #>
+  param([Parameter(Mandatory)][string]$Day, [string]$RepoRoot, [switch]$NoHistory)
+  $dir = Join-Path $script:RcScratch $Day
+  $src = 'working copy'
+  if (Test-Path -LiteralPath (Join-Path $dir 'commodity-search.json')) {
+    $stamp = Join-Path $dir 'source.txt'
+    if (Test-Path -LiteralPath $stamp) { $src = [IO.File]::ReadAllText($stamp) }
+    return @{ Path = $dir; Source = $src }
+  }
+  [void][IO.Directory]::CreateDirectory($dir)
+  $wrote = $false
+  if (-not $NoHistory -and $RepoRoot) {
+    # Invoke-Native, because under EAP=Stop a native child's first stderr line is a terminating throw and
+    # a try/catch around it would keep the caller alive while throwing git's answer away.
+    $rev = Invoke-Native 'git' '-C' $RepoRoot 'rev-list' '-1' ("--before=$Day 23:59:59") 'HEAD' '--' 'grocery/commodity-search.json'
+    $commit = ''
+    if ($rev.ExitCode -eq 0) { $commit = (@($rev.Output) | Where-Object { $_ } | Select-Object -First 1) }
+    if ($commit) {
+      $show = Invoke-Native 'git' '-C' $RepoRoot 'show' ($commit + ':grocery/commodity-search.json')
+      if ($show.ExitCode -eq 0 -and @($show.Output).Count -gt 0) {
+        [IO.File]::WriteAllText((Join-Path $dir 'commodity-search.json'), ((@($show.Output) -join "`n")))
+        $src = 'git ' + $commit.Substring(0, [Math]::Min(9, $commit.Length))
+        $wrote = $true
+      }
+    }
+  }
+  if (-not $wrote) {
+    Copy-Item -LiteralPath (Join-Path $root 'commodity-search.json') -Destination (Join-Path $dir 'commodity-search.json') -Force
+  }
+  Copy-Item -LiteralPath (Join-Path $root 'stores.json') -Destination (Join-Path $dir 'stores.json') -Force
+  [IO.File]::WriteAllText((Join-Path $dir 'source.txt'), $src)
+  return @{ Path = $dir; Source = $src }
+}
+
+function Get-RcAdvances {
+  <#
+    The advance lines of a cursor log, oldest first. PURE, so a fixture can hand it frozen lines
+    instead of a live log. A line that does not parse, or that names no store, is SKIPPED and counted:
+    this report must never manufacture an advance out of a bad line.
+  #>
+  param([string[]]$Lines, [string]$Store = '', [string]$Since = '')
+  $out = New-Object System.Collections.Generic.List[object]
+  $bad = 0
+  foreach ($ln in @($Lines)) {
+    if (-not ("$ln").Trim()) { continue }
+    $rec = $null
+    try { $rec = "$ln" | ConvertFrom-Json } catch { $bad++; continue }
+    if (-not $rec -or -not $rec.PSObject.Properties['store'] -or -not $rec.PSObject.Properties['day']) { $bad++; continue }
+    if ($Store -and [string]$rec.store -ne $Store) { continue }
+    if ($Since -and [string]$rec.day -lt $Since) { continue }
+    if (-not (Test-TermRotationStore ([string]$rec.store))) { continue }   # Hy-Vee rotates by product id
+    [void]$out.Add($rec)
+  }
+  return @{ Rows = $out.ToArray(); Unreadable = $bad }
+}
+
+# ---------------------------------------------------------------------------
+if ($SelfTest) {
+  $rcN = 0; $rcBad = 0
+  function Test-RcCase([string]$What, [bool]$Cond, [string]$Detail = '') {
+    $script:rcN++
+    if ($Cond) { Write-Output ('ok    ' + $What) }
+    else { $script:rcBad++; Write-Output ('FAIL  ' + $What + $(if ($Detail) { ' -> ' + $Detail } else { '' })) }
+  }
+  $rcTmp = Join-Path ([IO.Path]::GetTempPath()) ('rcc-selftest-' + [guid]::NewGuid().ToString('N').Substring(0, 12))
+  [void][IO.Directory]::CreateDirectory((Join-Path $rcTmp 'sams'))
+  try {
+    # MUST FIRE: the 2026-08-22 Sam's Club line, replayed against a capture of the NEXT slice's terms.
+    # The whole point of this script is that this row reads 0 of 7 rather than looking like every other
+    # advance in the log.
+    $rcTerms = [ordered]@{}
+    for ($n = 0; $n -lt 630; $n++) { $rcTerms[('c' + $n.ToString('000'))] = ('term ' + $n.ToString('000')) }
+    [IO.File]::WriteAllText((Join-Path $rcTmp 'commodity-search.json'), (@{ terms = $rcTerms } | ConvertTo-Json -Depth 4))
+    [IO.File]::WriteAllText((Join-Path $rcTmp 'stores.json'), (@{ stores = @(
+        @{ name = "Sam's Club"; regular_prefix = 'sams'; deals_glob = 'out/sams/sams-deals-*.json' }) } | ConvertTo-Json -Depth 4))
+    $rcRows = @(7..13 | ForEach-Object { [ordered]@{ item = 'x'; found_by_term = ('term ' + $_.ToString('000')); as_of = '2026-08-22' } })
+    [IO.File]::WriteAllText((Join-Path $rcTmp 'sams\sams-deals-2026-08-22.json'), ((@{ deals = $rcRows }) | ConvertTo-Json -Depth 5))
+    $savedRoot = $script:PolicyRoot
+    $script:PolicyRoot = $rcTmp
+    try {
+      $slice = @(0..6 | ForEach-Object { 'term ' + $_.ToString('000') })
+      $cv = Get-CaptureSliceCoverage -Store "Sam's Club" -Terms $slice -Today '2026-08-22' -OutDir $rcTmp
+      Test-RcCase "MUST FIRE  the 2026-08-22 Sam's advance replays as 0 of 7 covered, against a capture of the NEXT slice" `
+        (@($cv.Covered).Count -eq 0 -and -not $cv.Blind -and $cv.Source -eq 'found_by_term') `
+        ("covered=$(@($cv.Covered).Count) blind=$($cv.Blind) source=$($cv.Source)")
+      $slice2 = @(7..13 | ForEach-Object { 'term ' + $_.ToString('000') })
+      $cv2 = Get-CaptureSliceCoverage -Store "Sam's Club" -Terms $slice2 -Today '2026-08-22' -OutDir $rcTmp
+      Test-RcCase 'CLEAN TWIN the slice that capture DID cover replays as 7 of 7, so the replay is reading the file and not just failing' `
+        (@($cv2.Covered).Count -eq 7) ("covered=$(@($cv2.Covered).Count)")
+      $cv3 = Get-CaptureSliceCoverage -Store "Sam's Club" -Terms $slice -Today '2026-08-23' -OutDir $rcTmp
+      Test-RcCase 'MUST NOT FIRE  a day with no capture file on disk reads BLIND, never 0 of 7 - a could-not-look is not a skip' `
+        ($cv3.Blind -and $cv3.Source -eq 'none') ("blind=$($cv3.Blind) source=$($cv3.Source)")
+    } finally { $script:PolicyRoot = $savedRoot }
+
+    # The log reader: a bad line is skipped and COUNTED, a store filter holds, and Hy-Vee's product
+    # cursor is never judged against the term list - that is the namespace confusion this estate has
+    # paid for before.
+    $lines = @(
+      '{"at":"2026-08-22T10:08:44","store":"Sam''s Club","from":0,"to":7,"day":"2026-08-22"}',
+      'not json at all',
+      '{"at":"2026-08-22T10:26:04","store":"Hy-Vee (products)","from":0,"to":18,"day":"2026-08-22"}',
+      '{"at":"2026-08-30T09:09:53","store":"Walmart","from":28,"to":35,"day":"2026-08-30"}')
+    $rd = Get-RcAdvances -Lines $lines
+    Test-RcCase 'the log reader keeps the two term-rotation advances, drops Hy-Vee''s product cursor, and counts the unreadable line' `
+      (@($rd.Rows).Count -eq 2 -and $rd.Unreadable -eq 1) ("rows=$(@($rd.Rows).Count) unreadable=$($rd.Unreadable)")
+    $rd2 = Get-RcAdvances -Lines $lines -Store 'Walmart' -Since '2026-08-25'
+    Test-RcCase 'the store and -Since filters select exactly one row' (@($rd2.Rows).Count -eq 1 -and [string]@($rd2.Rows)[0].day -eq '2026-08-30') `
+      ("rows=$(@($rd2.Rows).Count)")
+  } catch {
+    Test-RcCase 'the self-test ran to its end with no unexpected error' $false ($_.Exception.Message + ' (line ' + $_.InvocationInfo.ScriptLineNumber + ')')
+  } finally {
+    Remove-Item -LiteralPath $rcTmp -Recurse -Force -ErrorAction SilentlyContinue
+  }
+  Write-Output ('replay-cursor-coverage self-test {0} ({1} of {2} case(s) failed)' -f $(if ($rcBad) { 'FAIL' } else { 'PASS' }), $rcBad, $rcN)
+  Write-Output ('REPLAY-CURSOR-COVERAGE-SELFTEST-COMPLETE cases={0} failed={1}' -f $rcN, $rcBad)
+  if ($rcBad -gt 0) { exit 1 }
+  exit 0
+}
+
+# ---------------------------------------------------------------------------
+if (-not $OutDir) { $OutDir = Join-Path $root 'out' }
+$repoRoot = Split-Path -Parent $root
+$logFile = Join-Path $OutDir 'capture-cursor-log.jsonl'
+if (-not (Test-Path -LiteralPath $logFile)) {
+  Write-Output "no cursor log at $logFile - nothing to replay (this checkout may never have run a capture)"
+  Write-Output 'REPLAY-CURSOR-COVERAGE-COMPLETE advances=0 judged=0 blind=0'
+  exit 0
+}
+
+[void][IO.Directory]::CreateDirectory($script:RcScratch)
+$savedPolicyRoot = $script:PolicyRoot
+try {
+  $read = Get-RcAdvances -Lines ([IO.File]::ReadAllLines($logFile)) -Store $Store -Since $Since
+  $rows = @($read.Rows)
+  Write-Output ("replaying {0} advance(s) from {1}{2}{3}" -f $rows.Count, $logFile,
+    $(if ($Store) { " for $Store" } else { '' }), $(if ($Since) { " since $Since" } else { '' }))
+  if ($read.Unreadable -gt 0) { Write-Output ("  ({0} log line(s) could not be parsed and are not counted anywhere below)" -f $read.Unreadable) }
+  Write-Output ''
+  # covered is how many of the slice's terms the capture shows were asked; adv is what the rule would
+  # advance - the COVERED PREFIX, which is the number Step-CaptureCursor actually uses, because a term
+  # with no evidence is never stepped over even when later terms of the slice have some.
+  Write-Output ('{0,-12} {1,-11} {2,6} {3,6} {4,8} {5,5}  {6}' -f 'store', 'day', 'from', 'to', 'covered', 'adv', 'first uncovered term / why')
+
+  $judged = 0; $full = 0; $partial = 0; $none = 0; $blind = 0
+  $held = 0; $stepPart = 0; $stepFull = 0
+  $runNow = @{}; $runBest = @{}
+  foreach ($rec in $rows) {
+    $st = [string]$rec.store
+    $day = [string]$rec.day
+    $from = [int]$rec.from
+    $dayRoot = Get-RcDayRoot -Day $day -RepoRoot $repoRoot -NoHistory:$NoGitHistory
+    $script:PolicyRoot = $dayRoot.Path
+    $plan = Get-CapturePlan -Store $st -Today $day
+    $all = Get-AllTerms
+    if ($all.Count -le 0) { continue }
+    $slice = New-Object System.Collections.Generic.List[string]
+    for ($k = 0; $k -lt [int]$plan.RotationTerms; $k++) { [void]$slice.Add([string]$all[(($from + $k) % $all.Count)].term) }
+    $cv = Get-CaptureSliceCoverage -Store $st -Terms $slice.ToArray() -Today $day -OutDir $OutDir
+    $judged++
+    $n = @($cv.Covered).Count
+    if ($cv.Blind) { $blind++ }
+    elseif ($n -ge $slice.Count) { $full++ }
+    elseif ($n -gt 0) { $partial++ }
+    else { $none++ }
+    $pre = [int]$cv.CoveredPrefix
+    if ($cv.Blind) { $stepFull++ } elseif ($pre -ge $slice.Count) { $stepFull++ } elseif ($pre -gt 0) { $stepPart++ } else { $held++ }
+    # The longest run of consecutive advances this store would have HELD on, which is the number
+    # $script:CursorStallDays is set against. Reset by any advance, blind or otherwise.
+    if (-not $cv.Blind -and $pre -eq 0) {
+      $runNow[$st] = [int]$runNow[$st] + 1
+      if ([int]$runNow[$st] -gt [int]$runBest[$st]) { $runBest[$st] = [int]$runNow[$st] }
+    } else { $runNow[$st] = 0 }
+    $tail = if ($cv.Blind) { 'BLIND - ' + $cv.Why } elseif (@($cv.Uncovered).Count -eq 0) { '-' } else { "'" + [string]@($cv.Uncovered)[0] + "' (" + $cv.Source + ', terms from ' + $dayRoot.Source + ')' }
+    Write-Output ('{0,-12} {1,-11} {2,6} {3,6} {4,8} {5,5}  {6}' -f $st, $day, $from, [int]$rec.to, ("$n/$($slice.Count)"), $(if ($cv.Blind) { 'blind' } else { "$pre" }), $tail)
+  }
+
+  Write-Output ''
+  # Every count with its denominator, per the measurement rules: a bare "19 skipped" is a mood.
+  Write-Output ("judged {0} of {1} advance(s): {2} covered the whole slice, {3} covered part of it, {4} covered NONE of it, {5} could not be judged (BLIND)" -f `
+    $judged, $rows.Count, $full, $partial, $none, $blind)
+  Write-Output ("under today's rule those same {0} would be: {1} advancing the full slice ({2} of them because they are BLIND), {3} advancing part of it, {4} holding" -f `
+    $judged, $stepFull, $blind, $stepPart, $held)
+  foreach ($k in @($runBest.Keys | Sort-Object)) {
+    Write-Output ("  longest run of consecutive HELD advances: {0,-12} {1} (the stall escape steps over one term at {2})" -f $k, [int]$runBest[$k], $script:CursorStallDays)
+  }
+  Write-Output ('REPLAY-CURSOR-COVERAGE-COMPLETE advances={0} judged={1} full={2} partial={3} none={4} blind={5} would_advance={6} would_part={7} would_hold={8}' -f $rows.Count, $judged, $full, $partial, $none, $blind, $stepFull, $stepPart, $held)
+} finally {
+  $script:PolicyRoot = $savedPolicyRoot
+  Remove-Item -LiteralPath $script:RcScratch -Recurse -Force -ErrorAction SilentlyContinue
+}
+exit 0
diff --git a/grocery/test-capture-policy.ps1 b/grocery/test-capture-policy.ps1
index 4d4a84379..b8576dc4e 100644
--- a/grocery/test-capture-policy.ps1
+++ b/grocery/test-capture-policy.ps1
@@ -539,6 +539,261 @@ try {
       }
     }
   }
+
+  # ================================================================================================
+  # THE CURSOR ADVANCES ONLY OVER TERMS THE CAPTURE COVERED (2026-09-19)
+  #
+  # THE FOUNDING BUG, replayed off out\capture-cursor-log.jsonl against the captures of those days:
+  #     Sam's Club  2026-08-22  #0  -> #7   0 of 7 slice terms covered; the 122 rows were terms #7..#13
+  #     Fareway     2026-08-22  #14 -> #21  0 of 7 covered
+  #     Walmart     2026-08-30  #28 -> #35  0 of 7 covered; 525 fresh rows, all from 24 OTHER terms
+  #     Baker's     2026-09-18  #168-> #175 0 of 7 covered; 70 of its 74 asks were the weekly ad list
+  # Each was "landed" - rows arrived - so Test-CaptureLanded said yes and the slice was skipped for a
+  # whole 90-day rotation. The fixtures below are those four shapes plus the two escapes that stop the
+  # fix freezing a rotation that is working.
+  #
+  # THE DATE IS TODAY'S REAL DATE ON PURPOSE. Step-CaptureCursor refuses any other as a replay, which
+  # is the 2026-08-21 rule that stopped self-tests moving the live cursor. A run that straddles
+  # midnight therefore fails these for the harness's reason, not the code's, exactly as
+  # commit-capture-cursor.ps1 -SelfTest already does.
+  $covRoot = Join-Path $tmp 'cov'
+  New-Item -ItemType Directory -Path $covRoot -Force | Out-Null
+  $covToday = (Get-Date).ToString('yyyy-MM-dd')
+  $covYday = (Get-Date).AddDays(-1).ToString('yyyy-MM-dd')
+  # 630 terms -> ceil(630/90) = 7 a day, the same rotation size the live catalogue produces, so the
+  # slice arithmetic in these cases is production's arithmetic. Term k is 'term <k>', zero-padded so
+  # the id sort order and the index agree.
+  $covTerms = [ordered]@{}
+  for ($n = 0; $n -lt 630; $n++) { $covTerms[('c' + $n.ToString('000'))] = ('term ' + $n.ToString('000')) }
+  [IO.File]::WriteAllText((Join-Path $covRoot 'commodity-search.json'), (@{ terms = $covTerms } | ConvertTo-Json -Depth 4))
+  [IO.File]::WriteAllText((Join-Path $covRoot 'stores.json'), (@{ stores = @(
+      @{ name = 'Walmart'; regular_prefix = 'walmart' },
+      @{ name = "Sam's Club"; regular_prefix = 'sams'; deals_glob = 'out/sams/sams-deals-*.json' }) } | ConvertTo-Json -Depth 4))
+  $script:PolicyRoot = $covRoot
+  $covTermAt = { param([int]$Ix) 'term ' + ($Ix % 630).ToString('000') }
+
+  # One out\ per case: the cursor file, the capture and the log are per-case state, and sharing them
+  # would make each case depend on the one before it.
+  function New-CovOut([string]$Name) {
+    $o = Join-Path $covRoot ('out-' + $Name)
+    New-Item -ItemType Directory -Path (Join-Path $o 'regular') -Force | Out-Null
+    New-Item -ItemType Directory -Path (Join-Path $o 'sams') -Force | Out-Null
+    return $o
+  }
+  # A row shaped like the ones every term-rotation builder writes: what it was found by, and when.
+  function New-CovRow([string]$Term, [string]$AsOf) {
+    return [ordered]@{ store = 'Walmart'; item = ('a product for ' + $Term); ad_price = '$1.00'
+                       current_price = 1.0; found_by_term = $Term; as_of = $AsOf }
+  }
+  function Write-CovCapture([string]$OutDir, [string]$Rel, $Rows, $Ledger) {
+    $doc = [ordered]@{ store = 'Walmart'; price_type = 'everyday'; captured = $covToday; deals = @($Rows) }
+    if ($null -ne $Ledger) { $doc['capture_terms'] = @($Ledger) }
+    [IO.File]::WriteAllText((Join-Path $OutDir $Rel), ($doc | ConvertTo-Json -Depth 6))
+  }
+  function Set-CovCursor([string]$OutDir, $Fields) {
+    [IO.File]::WriteAllText((Join-Path $OutDir 'capture-cursor.json'), ($Fields | ConvertTo-Json -Depth 4))
+  }
+  function Get-CovCursorField([string]$OutDir, [string]$Name) {
+    $p = Join-Path $OutDir 'capture-cursor.json'
+    if (-not (Test-Path -LiteralPath $p)) { return $null }
+    $d = ConvertFrom-Json ([IO.File]::ReadAllText($p))
+    if ($d.PSObject.Properties[$Name]) { return $d.$Name }
+    return $null
+  }
+
+  # ---- 1. MUST FIRE: the Sam's Club 2026-08-22 shape, on the store whose capture is a deals_glob ----
+  # Cursor at #0, and the capture that landed is 122 rows of terms #7..#13 - the NEXT slice. Under the
+  # old rule this advanced #0 -> #7 and those seven terms waited a quarter.
+  $o1 = New-CovOut 'sams-next-slice'
+  $r1rows = @(0..6 | ForEach-Object { New-CovRow (& $covTermAt (7 + $_)) $covToday })
+  [IO.File]::WriteAllText((Join-Path $o1 ('sams\sams-deals-' + $covToday + '.json')),
+    (([ordered]@{ store = "Sam's Club"; captured = $covToday; deals = @($r1rows) }) | ConvertTo-Json -Depth 6))
+  $c1 = Step-CaptureCursor -Store "Sam's Club" -Today $covToday -OutDir $o1
+  if (-not $c1.Advanced -and $c1.From -eq 0 -and $c1.To -eq 0 -and $c1.Covered -eq 0 -and $c1.Reason -match 'covered NONE') {
+    Ok "MUST FIRE  a landed Sam's capture of the NEXT slice's terms does not advance the cursor past the slice it skipped ($($c1.Reason))"
+  } else { Bad "the 2026-08-22 Sam's skip did not reproduce: advanced=$($c1.Advanced) $($c1.From)->$($c1.To) covered=$($c1.Covered) - $($c1.Reason)" }
+  if ((Get-CovCursorField $o1 'SamsClub_stall') -eq 1 -and (Get-CovCursorField $o1 'SamsClub_stall_day') -eq $covToday) {
+    Ok 'the held day is counted once, in the cursor file, so a stuck rotation is visible on disk instead of being silent'
+  } else { Bad "the stall was not recorded: stall=$(Get-CovCursorField $o1 'SamsClub_stall') day=$(Get-CovCursorField $o1 'SamsClub_stall_day')" }
+  if ($null -eq (Get-CovCursorField $o1 'SamsClub_last')) {
+    Ok 'a held day does not stamp <store>_last, so a real capture of that slice later the same day can still advance it'
+  } else { Bad 'a held day stamped <store>_last and locked the store out of its own slice for the rest of the day' }
+
+  # ---- 2. MUST FIRE: the Walmart 2026-08-30 shape - 525 fresh rows, none of them the slice ----
+  $o2 = New-CovOut 'walmart-other-terms'
+  Set-CovCursor $o2 ([ordered]@{ Walmart = 28 })
+  $r2rows = @(0..23 | ForEach-Object { New-CovRow (& $covTermAt $_) $covToday })
+  Write-CovCapture $o2 ('regular\walmart-regular-' + $covToday + '.json') $r2rows $null
+  $c2 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o2
+  if (-not $c2.Advanced -and $c2.To -eq 28) {
+    Ok "MUST FIRE  a landed Walmart capture of 24 other terms does not carry slice #28..#34 ($($c2.Reason))"
+  } else { Bad "the 2026-08-30 Walmart skip did not reproduce: advanced=$($c2.Advanced) $($c2.From)->$($c2.To) - $($c2.Reason)" }
+
+  # ---- 3. MUST NOT FIRE: a capture that really covered its slice advances the whole slice ----
+  # This is the crying-wolf half. If it ever goes red the rule has stopped being a rule and become a
+  # freeze, which is the failure mode the escapes below exist to keep out.
+  $o3 = New-CovOut 'covered'
+  Set-CovCursor $o3 ([ordered]@{ Walmart = 28 })
+  $r3rows = @(28..34 | ForEach-Object { New-CovRow (& $covTermAt $_) $covToday })
+  Write-CovCapture $o3 ('regular\walmart-regular-' + $covToday + '.json') $r3rows $null
+  $c3 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o3
+  if ($c3.Advanced -and $c3.From -eq 28 -and $c3.To -eq 35 -and $c3.Covered -eq 7 -and $c3.CoverageSource -eq 'found_by_term') {
+    Ok "MUST NOT FIRE  a capture covering all 7 slice terms advances the full slice, #28 -> #35 ($($c3.Reason))"
+  } else { Bad "a fully covered slice did not advance: advanced=$($c3.Advanced) $($c3.From)->$($c3.To) covered=$($c3.Covered) - $($c3.Reason)" }
+  if ($null -eq (Get-CovCursorField $o3 'Walmart_stall')) { Ok 'a clean advance leaves no stall key behind - zero is written as the absence of a stall' }
+  else { Bad "a clean advance left a stall counter of $(Get-CovCursorField $o3 'Walmart_stall')" }
+
+  # ---- 4. A PARTIAL DAY ADVANCES TO THE FIRST GAP AND NO FURTHER ----
+  # Terms #28,#29,#30 and #32,#33,#34 came back, #31 did not. Advancing 7 skips #31 for a quarter;
+  # advancing 0 would stall a capture that plainly worked. Three is the only honest number, and #31
+  # leads tomorrow's slice.
+  $o4 = New-CovOut 'partial'
+  Set-CovCursor $o4 ([ordered]@{ Walmart = 28 })
+  $r4rows = @(@(28, 29, 30, 32, 33, 34) | ForEach-Object { New-CovRow (& $covTermAt $_) $covToday })
+  Write-CovCapture $o4 ('regular\walmart-regular-' + $covToday + '.json') $r4rows $null
+  $c4 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o4
+  if ($c4.Advanced -and $c4.To -eq 31 -and $c4.Reason -match 'term 031') {
+    Ok "MUST FIRE  a slice with a hole at #31 advances 3 of 7 and stops there, so #31 leads tomorrow instead of being skipped ($($c4.Reason))"
+  } else { Bad "partial coverage advanced wrongly: $($c4.From)->$($c4.To) - $($c4.Reason)" }
+  # AND THE MECHANISM, not the message: TOMORROW re-offers #31. The day is rolled back the way
+  # commit-capture-cursor's own suite does it - by ageing <store>_last, never by faking the date, which
+  # the replay guard refuses. The same capture file is still on disk and still shows nothing for #31,
+  # so the honest answer tomorrow is to hold there and say so.
+  $cur4 = ConvertFrom-Json ([IO.File]::ReadAllText((Join-Path $o4 'capture-cursor.json')))
+  $cur4.Walmart_last = $covYday
+  [IO.File]::WriteAllText((Join-Path $o4 'capture-cursor.json'), ($cur4 | ConvertTo-Json -Depth 4))
+  $c4b = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o4
