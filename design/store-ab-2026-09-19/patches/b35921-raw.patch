+  } else { Bad "the uncovered term was not re-offered the next day: from=$($c4b.From) advanced=$($c4b.Advanced) - $($c4b.Reason)" }
+
+  # ---- 5. MUST FIRE: a CARRIED row is evidence about the day it was bought, not about today ----
+  # Aldi, Fareway and Family Fare files hold months of carried rows; counting them would make every
+  # rotation look covered forever.
+  $o5 = New-CovOut 'carried'
+  Set-CovCursor $o5 ([ordered]@{ Walmart = 28 })
+  $r5rows = @(28..34 | ForEach-Object { New-CovRow (& $covTermAt $_) $covYday })
+  Write-CovCapture $o5 ('regular\walmart-regular-' + $covToday + '.json') $r5rows $null
+  $c5 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o5
+  if (-not $c5.Advanced) { Ok "MUST FIRE  rows carried from $covYday do not count as today's coverage ($($c5.Reason))" }
+  else { Bad "carried rows advanced the cursor $($c5.From)->$($c5.To) - a file of old rows would rotate the catalogue on its own" }
+
+  # ---- 6. MUST NOT FIRE: an ASKED term the store had nothing for is COVERED ----
+  # The capture_terms ledger Family Fare, Baker's and Hy-Vee write is the only thing here that can tell
+  # "asked, and the store had nothing" from "never asked". The first must advance: an empty answer has
+  # four causes (not-carried, blocked, unrendered, unsettled) and none of them writes a row, so treating
+  # it as uncovered would park the rotation on the first item the store does not stock.
+  $o6 = New-CovOut 'asked-empty'
+  Set-CovCursor $o6 ([ordered]@{ Walmart = 28 })
+  $l6 = @(28..34 | ForEach-Object { [ordered]@{ term = (& $covTermAt $_); ordinal = $_; outcome = 'empty'; row_count = 0 } })
+  Write-CovCapture $o6 ('regular\walmart-regular-' + $covToday + '.json') @(New-CovRow 'term 500' $covToday) $l6
+  $c6 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o6
+  if ($c6.Advanced -and $c6.To -eq 35 -and $c6.CoverageSource -eq 'capture_terms') {
+    Ok "MUST NOT FIRE  a slice the ledger says was ASKED and came back empty advances in full ($($c6.Reason))"
+  } else { Bad "an asked-and-empty slice was treated as uncovered: advanced=$($c6.Advanced) $($c6.From)->$($c6.To) source=$($c6.CoverageSource) - $($c6.Reason)" }
+
+  # ---- 7. MUST FIRE: the Baker's 2026-09-18 shape - the ledger says the slice was NOT asked ----
+  # 70 of its 74 asks that day were the weekly ad list, which leads the worklist inside the same
+  # allowance; the rotation slice was never put to the store and the cursor stepped over it anyway.
+  $o7 = New-CovOut 'ledger-not-asked'
+  Set-CovCursor $o7 ([ordered]@{ Walmart = 28 })
+  $l7 = @()
+  $l7 += @(28..34 | ForEach-Object { [ordered]@{ term = (& $covTermAt $_); ordinal = $_; outcome = 'not_asked'; row_count = 0
+                                                 reason = "outside today's capture-policy slice" } })
+  $l7 += @(100..109 | ForEach-Object { [ordered]@{ term = (& $covTermAt $_); ordinal = $_; outcome = 'success'; row_count = 5 } })
+  Write-CovCapture $o7 ('regular\walmart-regular-' + $covToday + '.json') @(New-CovRow 'term 100' $covToday) $l7
+  $c7 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o7
+  if (-not $c7.Advanced -and $c7.CoverageSource -eq 'capture_terms') {
+    Ok "MUST FIRE  a ledger that says the slice was not_asked holds the cursor, however many other terms succeeded ($($c7.Reason))"
+  } else { Bad "a not_asked slice advanced: advanced=$($c7.Advanced) $($c7.From)->$($c7.To) - $($c7.Reason)" }
+
+  # ---- 8. CLEAN TWIN: a capture whose shape carries NO coverage evidence still rotates ----
+  # Every lock path in this estate degrades to the behaviour of the day before, never to a refusal. A
+  # capture file with neither a ledger nor found_by_term/as_of on its rows is a could-not-look, so the
+  # advance is exactly what it was before this rule existed - and the reason says BLIND, so a run of
+  # them can be counted rather than mistaken for coverage.
+  $o8 = New-CovOut 'blind'
+  Set-CovCursor $o8 ([ordered]@{ Walmart = 28 })
+  Write-CovCapture $o8 ('regular\walmart-regular-' + $covToday + '.json') @(@{ item = 'x'; ad_price = '$1.00' }) $null
+  $c8 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o8
+  if ($c8.Advanced -and $c8.To -eq 35 -and $c8.CoverageSource -eq 'none' -and $c8.Reason -match 'BLIND') {
+    Ok "CLEAN TWIN a capture shape with no coverage evidence advances as it did before the rule, and says BLIND ($($c8.Reason))"
+  } else { Bad "a blind capture was refused instead of degrading: advanced=$($c8.Advanced) $($c8.From)->$($c8.To) - $($c8.Reason)" }
+
+  # ---- 9. THE STALL ESCAPE, AT ITS BAR AND EITHER SIDE OF IT ----
+  # The bar is $script:CursorStallDays = 3 LANDED days. A term with no per-term ledger behind it cannot
+  # prove it was asked, so after three landed captures that show nothing for it the cursor steps over
+  # THAT ONE TERM and says why. The cases sit at 2 (one short), 3 (exactly at it) and 4 (past it),
+  # because a suite that only tests the far side of a bar cannot see a -gt flipped to a -ge.
+  foreach ($seed in @(1, 2, 3)) {
+    $oS = New-CovOut ('stall-' + $seed)
+    Set-CovCursor $oS ([ordered]@{ Walmart = 28; Walmart_stall = $seed; Walmart_stall_day = $covYday })
+    $rS = @(100..109 | ForEach-Object { New-CovRow (& $covTermAt $_) $covToday })
+    Write-CovCapture $oS ('regular\walmart-regular-' + $covToday + '.json') $rS $null
+    $cS = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $oS
+    $day = $seed + 1
+    if ($day -lt 3) {
+      if (-not $cS.Advanced -and $cS.Stall -eq $day) {
+        Ok "MUST NOT FIRE  day $day of 3 (the bar is $script:CursorStallDays landed days): the head term still holds the cursor"
+      } else { Bad "day $day of 3 escaped early: advanced=$($cS.Advanced) stall=$($cS.Stall) - $($cS.Reason)" }
+    } else {
+      $where = if ($day -eq $script:CursorStallDays) { "exactly AT the bar of $script:CursorStallDays" } else { "one day PAST the bar of $script:CursorStallDays" }
+      if ($cS.Advanced -and $cS.To -eq 29 -and $cS.Reason -match 'stepping over ONE term') {
+        Ok "MUST FIRE  day $day, $where landed days, steps over ONE term (#28 -> #29), never the slice"
+      } else { Bad "day $day ($where) did not take the one-term escape: advanced=$($cS.Advanced) $($cS.From)->$($cS.To) - $($cS.Reason)" }
+      if ($null -eq (Get-CovCursorField $oS 'Walmart_stall')) { Ok "the escape resets the counter, so the next term gets its own $script:CursorStallDays days" }
+      else { Bad "the stall counter survived the escape at $(Get-CovCursorField $oS 'Walmart_stall') - the rest of the slice would be stepped over one term per run" }
+    }
+  }
+
+  # ---- 10. CLEAN TWIN: a builder that runs four times today counts ONE day, not four ----
+  # Without the date stamp the escape would fire inside a single morning, which is the one-slice-per-day
+  # bug of 2026-08-21 wearing a different coat.
+  $o10 = New-CovOut 'same-day'
+  Set-CovCursor $o10 ([ordered]@{ Walmart = 28 })
+  $r10 = @(100..109 | ForEach-Object { New-CovRow (& $covTermAt $_) $covToday })
+  Write-CovCapture $o10 ('regular\walmart-regular-' + $covToday + '.json') $r10 $null
+  $c10 = $null
+  for ($n = 0; $n -lt 4; $n++) { $c10 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o10 }
+  if (-not $c10.Advanced -and (Get-CovCursorField $o10 'Walmart_stall') -eq 1) {
+    Ok 'CLEAN TWIN four runs of the builder on one day count one stall day, so the escape cannot fire in a single morning'
+  } else { Bad "four runs counted $(Get-CovCursorField $o10 'Walmart_stall') day(s) - advanced=$($c10.Advanced)" }
+
+  # ---- 11. CLEAN TWIN: the three guards that were already here still hold on the new path ----
+  $o11 = New-CovOut 'guards'
+  Set-CovCursor $o11 ([ordered]@{ Walmart = 28 })
+  $c11a = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o11
+  if (-not $c11a.Advanced -and $c11a.Reason -match 'no fresh rows landed') { Ok 'CLEAN TWIN no capture at all still holds the cursor with its own reason, ahead of any coverage question' }
+  else { Bad "the landed guard changed: advanced=$($c11a.Advanced) - $($c11a.Reason)" }
+  $c11b = Step-CaptureCursor -Store 'Walmart' -Today '2026-07-31' -OutDir $o11
+  if (-not $c11b.Advanced -and $c11b.Reason -match 'REPLAY') { Ok 'CLEAN TWIN a replay date is still refused before anything is read' }
+  else { Bad "the replay guard changed: advanced=$($c11b.Advanced) - $($c11b.Reason)" }
+  $r11 = @(100..109 | ForEach-Object { New-CovRow (& $covTermAt $_) $covToday })
+  Write-CovCapture $o11 ('regular\walmart-regular-' + $covToday + '.json') $r11 $null
+  $c11c = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o11 -Force
+  if ($c11c.Advanced -and $c11c.To -eq 35 -and $c11c.Reason -match 'FORCED') { Ok 'CLEAN TWIN -Force still advances the whole slice, and says the coverage was not required' }
+  else { Bad "-Force did not advance: advanced=$($c11c.Advanced) $($c11c.From)->$($c11c.To) - $($c11c.Reason)" }
+
+  # ---- 12. CLEAN TWIN: a covering capture clears a stall the store had accumulated ----
+  $o12 = New-CovOut 'recover'
+  Set-CovCursor $o12 ([ordered]@{ Walmart = 28; Walmart_stall = 2; Walmart_stall_day = $covYday })
+  $r12 = @(28..34 | ForEach-Object { New-CovRow (& $covTermAt $_) $covToday })
+  Write-CovCapture $o12 ('regular\walmart-regular-' + $covToday + '.json') $r12 $null
+  $c12 = Step-CaptureCursor -Store 'Walmart' -Today $covToday -OutDir $o12
+  if ($c12.Advanced -and $c12.To -eq 35 -and $null -eq (Get-CovCursorField $o12 'Walmart_stall')) {
+    Ok 'CLEAN TWIN a store that was 2 days into a stall advances normally once its slice is covered, and the counter is cleared'
+  } else { Bad "a stalled store did not recover: advanced=$($c12.Advanced) $($c12.From)->$($c12.To) stall=$(Get-CovCursorField $o12 'Walmart_stall')" }
+
+  # ---- 13. THE ADVANCE LINE RECORDS WHAT IT WAS JUDGED ON ----
+  # Finding the three skipped slices took a replay of this log against the captures of those days and a
+  # historical commodity-search.json for each. The coverage on the line is what makes the same question
+  # a grep next time.
+  $logLine = @(Get-Content -LiteralPath (Join-Path $o3 'capture-cursor-log.jsonl') | Where-Object { $_.Trim() })
+  $logRec = $null
+  if ($logLine.Count -eq 1) { try { $logRec = $logLine[0] | ConvertFrom-Json } catch { } }
+  if ($logRec -and [int]$logRec.covered -eq 7 -and [int]$logRec.slice -eq 7 -and [string]$logRec.coverage -eq 'found_by_term') {
+    Ok 'the cursor log line carries covered / slice / coverage, so a later replay does not have to rebuild the evidence'
+  } else { Bad "the advance was logged without its coverage: [$($logLine -join ' | ')]" }
 } finally { Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue }
 
 Write-Output ("CAPTURE-POLICY " + $(if ($fail) { "FAILED ($fail)" } else { 'PASSED' }))
