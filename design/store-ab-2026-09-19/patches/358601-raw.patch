+# 13-20. THE TABLE AND THE BOARD MUST NAME THE SAME PRODUCT FOR A CELL (2026-09-19)
+#
+# Until this block the table chose its representative row with `Sort-Object unit_price | Select -First 1`
+# and the board chose its own with Select-StoreWinner, whose keys the table knew nothing about. On a
+# per-unit tie the two could name DIFFERENT PRODUCTS for one store cell - same price, different brand,
+# different size, different link - and parity was silent through all of it because parity compared the
+# number, and on a tie the number agrees. These cases drive the SHIPPED functions, and each one that can
+# depend on input order asserts BOTH orders.
+# ---------------------------------------------------------------------------------------------------
+function PtRowX {
+  param([string]$Store, [double]$Up, [string]$Type, [string]$Name, [string]$Size = '',
+        [bool]$Linked = $true, [string]$From = '', [string]$To = '', [string]$SourceAd = '')
+  [pscustomobject]@{ store = $Store; unit_price = $Up; price_type = $Type; name = $Name; size_text = $Size
+    price_text = ('$' + $Up); src_date = ''; ad_from = $From; ad_to = $To; ad_basis = ''
+    source_ad = $SourceAd; membership = $false; has_identity = $Linked }
+}
+
+# 13. MUST FIRE - THE FOUNDING DEFECT. Two everyday rows, one store, the SAME per-unit price. The board
+#     takes the linkable one (key 2, the 2026-08-22 pancake ruling); a bare price sort knows nothing
+#     about that key, so it took whichever row the unstable sort handed back. The NAMES point the other
+#     way on purpose - 'Alpha' sorts before 'Zeta' ordinally - so a table that had quietly fallen back
+#     to a name sort fails this case rather than passing it by luck.
+$tiePool = @(
+  (PtRowX -Store 'Aldi' -Up 0.50 -Type 'everyday' -Name 'Alpha Olives 10 oz' -Size '10 oz' -Linked $false),
+  (PtRowX -Store 'Aldi' -Up 0.50 -Type 'everyday' -Name 'Zeta Olives 10 oz'  -Size '10 oz' -Linked $true)
+)
+$r = Build-PriceTableRow -Id 'olives' -Commodity 'Olives' -Unit 'oz' -Today $TODAY -Rows $tiePool
+$rRev = Build-PriceTableRow -Id 'olives' -Commodity 'Olives' -Unit 'oz' -Today $TODAY -Rows @($tiePool[1], $tiePool[0])
+$boardPick = (Select-StoreWinner $tiePool).name
+if ($r.stores['Aldi'].shown_product -eq $boardPick -and $rRev.stores['Aldi'].shown_product -eq $boardPick -and $boardPick -eq 'Zeta Olives 10 oz') {
+  Ok 'a per-unit tie names the BOARD''s product (the linkable row), in both input orders'
+} else {
+  Bad ("the table named '$($r.stores['Aldi'].shown_product)' / '$($rRev.stores['Aldi'].shown_product)' where the board names '$boardPick' - same cell, same price, different product")
+}
+
+# 14. CLEAN TWIN - the price is untouched by any of it. A tie-break key may only speak where the price
+#     is already equal, so both orders must still publish the one price both rows carry.
+if ($r.stores['Aldi'].shown -eq 0.50 -and $rRev.stores['Aldi'].shown -eq 0.50) { Ok 'breaking the tie moved the product, never the price' }
+else { Bad ("the shown price moved to $($r.stores['Aldi'].shown) / $($rRev.stores['Aldi'].shown) - a tie-break key outranked the price") }
+
+# 15. THE STRUCTURAL INVARIANT, and it is the reason this is a fix rather than a patch. The table splits
+#     the pool into an everyday half and a live-ad half and takes a winner in each; the board takes ONE
+#     winner over the whole pool. Those agree BY CONSTRUCTION only because the order is total - the
+#     minimum of a set is the minimum of its parts' minima - which is exactly what is asserted here,
+#     over a pool where the halves disagree about which is cheaper.
+$mixed = @(
+  (PtRowX -Store 'Aldi' -Up 0.50 -Type 'everyday' -Name 'Zeta Olives 10 oz'   -Size '10 oz'),
+  (PtRowX -Store 'Aldi' -Up 0.50 -Type 'everyday' -Name 'Alpha Olives 10 oz'  -Size '10 oz'),
+  (PtRowX -Store 'Aldi' -Up 0.60 -Type 'sale'     -Name 'Cheap Olives 10 oz'  -Size '10 oz' -From '2026-08-19' -To '2026-08-25' -SourceAd 'weekly')
+)
+$rm = Build-PriceTableRow -Id 'olives' -Commodity 'Olives' -Unit 'oz' -Today $TODAY -Rows $mixed
+$rmRev = Build-PriceTableRow -Id 'olives' -Commodity 'Olives' -Unit 'oz' -Today $TODAY -Rows @($mixed[2], $mixed[1], $mixed[0])
+$boardWhole = (Select-StoreWinner $mixed).name
+if ($rm.stores['Aldi'].shown_product -eq $boardWhole -and $rmRev.stores['Aldi'].shown_product -eq $boardWhole) {
+  Ok "the winner of the two halves IS the board's winner over the whole pool ('$boardWhole') - the split cannot drift from the ranking"
+} else {
+  Bad ("the halves' winner '$($rm.stores['Aldi'].shown_product)' is not the board's whole-pool winner '$boardWhole' - the table re-decided the cell")
+}
+
+# 16. THE everyday/ad TIE, which is the one pair the old `ad -le everyday` test actually decided. One
+#     product at one price, carried both as the shelf price and as a sale that merely matches it. The
+#     preference is UNCHANGED - the ad still wins - but it now lives in the shared order as key 5, so
+#     the board agrees with it instead of tossing a coin for the cell's type and ad window.
+$evAd = @(
+  (PtRowX -Store 'Hy-Vee' -Up 1.99 -Type 'everyday' -Name 'Russet Potatoes 5 lb' -Size '5 lb'),
+  (PtRowX -Store 'Hy-Vee' -Up 1.99 -Type 'sale'     -Name 'Russet Potatoes 5 lb' -Size '5 lb' -From '2026-08-19' -To '2026-08-25' -SourceAd 'weekly')
+)
+$re = Build-PriceTableRow -Id 'potatoes' -Commodity 'Potatoes' -Unit 'lb' -Today $TODAY -Rows $evAd
+$reRev = Build-PriceTableRow -Id 'potatoes' -Commodity 'Potatoes' -Unit 'lb' -Today $TODAY -Rows @($evAd[1], $evAd[0])
+if ($re.stores['Hy-Vee'].shown_kind -eq 'ad' -and $reRev.stores['Hy-Vee'].shown_kind -eq 'ad' -and $re.stores['Hy-Vee'].shown -eq 1.99) {
+  Ok 'a sale that merely matches the shelf price is still shown as the ad, reproducibly, at the same price'
+} else {
+  Bad ("the everyday/ad tie is order-dependent: kind=$($re.stores['Hy-Vee'].shown_kind) / $($reRev.stores['Hy-Vee'].shown_kind)")
+}
+
+# 16b. MUST FIRE - AND THE PREFERENCE IS A TIE-BREAK, NOT A PRIORITY. The old rule was `ad -le everyday`,
+#      which handed the cell to the ad whenever the two were equal, whatever else was true of the rows.
+#      Here the everyday row is LINKABLE and the ad row is not, at the same price - so the board's key 2
+#      speaks first and the EVERYDAY row is what represents this store. A table still running the old
+#      comparison names the ad row and disagrees with the board, at a price that matches to the cent.
+$evWins = @(
+  (PtRowX -Store 'Fareway' -Up 0.50 -Type 'everyday' -Name 'Zeta Beans 10 oz'  -Size '10 oz' -Linked $true),
+  (PtRowX -Store 'Fareway' -Up 0.50 -Type 'sale'     -Name 'Alpha Beans 10 oz' -Size '10 oz' -Linked $false -From '2026-08-19' -To '2026-08-25' -SourceAd 'weekly')
+)
+$rw = Build-PriceTableRow -Id 'beans' -Commodity 'Beans' -Unit 'oz' -Today $TODAY -Rows $evWins
+$rwCell = $rw.stores['Fareway']
+$boardWins = (Select-StoreWinner $evWins).name
+if ($rwCell.shown_kind -eq 'everyday' -and $rwCell.shown_product -eq $boardWins -and $rwCell.shown -eq 0.50) {
+  Ok 'a linkable everyday row beats an unlinkable ad at the same price - the ad preference is a tie-break, not a priority'
+} else {
+  Bad ("the table gave the cell to '$($rwCell.shown_product)' (kind=$($rwCell.shown_kind)) where the board names '$boardWins' - it is still deciding the halves on price alone")
+}
+
+# 16c. CLEAN TWIN - a genuinely cheaper ad still takes the cell, and shown_product follows it across to
+#      the OTHER column. Without this the case above is satisfied by a table that simply never shows ads.
+$BAKERS = "Baker's"
+$adWins = @(
+  (PtRowX -Store $BAKERS -Up 3.00 -Type 'everyday' -Name 'Store Brand Butter 16 oz' -Size '16 oz'),
+  (PtRowX -Store $BAKERS -Up 2.00 -Type 'sale'     -Name 'Name Brand Butter 16 oz'  -Size '16 oz' -From '2026-08-19' -To '2026-08-25' -SourceAd 'weekly')
+)
+$ra = Build-PriceTableRow -Id 'butter' -Commodity 'Butter' -Unit 'lb' -Today $TODAY -Rows $adWins
+$raCell = $ra.stores[$BAKERS]
+if ($raCell.shown -eq 2.00 -and $raCell.shown_kind -eq 'ad' -and $raCell.shown_product -eq 'Name Brand Butter 16 oz') {
+  Ok 'a genuinely cheaper ad still takes the cell, and shown_product names the AD''s product, not the everyday one'
+} else {
+  Bad ("the cheaper ad did not carry its own product across: shown=$($raCell.shown) kind=$($raCell.shown_kind) product='$($raCell.shown_product)'")
+}
+
+# 17. shown_product is READ OFF THE WINNING ROW, so it must always be the column shown_kind names. A
+#     shown_product derived some second way would be a third implementation of the same decision, and
+#     the cells below are chosen so that each column wins at least once - a set where the everyday row
+#     always won would be satisfied by a field hard-wired to everyday_product.
+$cells = @($r.stores['Aldi'], $rm.stores['Aldi'], $re.stores['Hy-Vee'], $rwCell, $raCell)
+$kinds = @($cells | ForEach-Object { $_.shown_kind } | Select-Object -Unique)
+if ($kinds.Count -eq 2) { Ok 'the shown_product cases cover BOTH columns - neither an everyday-only nor an ad-only set' }
+else { Bad ("the shown_product cases only ever show '" + ($kinds -join ',') + "' - a hard-wired field would pass them all") }
+$mismatch = @($cells | Where-Object {
+  $want = $(if ($_.shown_kind -eq 'ad') { $_.ad_product } else { $_.everyday_product })
+  -not [string]::Equals([string]$_.shown_product, [string]$want, [StringComparison]::Ordinal) })
+if ($mismatch.Count -eq 0) { Ok ("shown_product names the column shown_kind points at, in all " + $cells.Count + " cell(s) checked") }
+else { Bad ("shown_product disagrees with shown_kind in $($mismatch.Count) of $($cells.Count) cell(s) - it is being derived twice") }
+
+# 18. MUST FIRE - PARITY MUST BE ABLE TO SEE A PRODUCT DISAGREEMENT. This is the case the old parity
+#     check could not have: the price AGREES to the cent and the product does not. A parity check that
+#     compares only numbers reports "parity OK" over exactly the defect it exists to catch.
+$tblP = @( (Build-PriceTableRow -Id 'olives' -Commodity 'Olives' -Unit 'oz' -Today $TODAY -Rows $tiePool) )
+$cmpSameProduct = [pscustomobject]@{ comparison = @([pscustomobject]@{ id = 'olives'; stores = @(
+  [pscustomobject]@{ store = 'Aldi'; per_unit = 0.50; item = 'Zeta Olives 10 oz' }) }) }
+$cmpOtherProduct = [pscustomobject]@{ comparison = @([pscustomobject]@{ id = 'olives'; stores = @(
+  [pscustomobject]@{ store = 'Aldi'; per_unit = 0.50; item = 'Alpha Olives 10 oz' }) }) }
+$pb = @(Test-PriceTableParity -Table $tblP -Comparison $cmpOtherProduct)
+if ($pb.Count -eq 1 -and $pb[0].kind -eq 'product') { Ok 'parity FIRES when the board and the table name different products at the SAME price' }
+else { Bad ("parity could not see a product disagreement at an identical price - it is still number-only (got " + $pb.Count + " finding(s): " + (($pb | ForEach-Object { $_.kind }) -join ',') + ")") }
+
+# 19. CLEAN TWIN - and it is silent when both halves agree. Without this the case above is satisfied by
+#     a check that simply fires on everything.
+$pg = @(Test-PriceTableParity -Table $tblP -Comparison $cmpSameProduct)
+if ($pg.Count -eq 0) { Ok 'parity is silent when the price AND the product agree' }
+else { Bad ("parity fired on an agreeing cell: " + (($pg | ForEach-Object { $_.why }) -join ' | ')) }
+
+# 20. A COULD-NOT-LOOK IS COUNTED, NEVER A PASS. A board cell carrying no `item` is the one way the
+#     product half can go quiet, and if the engine ever renames that field this check would otherwise
+#     turn vacuous while still printing "parity OK" - green by vacuum, which is the failure this whole
+#     harness exists to keep out. It must report 'product-unchecked', and it must NOT report 'product'.
+$cmpNoItem = [pscustomobject]@{ comparison = @([pscustomobject]@{ id = 'olives'; stores = @(
+  [pscustomobject]@{ store = 'Aldi'; per_unit = 0.50 }) }) }
+$pn = @(Test-PriceTableParity -Table $tblP -Comparison $cmpNoItem)
+if ($pn.Count -eq 1 -and $pn[0].kind -eq 'product-unchecked') { Ok 'a board cell that names no product is counted as UNCHECKED, not reported as agreement and not as a mismatch' }
+else { Bad ("a board cell with no product was not counted as a could-not-look (got " + $pn.Count + " finding(s): " + (($pn | ForEach-Object { $_.kind }) -join ',') + ")") }
+
 Write-Output ("PRICE-TABLE " + $(if ($fail) { "FAILED ($fail)" } else { 'PASSED' }))
 Exit-Guard -Name 'price-table' -Summary "failed=$fail" -Code $(if ($fail) { 1 } else { 0 })
