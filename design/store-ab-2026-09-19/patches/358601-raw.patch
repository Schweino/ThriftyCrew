@@ -0,0 +1,165 @@
+# store-winner-lib.ps1 - WHICH ROW REPRESENTS A STORE, AND WHICH STORE WEARS THE CROWN. One copy.
+# ---------------------------------------------------------------------------------------------------
+# WHY THIS FILE EXISTS (2026-09-19). The rule used to live inside `compare-deals.ps1` as
+# `Select-StoreWinner`, which meant the ONLY caller that could reach it was the engine itself. Two
+# decisions that must agree with it therefore did not:
+#
+#   1. THE CROWN. `$ranked = $byStore | Sort-Object unit_price` ranked the per-store winners on price
+#      and NOTHING else. Windows PowerShell 5.1's Sort-Object is not a stable sort and has no -Stable
+#      (that arrived in PowerShell 6), so two stores tied to the cent per unit came out in whatever
+#      order the sort's internals produced for that input ordering - and the input ordering is a
+#      Group-Object enumeration, which is not fixed run to run. `cheapest_store`, `nomem_store`, the
+#      published `stores` array order and the rounding-band tie list all rode on that. The price was
+#      right every time and the name beside it was luck.
+#   2. THE PRICE TABLE. `price-table-lib.ps1` sorted its everyday and ad halves with a bare
+#      `Sort-Object unit_price | Select-Object -First 1` - a SECOND implementation of "which row wins",
+#      which its own header calls out as the way a table and the board it describes drift apart while
+#      both look right. On a tie it could name a different product than the board did for that same
+#      store cell, at the same price, and the parity check could not see it because parity compared
+#      only the number.
+#
+# THE ORDER, and it is a TOTAL one. Keys 1-4 are the estate's existing ratified rule, unchanged and in
+# their original order; 5 and 6 close it so no two distinct rows can compare equal.
+#
+#   1. per-unit price        - the whole point of the board; nothing below can make a cell dearer
+#   2. can we link it        - 2026-08-22, an unlinkable row cannot be verified or re-found
+#   3. smaller package       - 2026-08-31, a case pack ties its own single unit and must not beat it
+#   4. product name          - the 2026-09-11 key that made the winner reproducible within a store
+#   5. sale before everyday  - 2026-09-19, see below
+#   6. row signature         - 2026-09-19, the closer: the provenance fields the board PUBLISHES
+#
+# KEY 5 IS NOT COSMETIC AND IT IS DELIBERATELY BELOW KEY 4. One store can carry the same product at the
+# same per-unit price as BOTH an everyday row and a live sale row - a sale that merely matches the shelf
+# price. Keys 1-4 are then all silent, because it is one product at one price, and the two rows differ
+# only in `price_type` and the ad window hanging off it. The board publishes `type`, `ad_from` and
+# `ad_to` from whichever row won, so that cell flipped run to run. `price-table-lib.ps1` already had an
+# answer for exactly this pair - its cheaper-of test was `ad -le everyday`, so the AD won a tie - and
+# key 5 adopts it rather than inventing a second one. Below key 4 on purpose: where two DIFFERENT
+# products tie, the name is still what decides, so this key re-decides nothing the ratified rule
+# already decided.
+#
+# KEY 6 IS WHAT MAKES THE ORDER TOTAL. Two rows for one store can agree on price, linkability, size and
+# name and still be different rows - the same product read out of two captures, or off two flyers, with
+# different `source_ad`, `ad_from`/`ad_to` or `basis`. Every one of those fields is PUBLISHED on the
+# board cell, so picking between them by luck publishes a different cell. The signature is built from
+# the row's own data and from nothing else, so it cannot depend on the order the rows arrived in.
+#
+# COMPARED ORDINALLY, NEVER BY CULTURE. PowerShell's default string comparison - which is what
+# `Sort-Object` uses - is culture-sensitive, and a culture-sensitive comparison can call two DIFFERENT
+# strings equal. The estate has already paid for that once: `('Bana' + [char]0 + 'nas') -ne 'Bananas'`
+# is `$false`. An order whose last key can return "equal" for two distinct rows is not a total order at
+# all, and we would be back to luck with more code. So the comparison here is a real comparator using
+# `[string]::CompareOrdinal`, and the selection is a linear min scan rather than a `Sort-Object`. That
+# also retires the unstable-sort hazard from this decision path entirely: no sort is involved.
+#
+# THE RULE THAT KEEPS IT ONE COPY: this file has NO side effects on load and is CLOSED UNDER CALLING -
+# nothing in here calls a function defined outside it. `price-table-lib.ps1` is dot-sourced by
+# `test-price-table.ps1` with no engine in sight, so an outward call would die at CALL time, in a
+# fixture, for a reason that names the wrong thing. `compare-deals.ps1 -SelfTest` asserts the closure.
+# ---------------------------------------------------------------------------------------------------
+
+function Get-PackOz([string]$size, [string]$name) {
+  # Total package weight in ounces, ONLY when the size string states one plainly. Returns $null otherwise -
+  # an unknown size must never be treated as a violation, or every store that omits sizes loses the cell.
+  # Deliberately naive: it takes the FIRST oz number, which is right for the max_pack_oz cap it was written
+  # for. Test-PieceSize reads count-first and range grammars for itself rather than retuning this.
+  $t = (("" + $size + " " + $name)).ToLower()
+  $m = [regex]::Match($t, '(\d+(?:\.\d+)?)\s*(?:fl\s*)?oz\b')
+  if ($m.Success) { return [double]$m.Groups[1].Value }
+  $m = [regex]::Match($t, '(\d+(?:\.\d+)?)\s*(?:lbs?|pounds?)\b')
+  if ($m.Success) { return ([double]$m.Groups[1].Value * 16) }
+  return $null
+}
+
+function Get-StoreRowKey($row) {
+  <#
+    .SYNOPSIS The six sort keys for one candidate row, computed ONCE so the comparator does no work.
+    .DESCRIPTION Pure over the row. `store` rides along for the cross-store ranking's seventh key; it is
+                 never consulted within a store, where every candidate carries the same one.
+  #>
+  $oz = Get-PackOz ([string]$row.size_text) ([string]$row.name)
+  # AN UNREADABLE SIZE SORTS LAST. We cannot claim a package is smaller when we cannot read it.
+  $packOz = if ($null -eq $oz -or $oz -le 0) { [double]::MaxValue } else { [double]$oz }
+  # THE SIGNATURE IS DATA, NEVER POSITION. Unit separator as the joiner because it cannot occur in a
+  # product name or a store's own field, so two different field sets cannot collide into one string.
+  $sig = (@(
+    [string]$row.product_id, [string]$row.size_text, [string]$row.price_text, [string]$row.source_ad,
+    [string]$row.src_date,   [string]$row.ad_from,   [string]$row.ad_to,      [string]$row.ad_basis,
+    [string]$row.basis,      [string]$row.note,      [string]$row.src_file,   [string]$row.fulfillment
+  ) -join ([char]31))
+  return [pscustomobject]@{
+    UnitPrice = [double]$row.unit_price
+    Unlinked  = $(if ($row.has_identity) { 0 } else { 1 })
+    PackOz    = $packOz
+    Name      = [string]$row.name
+    NotSale   = $(if ([string]$row.price_type -eq 'sale') { 0 } else { 1 })
+    Signature = $sig
+    Store     = [string]$row.store
+    Row       = $row
+  }
+}
+
+function Compare-StoreRowKey($a, $b, [switch]$AcrossStores) {
+  <#
+    .SYNOPSIS -1 when $a should outrank $b, 1 when $b should, 0 only when they are the same row.
+    .DESCRIPTION Every string key goes through [string]::CompareOrdinal, so the order is total and does
+                 not move with the machine's culture. -AcrossStores adds the seventh key, the store's
+                 own name, which is what closes the CROWN's order: within one commodity a store appears
+                 in the ranking exactly once, so a tie that reaches key 7 is decided outright.
+  #>
+  if ($a.UnitPrice -lt $b.UnitPrice) { return -1 }; if ($a.UnitPrice -gt $b.UnitPrice) { return 1 }
+  if ($a.Unlinked  -lt $b.Unlinked)  { return -1 }; if ($a.Unlinked  -gt $b.Unlinked)  { return 1 }
+  if ($a.PackOz    -lt $b.PackOz)    { return -1 }; if ($a.PackOz    -gt $b.PackOz)    { return 1 }
+  $c = [string]::CompareOrdinal($a.Name, $b.Name);      if ($c -ne 0) { return [int][math]::Sign($c) }
+  if ($a.NotSale   -lt $b.NotSale)   { return -1 }; if ($a.NotSale   -gt $b.NotSale)   { return 1 }
+  $c = [string]::CompareOrdinal($a.Signature, $b.Signature); if ($c -ne 0) { return [int][math]::Sign($c) }
+  if ($AcrossStores) {
+    $c = [string]::CompareOrdinal($a.Store, $b.Store);  if ($c -ne 0) { return [int][math]::Sign($c) }
+  }
+  return 0
+}
+
+function Select-StoreWinner($rows) {
+  <#
+    .SYNOPSIS The ONE row that represents a store for one commodity. $null when there are no candidates.
+    .DESCRIPTION A linear min scan under Compare-StoreRowKey, not a sort: we want the minimum, the
+                 comparator is total, and 5.1's Sort-Object would decide a residual tie by its own
+                 internals. Ties are therefore broken by the RULE, never by the order rows arrived in,
+                 which is the whole property a board cell needs in order to be reproducible.
+  #>
+  $best = $null; $bestKey = $null
+  foreach ($r in @($rows)) {
+    if ($null -eq $r) { continue }
+    $k = Get-StoreRowKey $r
+    if ($null -eq $bestKey -or (Compare-StoreRowKey $k $bestKey) -lt 0) { $best = $r; $bestKey = $k }
+  }
+  return $best
+}
+
+function Sort-StoreRanking($rows) {
+  <#
+    .SYNOPSIS The per-store winners ranked cheapest first, as a TOTAL order, for the crown.
+    .DESCRIPTION Insertion sort under the same comparator with the store-name key added. Insertion sort
+                 because this list is one row per store - at most seven - so the cost is nothing and the
+                 alternative is handing the residual tie back to the unstable sort this exists to avoid.
+                 Returns an array; callers index [0] for the crown and filter it for the no-membership
+                 crown, so its order is a published fact and not an implementation detail.
+  #>
+  $keys = New-Object 'System.Collections.ArrayList'
+  foreach ($r in @($rows)) {
+    if ($null -eq $r) { continue }
+    $k = Get-StoreRowKey $r
+    $i = $keys.Count
+    while ($i -gt 0) {
+      # Assigned first, never spelled inline in the call: an index expression written as a bare
+      # argument is one of the shapes this estate has had bind as several positional arguments.
+      $prev = $keys[$i - 1]
+      if ((Compare-StoreRowKey $k $prev -AcrossStores) -ge 0) { break }
+      $i--
+    }
+    [void]$keys.Insert($i, $k)
+  }
+  $out = @()
+  foreach ($k in $keys) { $out += $k.Row }
+  return ,$out
+}
