+function Get-HoldEvidence {
+  # The live half, kept thin (the shape Get-RunLogVerdict uses below): read the row's declaration and the
+  # chain's own transcript, then judge with the pure function above. Opened with ReadWrite sharing because the
+  # chain may still be writing it. Every could-not-look returns held=$false WITH its reason, and that reason is
+  # printed in the page, so a broken declaration is loud rather than quietly permissive.
+  param($Row, [string]$RepoRoot, [string]$Stamp, [datetime]$Now)
+  $r = @{ held = $false; why = ''; runs_held = 0; since = $null; newest = $null; age_h = $null }
+  if (-not $Row) { return $r }
+  $form = if ($Row.PSObject.Properties['held_when']) { [string]$Row.held_when } else { '' }
+  if (-not $form) { return $r }   # the row never opted in: its page reads exactly as it did before this block
+  if ($form -ne 'chain-guards') {
+    # ALLOWLIST, NOT DENYLIST, like currency_equals above: a form this code has never heard of excuses nothing.
+    $r.why = ("This row declares held_when '{0}', which is not a form this check knows, so it excuses nothing." -f $form)
+    return $r
+  }
+  $logRel   = if ($Row.PSObject.Properties['held_chain_log'])     { [string]$Row.held_chain_log }     else { '' }
+  $label    = if ($Row.PSObject.Properties['held_writer_label'])  { [string]$Row.held_writer_label }  else { '' }
+  $wScript  = if ($Row.PSObject.Properties['held_writer_script']) { [string]$Row.held_writer_script } else { '' }
+  if (-not $logRel -or -not $label -or -not $wScript) {
+    $r.why = 'This row declares held_when chain-guards but not all of held_chain_log, held_writer_label and held_writer_script, so the hold could not be read.'
+    return $r
+  }
+  $path = Join-Path $RepoRoot ($logRel -replace '/', '\')
+  if (-not (Test-Path -LiteralPath $path)) {
+    $r.why = ("The chain transcript {0} is not in this checkout, so nothing here says whether the board was held." -f $logRel)
+    return $r
+  }
+  $text = ''
+  try {
+    $fs = [IO.File]::Open($path, 'Open', 'Read', 'ReadWrite')
+    try { $text = (New-Object IO.StreamReader($fs, $true)).ReadToEnd() } finally { $fs.Dispose() }
+  } catch { $text = '' }
