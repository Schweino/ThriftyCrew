+  $sb = Get-PackOz ([string]$b.size_text) ([string]$b.name)
+  $sa = $(if ($null -eq $sa -or $sa -le 0) { [double]::MaxValue } else { [double]$sa })
+  $sb = $(if ($null -eq $sb -or $sb -le 0) { [double]::MaxValue } else { [double]$sb })
+  if ($sa -lt $sb) { return -1 }
+  if ($sa -gt $sb) { return 1 }
+  # 5. the total order
+  return [string]::CompareOrdinal([string]$a.store, [string]$b.store)
+}
+function Sort-StoreCells($cells) {
+  <#
+    .SYNOPSIS The per-store winners of one commodity, cheapest first, in a REPRODUCIBLE order.
+    .DESCRIPTION One row per store (Select-StoreWinner has already picked each store's row). The first
+                 element is the crown; the first non-membership element is the no-membership crown; the
+                 whole array is what the board publishes as `stores`. Pure over its argument.
+    .NOTES  RETURNS THE ARRAY UNWRAPPED - no `return ,$arr` here, deliberately, and the first run of the
+            fixtures below is why. Every caller writes `@(Sort-StoreCells $x)`, which is the inline wrap
+            the ops rules warn about: against a comma-returned array it reads as ONE element, so
+            `$ranked[0]` is $null and `$ranked[0].store` is an agreeing blank crown. Select-FreshestCaptureRows
+            returns its array the same plain way for the same reason. A single cell therefore unrolls to a
+            scalar, which every caller's `@()` re-wraps correctly.
+  #>
+  $list = New-Object System.Collections.Generic.List[object]
+  foreach ($c in @($cells)) { if ($null -ne $c) { [void]$list.Add($c) } }
+  # .ToArray(), never @($list): wrapping a New-Object List[object] throws "Argument types do not match"
+  # on PS 5.1 even when the list is empty (see ops/audit-list-array-wrap.ps1).
+  if ($list.Count -lt 2) { return $list.ToArray() }
+  $list.Sort([System.Comparison[object]]{ param($a, $b) Compare-StoreCell $a $b })
+  return $list.ToArray()
+}
