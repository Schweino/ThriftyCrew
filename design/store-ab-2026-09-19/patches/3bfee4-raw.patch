+# comparer for key 5, and List.Sort is itself an unstable introsort - which does not matter here and is the
+# property worth naming: this comparison returns 0 only for a row compared with itself, so the result is
+# unique whatever the sort does with ties. A fixture asserts exactly that.
+function Compare-StoreCell($a, $b) {
+  # 1. per-unit price. An absent price sorts LAST rather than reading as 0 - an agreeing zero would crown a
+  #    row that could not be priced at all, which is the worst answer available.
+  $pa = $(if ($null -eq $a.unit_price) { [double]::MaxValue } else { [double]$a.unit_price })
+  $pb = $(if ($null -eq $b.unit_price) { [double]::MaxValue } else { [double]$b.unit_price })
+  if ($pa -lt $pb) { return -1 }
+  if ($pa -gt $pb) { return 1 }
+  # 2. a price anyone can pay, ahead of one behind a paid membership
+  $ma = $(if ($a.membership) { 1 } else { 0 })
+  $mb = $(if ($b.membership) { 1 } else { 0 })
+  if ($ma -ne $mb) { return ($ma - $mb) }
+  # 3. can we link it
+  $ia = $(if ($a.has_identity) { 0 } else { 1 })
+  $ib = $(if ($b.has_identity) { 0 } else { 1 })
+  if ($ia -ne $ib) { return ($ia - $ib) }
