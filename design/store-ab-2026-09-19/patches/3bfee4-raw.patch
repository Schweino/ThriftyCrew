+#     still depended on row order could only agree with the board by luck.
+$rA = Build-PriceTableRow -Id 'oats' -Commodity 'Oats' -Unit 'oz' -Today $TODAY -Rows $halfTie
+$rB = Build-PriceTableRow -Id 'oats' -Commodity 'Oats' -Unit 'oz' -Today $TODAY -Rows @($halfTie[1], $halfTie[0])
+$sA = $rA.stores['Aldi']; $sB = $rB.stores['Aldi']
+if ($sA.shown_product -eq $sB.shown_product -and $sA.shown_kind -eq $sB.shown_kind) {
+  Ok 'the shown half is the same whichever order the tied ad and everyday rows arrive in'
+} else { Bad ("the shown half still depends on row order: '" + $sA.shown_product + "'/" + $sA.shown_kind + " vs '" + $sB.shown_product + "'/" + $sB.shown_kind) }
+
+# 17. MUST FIRE - PARITY MUST BE ABLE TO SEE IT. The whole reason this defect survived is that the check
+#     meant to catch drift compared only prices, so a tie produced nothing for it to find. Identical
+#     price, different product: parity has to report it, or the repair above is unguarded from tomorrow.
+$tbl = @( (Build-PriceTableRow -Id 'x' -Commodity 'X' -Unit 'lb' -Today $TODAY -Rows @( (PtRow 'Aldi' 1.00 'everyday' 'Millville Oats') )) )
+$cmpSameProduct = [pscustomobject]@{ comparison = @([pscustomobject]@{ id = 'x'; stores = @([pscustomobject]@{ store = 'Aldi'; per_unit = 1.00; item = 'Millville Oats' }) }) }
+$cmpOtherProduct = [pscustomobject]@{ comparison = @([pscustomobject]@{ id = 'x'; stores = @([pscustomobject]@{ store = 'Aldi'; per_unit = 1.00; item = 'Some Other Brand Oats' }) }) }
+$b = @(Test-PriceTableParity -Table $tbl -Comparison $cmpOtherProduct)
+if ($b.Count -eq 1 -and $b[0].kind -eq 'product') { Ok 'parity FIRES on same price, different product - the blind spot that hid this for six weeks' }
+else { Bad ("parity cannot see a product disagreement at an identical price (got " + $b.Count + " finding(s), kind=" + (@($b | ForEach-Object { $_.kind }) -join ',') + ")") }
+
+# 18. MUST NOT FIRE - twice over, because a check that fires on agreement is worse than no check.
+#     (a) the board names the same product: silent.
+#     (b) the board cell records NO product at all: SKIPPED, never failed. A could-not-look must not
+#         settle the question in either direction, and every board built before shown_product existed is
+#         exactly that case.
+$b = @(Test-PriceTableParity -Table $tbl -Comparison $cmpSameProduct)
+if (-not $b.Count) { Ok 'parity is silent when the table and board name the same product' }
+else { Bad ("parity fired on an agreeing product: " + $b[0].why) }
+$cmpNoItem = [pscustomobject]@{ comparison = @([pscustomobject]@{ id = 'x'; stores = @([pscustomobject]@{ store = 'Aldi'; per_unit = 1.00 }) }) }
+$b = @(Test-PriceTableParity -Table $tbl -Comparison $cmpNoItem)
+if (-not $b.Count) { Ok 'a board cell that records no product is SKIPPED, not failed (a could-not-look settles nothing)' }
+else { Bad ("parity treated a missing board product as a disagreement: " + $b[0].why) }
+
 Write-Output ("PRICE-TABLE " + $(if ($fail) { "FAILED ($fail)" } else { 'PASSED' }))
 Exit-Guard -Name 'price-table' -Summary "failed=$fail" -Code $(if ($fail) { 1 } else { 0 })
