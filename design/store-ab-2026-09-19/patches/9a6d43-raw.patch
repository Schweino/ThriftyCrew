+def _retract_stale_identity_edges(db: GraphDB, ts: str, run: str,
+                                  asserted: set[tuple[str, str]],
+                                  blind: list[str]) -> dict:
+    """Delete the identity-table `instance_of` edges this run's files do not assert.
+
+    `asserted` is every (sku_id, commodity_id) pair import_identity wrote an edge
+    for in THIS run; `blind` names any namespace it could not read.
+
+    WHY DELETE AT ALL. graph/identity/<ns>/*.jsonl holds one CURRENT row per
+    (store, product), so the files are a snapshot and not a log: a pair they no
+    longer carry is the engine's PREVIOUS answer, superseded the day it re-filed
+    the product. Upserting only, this importer kept both answers forever.
+
+    A COULD-NOT-LOOK IS NEVER A RETRACTION. Every edge of an unread namespace
+    looks exactly like a stale one, so a missing directory, a directory holding
+    no .jsonl, or a namespace whose files yielded no row refuses the whole
+    retraction rather than emptying that namespace. The manifest row-count check
+    in import_identity is the third guard on the same question and raises, which
+    rolls the importer back.
+
+    NEVER ANOTHER IMPORTER'S EDGE. Only edges whose `source` property is
+    'identity-table' are candidates. That is sound because import_product_urls
+    runs BEFORE this importer in ALL_IMPORTERS: any pair it asserts this run
+    carries its own source by the time we look, unless the identity files assert
+    it too, in which case the pair is in `asserted` and kept either way.
+
+    IT DEPENDS ON A FULL READ OF EVERY IDENTITY FILE. `asserted` is this run's
+    whole answer, so anything that lets import_identity SKIP a file it read last
+    night turns that file's edges into stale ones. Nothing does today - I211's
+    incremental guard (graph/lib/supersede.py) skips observation ROWS in the price
+    importers and never touches this one - but a future skip here must either add
+    the skipped file's pairs to `asserted` or name the file in `blind`.
+
+    SCOPE OF A CLEAN REPORT: a retraction of 0 means no identity-table edge named
+    an unasserted pair, which is trustworthy for edges this importer wrote. An
+    `instance_of` edge carrying no `source` at all (none exist today; both writers
+    stamp one) is outside the candidate set and would be left in place, so this is
+    UNSOUND for a future writer that forgets the property. What it retracts is
+    real: the pair is read off the edge itself and checked against the set the run
+    just built.
+    """
+    rows = db.conn.execute(
+        "SELECT id, source_id, target_id FROM edges WHERE predicate = 'instance_of' "
+        "AND json_extract(properties_json, '$.source') = ?",
+        (IDENTITY_EDGE_SOURCE,)).fetchall()
+    stale = sorted(r["id"] for r in rows
+                   if (r["source_id"], r["target_id"]) not in asserted)
+    out = {
+        "identity_edges_examined": len(rows),
+        "identity_stale_found": len(stale),
+        "identity_stale_retracted": 0,
+        # ALWAYS present, empty when nothing was refused: a refusal that is not
+        # spoken cannot be told apart from a run with nothing to do.
+        "identity_stale_kept_reason": "",
+    }
+    if blind:
+        reason = "could not read " + "; ".join(blind)
+    elif rows and len(stale) / len(rows) > MAX_STALE_RETRACT_FRACTION:
+        reason = ("%d of %d identity-table edges (%.1f%%) would be retracted, over the "
+                  "%.0f%% bar" % (len(stale), len(rows),
+                                  100.0 * len(stale) / len(rows),
+                                  100.0 * MAX_STALE_RETRACT_FRACTION))
+    else:
+        reason = ""
+
+    # ONE logged decision, not 3,615 of them: retract_edge() logs per edge and
+    # mirrors each to the tracked provenance trail, which for a sweep this size
+    # would write more history than the change it records. The count, a hash of
+    # the full id list and the first 50 ids are what make it re-checkable.
+    detail = {"stale": len(stale), "identity_table_edges": len(rows),
+              "bar": MAX_STALE_RETRACT_FRACTION, "stale_ids_sha256": hash_obj(stale),
+              "first_ids": stale[:50], "blind": blind}
+    if reason:
+        out["identity_stale_kept_reason"] = reason
+        detail["reason"] = reason
+        db.log_event(run=run, timestamp=ts, etype="escalate", step_id="identity",
+                     decision="retract_stale_identity_refused", detail=detail)
+        return out
+    if not stale:
+        return out
+
+    db.log_event(run=run, timestamp=ts, etype="state_transition", step_id="identity",
+                 decision="retract_stale_identity_edges", detail=detail)
+    for i in range(0, len(stale), 500):
+        chunk = stale[i:i + 500]
+        db.conn.execute("DELETE FROM edges WHERE id IN (%s)" % ",".join("?" * len(chunk)),
+                        chunk)
+    out["identity_stale_retracted"] = len(stale)
+    return out
+
 
