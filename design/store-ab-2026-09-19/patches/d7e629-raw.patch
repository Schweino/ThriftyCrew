+def _bar_arm(n_stale: int, accept: bool = False) -> tuple[dict, int]:
+    """100 filings, `n_stale` of them unfiled today. Returns (counters, filings left).
+
+    100 is chosen so one row IS one percentage point: the bar is a percentage, and a case a
+    step past it has to be a step of the comparison's own resolution (Brad's ruling, I196).
+    """
+    tmp = tempfile.mkdtemp(prefix="i-bar-")
+    saved_ident, saved_env = I.IDENTITY, os.environ.get("TC_IDENTITY_ACCEPT_RETRACT")
+    db = None
+    try:
+        root = os.path.join(tmp, "identity")
+        I.IDENTITY = root
+        db = _fresh(tmp)
+        ts0 = "2026-09-18T00:00:00"
+        _seed_commodities(db, ts0)
+        canned = I.commodity_id("canned-peas", "staple")
+        names = ["Fixture Peas %03d" % i for i in range(100)]
+        _write_ns(root, "staple", [_irow(nm, canned) for nm in names])
+        I.import_identity(db, ts0, "run:bar-1")
+        _write_ns(root, "staple",
+                  [_irow(nm, None if i < n_stale else canned) for i, nm in enumerate(names)])
+        if accept:
+            os.environ["TC_IDENTITY_ACCEPT_RETRACT"] = "1"
+        else:
+            os.environ.pop("TC_IDENTITY_ACCEPT_RETRACT", None)
+        res = I.import_identity(db, "2026-09-19T00:00:00", "run:bar-2")
+        left = db.conn.execute(
+            "SELECT count(*) FROM edges WHERE predicate='instance_of'").fetchone()[0]
+        return res, left
+    finally:
+        I.IDENTITY = saved_ident
+        if saved_env is None:
+            os.environ.pop("TC_IDENTITY_ACCEPT_RETRACT", None)
+        else:
+            os.environ["TC_IDENTITY_ACCEPT_RETRACT"] = saved_env
+        if db is not None:
+            db.conn.close()
+        shutil.rmtree(tmp, ignore_errors=True)
+
