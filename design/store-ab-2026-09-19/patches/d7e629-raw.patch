+def run_identity_bar() -> None:
+    """The plausibility bar on a one-directional actuator: 20.0% of a namespace's filings.
+
+    Retraction only ever removes, so one degraded emitter run could empty the index in a pass.
+    Over the bar the namespace is REFUSED, its edges KEPT, and the refusal SPOKEN - a run that
+    declined to act must not look like a run with nothing to do. The three cases are the bar
+    itself (20 of 100 retracts), one row past it (21 of 100 refuses), and the override.
+    """
+    try:
+        at, left_at = _bar_arm(20)
+        T("CLEAN TWIN exactly AT the 20.0% bar (20 stale of 100) the retraction proceeds",
+          at.get("identity_staple_retracted") == 20 and left_at == 80
+          and "identity_staple_retract_refused_pct" not in at,
+          json.dumps(at, sort_keys=True) + " left=%d" % left_at)
+        past, left_past = _bar_arm(21)
+        T("MUST FIRE one row PAST the 20.0% bar (21 stale of 100) the namespace is refused, "
+          "all 100 filings kept, and the refusal is reported as 21.0%",
+          past.get("identity_staple_retracted") == 0 and left_past == 100
+          and past.get("identity_staple_retract_refused_pct") == 21.0,
+          json.dumps(past, sort_keys=True) + " left=%d" % left_past)
+        over, left_over = _bar_arm(21, accept=True)
+        T("CLEAN TWIN TC_IDENTITY_ACCEPT_RETRACT=1 is the deliberate override: the same 21 "
+          "are retracted",
+          over.get("identity_staple_retracted") == 21 and left_over == 79,
+          json.dumps(over, sort_keys=True) + " left=%d" % left_over)
+    except Exception as e:                                # noqa: BLE001
+        _fails.append("identity-bar suite raised: %r" % (e,))
+        print("  FAILED identity-bar suite raised: %r" % (e,))
+
