+def run_identity_narrowed() -> None:
+    """Without a manifest the read cannot vouch for itself, so the reconcile narrows.
+
+    A namespace whose _manifest.json states a row count and matches it is a proven complete
+    snapshot; one without is not, and an absent row there cannot tell "the engine dropped this
+    product" from "that store's file was not written today". The re-filing and the unfiling are
+    still the engine's own current answer about a product in front of us, so they are retracted
+    either way - only the ABSENT product's filing is kept, and it is counted rather than passed
+    over in silence.
+    """
+    # THE BAR IS LIFTED FOR THIS SUITE, DELIBERATELY. IDENTITY_MAX_RETRACT_PCT is a
+    # percentage of a namespace's filings, and a five-filing fixture is over it the
+    # moment it retracts anything - so with the bar live these cases would judge the
+    # bar and never reach the semantics. The bar has its own three cases in
+    # run_identity_bar(), at it and one row past it, which is where it is judged.
+    tmp = tempfile.mkdtemp(prefix="i-narrow-")
+    saved, saved_bar = I.IDENTITY, I.IDENTITY_MAX_RETRACT_PCT
+    I.IDENTITY_MAX_RETRACT_PCT = 100.0
+    db = None
+    try:
+        root = os.path.join(tmp, "identity")
+        I.IDENTITY = root
+        db = _fresh(tmp)
+        ts0 = "2026-09-18T00:00:00"
+        _seed_commodities(db, ts0)
+        canned = I.commodity_id("canned-peas", "staple")
+        corn = I.commodity_id("canned-corn", "staple")
+        SWEET, CORNY, GONE = ("Birds Eye Steamfresh Sweet Peas", "Fixture Sweet Corn Cut",
+                              "Fixture Discontinued Peas")
+        sku = {n: I.sku_id("Baker's", n, "10 oz") for n in (SWEET, CORNY, GONE)}
+
+        _write_ns(root, "staple", [_irow(SWEET, canned), _irow(CORNY, canned),
+                                   _irow(GONE, canned)], manifest=False)
+        I.import_identity(db, ts0, "run:narrow-1")
+        _write_ns(root, "staple", [_irow(SWEET, None), _irow(CORNY, corn)], manifest=False)
+        r2 = I.import_identity(db, "2026-09-19T00:00:00", "run:narrow-2")
+
+        T("MUST FIRE with no manifest the absent product KEEPS its filing and is counted "
+          "(1 stale kept blind), reconcile=narrowed",
+          (_filings(db, sku[GONE]) == {canned: "identity-table"}
+           and r2.get("identity_staple_stale_kept_blind") == 1
+           and r2.get("identity_staple_reconcile") == "narrowed"),
+          json.dumps(r2, sort_keys=True) + " gone=" + repr(_filings(db, sku[GONE])))
+        T("CLEAN TWIN the two products it DID read are still reconciled (2 retracted: "
+          "1 unfiled, 1 refiled)",
+          (r2.get("identity_staple_retracted") == 2
+           and r2.get("identity_staple_retracted_gone") == 0
+           and _filings(db, sku[SWEET]) == {} and _filings(db, sku[CORNY]) == {corn: "identity-table"}),
+          json.dumps(r2, sort_keys=True))
+
+        # And the same tree WITH a manifest: the absent product's filing goes. This is the
+        # pair that proves the manifest is what moved the scope, not the fixture's shape.
+        _write_ns(root, "staple", [_irow(SWEET, None), _irow(CORNY, corn)], manifest=True)
+        r3 = I.import_identity(db, "2026-09-19T06:00:00", "run:narrow-3")
+        T("CLEAN TWIN the identical files WITH a manifest reconcile in full and retract it "
+          "(1 gone, 0 kept blind)",
+          (_filings(db, sku[GONE]) == {} and r3.get("identity_staple_retracted_gone") == 1
+           and r3.get("identity_staple_stale_kept_blind") == 0
+           and r3.get("identity_staple_reconcile") == "full"), json.dumps(r3, sort_keys=True))
+
+        # A manifest that disagrees with what was read is the founding refusal, and it must
+        # still come BEFORE the reconcile: a short read never gets to delete on the strength
+        # of what it did not see.
+        _write_ns(root, "staple", [_irow(CORNY, corn)], manifest=True)
+        _write(os.path.join(root, "staple", "_manifest.json"),
+               {"namespace": "staple", "rows_total": 99})
+        edges_before = {r[0] for r in db.conn.execute(
+            "SELECT id FROM edges WHERE predicate='instance_of'")}
+        raised = ""
+        try:
+            I.import_identity(db, "2026-09-19T07:00:00", "run:narrow-4")
+        except ValueError as e:
+            raised = str(e)
+        edges_after = {r[0] for r in db.conn.execute(
+            "SELECT id FROM edges WHERE predicate='instance_of'")}
+        T("MUST NOT FIRE a manifest that disagrees with the rows read raises before any "
+          "retraction, leaving every filing standing",
+          "claims 99 rows" in raised and edges_before == edges_after,
+          repr(raised) + " moved=" + repr(sorted(edges_before ^ edges_after)))
+    except Exception as e:                                # noqa: BLE001
+        _fails.append("identity-narrowed suite raised: %r" % (e,))
+        print("  FAILED identity-narrowed suite raised: %r" % (e,))
+    finally:
+        I.IDENTITY, I.IDENTITY_MAX_RETRACT_PCT = saved, saved_bar
+        if db is not None:
+            db.conn.close()
+        shutil.rmtree(tmp, ignore_errors=True)
