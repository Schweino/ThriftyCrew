+# 13. MUST FIRE - A PRICE TIE INSIDE ONE STORE NAMES ONE PRODUCT (2026-09-19, backlog I175). Frozen from
+#     candidates-2026-09-17: Aldi frosting carries three Baker's Corner 16 oz tubs at exactly $0.1094/oz.
+#     `Sort-Object unit_price | Select-Object -First 1` is not stable under PowerShell 5.1, so the product
+#     the table named followed the order the rows happened to arrive in, and the live table named a
+#     different product than the board for 337 of 3,189 cells. Every order of the same rows, one answer.
+$frost = @(
+  (PtRow 'Aldi' 0.1094 'everyday' 'Baker S Corner Vanilla Frosting 16 OZ'),
+  (PtRow 'Aldi' 0.1094 'everyday' 'Baker S Corner Chocolate Frosting 16 OZ'),
+  (PtRow 'Aldi' 0.1094 'everyday' 'Baker S Corner Cream Cheese Frosting 16 OZ'),
+  (PtRow 'Aldi' 0.1500 'everyday' 'Some Dearer Frosting 16 OZ')
+)
+$frostOrders = @(@(0,1,2,3), @(3,2,1,0), @(1,2,0,3), @(2,0,3,1), @(1,0,3,2), @(0,2,1,3))
+$named = @($frostOrders | ForEach-Object { $ord = $_; $inRows = @($ord | ForEach-Object { $frost[$_] })
+  [string](Build-PriceTableRow -Id 'frosting' -Commodity 'Frosting' -Unit 'oz' -Today $TODAY -Rows $inRows).stores['Aldi'].everyday_product } | Select-Object -Unique)
+if ($named.Count -eq 1 -and $named[0] -eq 'Baker S Corner Chocolate Frosting 16 OZ') { Ok 'a price tie names ONE product whatever the input order' }
+else { Bad ('a price tie named a different product per input order: ' + ($named -join ' | ')) }
+
+# 14. MUST FIRE - -Pick DECIDES, because that is how compare-deals hands this library the board's own
+#     Select-StoreWinner and so how the table stops being a second implementation of "which row wins".
+#     The pick here deliberately chooses the LAST-named tied row, which the fallback order never would, so
+#     a -Pick that is ignored reads red instead of passing by agreeing with the fallback.
+$pickLast = { param($rows) $min = ($rows | Measure-Object unit_price -Minimum).Minimum
+  @($rows | Where-Object { $_.unit_price -eq $min } | Sort-Object @{Expression = { [string]$_.name }} -Descending | Select-Object -First 1) }
+$pk = (Build-PriceTableRow -Id 'frosting' -Commodity 'Frosting' -Unit 'oz' -Today $TODAY -Rows $frost -Pick $pickLast).stores['Aldi']
+if ($pk.everyday_product -eq 'Baker S Corner Vanilla Frosting 16 OZ' -and $pk.everyday -eq 0.1094) { Ok 'with -Pick the table names the product the board''s own rule chose, at the same price' }
+else { Bad ("-Pick was not honoured: got '" + $pk.everyday_product + "' at " + $pk.everyday) }
+
+# 15. MUST FIRE - AN EXACT everyday/ad TIE IS DECIDED BY THE SAME RULE, NOT BY "THE AD ALWAYS WINS".
+#     This read `if ($adR.unit_price -le $evR.unit_price) { ad }`, so a tie always showed the ad row - while
+#     the board ranks both rows through one rule and usually lands on the everyday shelf row, because the
+#     flyer line carries no link. Measured on the live 2026-09-17 pair: 20 cells tie everyday against ad,
+#     and on 12 of them the board named the everyday product while this table named the ad one.
+$evAdTie = @(
+  (PtRow 'Aldi' 0.10 'everyday' 'Zeta Everyday Frosting 16 OZ'),
+  (PtRow 'Aldi' 0.10 'sale'     'Alpha Ad Frosting 16 OZ' '2026-08-19' '2026-08-25' 'ad')
+)
+$te = (Build-PriceTableRow -Id 'frosting' -Commodity 'Frosting' -Unit 'oz' -Today $TODAY -Rows $evAdTie -Pick $pickLast).stores['Aldi']
+if ($te.shown -eq 0.10 -and $te.shown_kind -eq 'everyday' -and $te.ad -eq 0.10 -and $te.everyday -eq 0.10) { Ok 'an exact everyday/ad tie shows the row the rule picked, and both halves are still stored' }
+else { Bad ("the everyday/ad tie ignored the rule: shown=$($te.shown) kind=$($te.shown_kind) everyday=$($te.everyday) ad=$($te.ad)") }
+# CLEAN TWIN: the rule is consulted ONLY between equal prices, so a genuinely cheaper ad is still shown as
+# the ad even under a pick that prefers the everyday row. No tie-break here can show a dearer number.
+$evAdCheap = @(
+  (PtRow 'Aldi' 0.10 'everyday' 'Zeta Everyday Frosting 16 OZ'),
+  (PtRow 'Aldi' 0.09 'sale'     'Alpha Ad Frosting 16 OZ' '2026-08-19' '2026-08-25' 'ad')
+)
+$tc = (Build-PriceTableRow -Id 'frosting' -Commodity 'Frosting' -Unit 'oz' -Today $TODAY -Rows $evAdCheap -Pick $pickLast).stores['Aldi']
+if ($tc.shown -eq 0.09 -and $tc.shown_kind -eq 'ad') { Ok 'a cheaper ad is still shown as the ad - price outranks the tie-break' }
+else { Bad ("the tie-break outranked price: shown=$($tc.shown) kind=$($tc.shown_kind)") }
+# CLEAN TWIN: with NO pick - the shape every caller of this library but compare-deals has - the same tie
+# still resolves the same way every run, by the fallback's total order rather than by the sort's internals.
+$tf1 = (Build-PriceTableRow -Id 'frosting' -Commodity 'Frosting' -Unit 'oz' -Today $TODAY -Rows $evAdTie).stores['Aldi']
+$tf2 = (Build-PriceTableRow -Id 'frosting' -Commodity 'Frosting' -Unit 'oz' -Today $TODAY -Rows @($evAdTie[1], $evAdTie[0])).stores['Aldi']
+if ($tf1.shown_kind -eq $tf2.shown_kind -and $tf1.shown_kind -eq 'ad' -and $tf1.shown -eq 0.10) { Ok 'without -Pick the same tie still resolves to ONE answer in either input order' }
+else { Bad ("the no-pick tie is order-dependent: '$($tf1.shown_kind)' vs '$($tf2.shown_kind)'") }
+
 Write-Output ("PRICE-TABLE " + $(if ($fail) { "FAILED ($fail)" } else { 'PASSED' }))
