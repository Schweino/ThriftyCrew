--- /dev/null
+++ b/graph/import/import_all_selftest.py
@@ -0,0 +1,339 @@
+"""import_all_selftest.py - a failed importer leaves NOTHING and exits 1 (2026-09-19).
+
+    python graph/import/import_all_selftest.py --selftest
+
+THE DEFECT IT GUARDS. An importer that raised partway through left its partial writes in graph.db
+and the nightly import still exited 0, so a half-loaded data set - a known-wrong set, an override
+set - became the day's index with nothing flagging it. sqlite3's legacy mode opens an implicit
+transaction on the first INSERT; import_all caught the exception, logged it and carried on, and the
+NEXT importer's `db.conn.commit()` landed the dead importer's rows. Measured on a temp database
+before the fix: an importer that wrote 3 nodes and then raised left 3 nodes COMMITTED, and the run
+returned 0. Two further roads wrote the same partial state: `GraphDB.__exit__` said it would not
+commit on an exception and then called `close()`, which committed unconditionally; and a unit that
+commits mid-flight destroys its own savepoint, which SQLite reports rather than hiding.
+
+WHICH FAILURE THIS CHOOSES. A leak, never corruption (.claude/rules/ops-and-gates.md): the index is
+missing the data set entirely rather than holding part of it, because a 40-of-80 ruling set reads
+exactly like a whole one and an absent one does not.
+
+WHY IT DRIVES THE REAL main() AND THE REAL import_known_wrong. The loop cases replace ALL_IMPORTERS
+with fixture importers and then call `import_all.main()` itself, not a re-implementation of it, so a
+rollback removed from GraphDB.atomic() or an `exit 0` restored to main() goes red here. One case
+drives the REAL importer as well, because a fixture cannot cover `retro_apply_known_wrong`'s inner
+commit and that is production code.
+
+MUTATION PROBE, 2026-09-19, 8 single compiling mutants from a temp mirror of graph/, one at a time,
+originals verified md5-identical afterwards and the mirror removed: 8 of 8 KILLED, each in its own
+named case. The one that first SURVIVED is why case 4b exists - restoring `db.conn.commit()` in
+`importers.retro_apply_known_wrong` left every case green, because no fixture importer reaches that
+line. Control: 15 of 15 pass, exit 0.
+
+HERMETIC. graphdb.DB_PATH is pointed at a fresh file in a per-run temp directory and restored in a
+finally; every database in this file is that temp file. GraphDB._append_jsonl (the tracked
+graph/provenance trail) is replaced for the whole suite, and ALL_IMPORTERS / LANE_IMPORTERS are
+replaced, so no case reads grocery/*.json, touches graph/sqlite/graph.db, or writes a tracked file.
+`--observations` is never passed, so phase C never runs and no capture file is read.
+
+EXIT: 0 all cases pass, 1 at least one failed. Read the verdict LINE, not the number.
+"""
+from __future__ import annotations
+
+import io
+import json
+import os
+import shutil
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.normpath(os.path.join(HERE, "..", ".."))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(REPO, "graph", "lib"))
+
+import graphdb                                           # noqa: E402
+import import_all                                        # noqa: E402
+import importers                                         # noqa: E402
+
+_fails: list[str] = []
+_ran = 0
+CASES = 15
+
+TS = "2026-09-19T00:00:00"
+
+
+def T(label: str, ok: bool, got: str = "") -> None:
+    global _ran
+    _ran += 1
+    if ok:
+        print("  ok    " + label)
+    else:
+        _fails.append(label)
+        print("  FAILED " + label + ("   got: " + got if got else ""))
+
+
+# --- fixture importers -------------------------------------------------------------------------
+# Shaped like the real ones: an Override/KnownWrong node per entry, written one at a time. The
+# founding bug is a raise BETWEEN entries, which is where a real importer dies (a malformed entry,
+# a missing key, a file truncated mid-read).
+
+def _write_rulings(db, prefix: str, n: int, ntype: str = "KnownWrong") -> None:
+    for i in range(n):
+        db.upsert_node(f"{prefix}:{i}", ntype, f"{prefix} ruling {i}", TS)
+
+
+def half_known_wrong(db, ts, run):
+    """Writes 3 of 6 rulings, then dies. THE FOUNDING SHAPE."""
+    _write_rulings(db, "kw", 3)
+    raise ValueError("malformed entry 4 of 6")
+
+
+def whole_overrides(db, ts, run):
+    _write_rulings(db, "ov", 4, "Override")
+    return {"overrides": 4}
+
+
+def committing_known_wrong(db, ts, run):
+    """Reaches past GraphDB.commit() to the raw connection, then dies - the un-rollback-able unit."""
+    _write_rulings(db, "kwc", 3)
+    db.conn.commit()
+    raise ValueError("died after committing mid-flight")
+
+
+def polite_known_wrong(db, ts, run):
+    """The same shape written correctly: db.commit() is a no-op inside a unit."""
+    _write_rulings(db, "kwp", 3)
+    db.commit()
+    return {"known_wrong": 3}
+
+
+def _real_known_wrong_fixture(db, tmp: str) -> str:
+    """Set up the REAL import_known_wrong so its inner sweep demotes a row.
+
+    That sweep is the one production commit that runs both inside a unit and standalone, and a
+    mutation probe found it undefended: with `db.conn.commit()` restored there, every case in this
+    file stayed green because no fixture importer reaches it. This builds the real thing instead -
+    a ruling, a commodity, and an already-include_hit observation the ruling demotes - so the
+    commit really is executed inside the unit.
+    """
+    gro = os.path.join(tmp, "grocery-kw")
+    os.makedirs(gro, exist_ok=True)
+    with io.open(os.path.join(gro, "known-wrong.json"), "w", encoding="utf-8",
+                 newline="\n") as fh:
+        fh.write(json.dumps({"entries": [{
+            "commodity": "fixture-juice", "store": "Fareway",
+            "names": ["FOCO Coconut Juice"], "verdict": "wrong-product",
+            "evidence": "fixture ruling"}]}))
+    cid = importers.commodity_id("fixture-juice", "staple")
+    sid = importers.store_id("Fareway")
+    db.upsert_node(cid, "Commodity", "Fixture Juice", TS)
+    db.upsert_node(sid, "Store", "Fareway", TS)
+    prov = db.record_provenance("fixture", "fixture", TS)
+    db.add_observation({"id": "obs:fixture:1", "commodity_id": cid, "store_id": sid,
+                        "provenance_id": prov, "observed_at": TS,
+                        "product_name": "FOCO Coconut Juice", "price": 4.99,
+                        "match_status": "include_hit"})
+    db.commit()
+    return gro
+
+
+def _count(path: str, ntype: str) -> int:
+    db = graphdb.GraphDB(path, restore_learning=False)
+    try:
+        return db.conn.execute("SELECT COUNT(*) FROM nodes WHERE type=?", (ntype,)).fetchone()[0]
+    finally:
+        db.conn.close()
+
+
+def _decisions(path: str) -> list[str]:
+    db = graphdb.GraphDB(path, restore_learning=False)
+    try:
+        return [r[0] for r in db.conn.execute(
+            "SELECT decision FROM decision_log WHERE decision IS NOT NULL").fetchall()]
+    finally:
+        db.conn.close()
+
+
+_last_out = ""
+
+
+def _run_main(dbpath: str, all_importers, loud: bool = False) -> int:
+    """Drive the REAL main() over a fresh temp database and a fixture importer list.
+
+    `loud=True` drops --quiet and captures what an operator would read, so the cases can assert
+    the words as well as the rows. Its stdout is captured, never printed, or the fixture's own
+    lines would land among this suite's case lines and confuse lib\\selftest-verdict.ps1.
+    """
+    global _last_out
+    if os.path.exists(dbpath):
+        os.remove(dbpath)
+    graphdb.DB_PATH = dbpath
+    saved = importers.ALL_IMPORTERS
+    importers.ALL_IMPORTERS = all_importers
+    argv, stdout = sys.argv, sys.stdout
+    sys.argv = ["import_all.py"] + ([] if loud else ["--quiet"])
+    buf = io.StringIO()
+    sys.stdout = buf
+    try:
+        return import_all.main()
+    finally:
+        sys.stdout = stdout
+        _last_out = buf.getvalue()
+        sys.argv = argv
+        importers.ALL_IMPORTERS = saved
+
+
+def run() -> int:
+    tmp = tempfile.mkdtemp(prefix="import-all-st-")
+    saved_path = graphdb.DB_PATH
+    saved_append = graphdb.GraphDB._append_jsonl
+    saved_lanes = importers.LANE_IMPORTERS
+    graphdb.GraphDB._append_jsonl = staticmethod(lambda run, record: None)
+    importers.LANE_IMPORTERS = []
+    try:
+        # ---- 1. the founding bug: a half-written data set ----------------------------------
+        dbp = os.path.join(tmp, "half.db")
+        rc = _run_main(dbp, [("known_wrong", half_known_wrong),
+                             ("overrides", whole_overrides)])
+        kw, ov = _count(dbp, "KnownWrong"), _count(dbp, "Override")
+        T("MUST FIRE  an importer that raises after 3 of 6 rulings leaves ZERO of them in the "
+          "index, never 3 - a missing set, not a half-loaded one that reads as whole",
+          kw == 0, "KnownWrong rows=%d" % kw)
+        T("MUST FIRE  the run EXITS 1, so the nightly chain sees a day whose index is not whole",
+          rc == 1, "rc=%r" % rc)
+        T("MUST FIRE  the index's own record says import_incomplete, never import_complete",
+          "import_incomplete" in _decisions(dbp) and "import_complete" not in _decisions(dbp),
+          ",".join(sorted(set(_decisions(dbp)))))
+        T("MUST NOT FIRE  the failure is named in the decision log as an escalate",
+          "importer_failed" in _decisions(dbp), ",".join(sorted(set(_decisions(dbp)))))
+        T("CLEAN TWIN  the importer AFTER the failure still lands whole - one bad data set does "
+          "not cost the rest of the index", ov == 4, "Override rows=%d" % ov)
+
+        # ---- 2. the clean run is untouched -------------------------------------------------
+        dbp = os.path.join(tmp, "whole.db")
+        rc = _run_main(dbp, [("known_wrong", polite_known_wrong),
+                             ("overrides", whole_overrides)])
+        T("CLEAN TWIN  a run where every importer lands still exits 0 and commits everything",
+          rc == 0 and _count(dbp, "KnownWrong") == 3 and _count(dbp, "Override") == 4,
+          "rc=%r kw=%d ov=%d" % (rc, _count(dbp, "KnownWrong"), _count(dbp, "Override")))
+        T("CLEAN TWIN  and its record says import_complete",
+          "import_complete" in _decisions(dbp), ",".join(sorted(set(_decisions(dbp)))))
+
+        # ---- 3. a unit that commits mid-flight is LOUD, never a silent non-rollback ---------
+        dbp = os.path.join(tmp, "commits.db")
+        rc = _run_main(dbp, [("known_wrong", committing_known_wrong),
+                             ("overrides", whole_overrides)], loud=True)
+        d = _decisions(dbp)
+        T("MUST FIRE  a unit that committed mid-flight is reported as NOT ROLLED BACK, never as a "
+          "clean rollback - its rows really are in the index (3)",
+          rc == 1 and "importer_failed_unrolled" in d and _count(dbp, "KnownWrong") == 3,
+          "rc=%r decisions=%s kw=%d" % (rc, ",".join(sorted(set(d))), _count(dbp, "KnownWrong")))
+        T("MUST FIRE  the summary an operator reads says its PARTIAL writes are in the index and "
+          "does NOT fold it into the rolled-back count",
+          "NOT ROLLED BACK (1 of 1)" in _last_out and "PARTIAL writes are in the index" in _last_out
+          and "rolled back (" not in _last_out,
+          _last_out[-200:].replace("\n", " | "))
+
+        # ---- 3b. and the rolled-back failure says exactly the opposite ---------------------
+        dbp = os.path.join(tmp, "loud.db")
+        _run_main(dbp, [("known_wrong", half_known_wrong), ("overrides", whole_overrides)],
+                  loud=True)
+        T("CLEAN TWIN  a genuinely rolled-back failure is reported as MISSING its data, with its "
+          "denominator (1 of 2), and claims no partial writes",
+          "IMPORT INCOMPLETE: 1 of 2 importer(s) failed" in _last_out
+          and "rolled back (1 of 1)" in _last_out and "MISSING their data entirely" in _last_out
+          and "NOT ROLLED BACK" not in _last_out, _last_out[-260:].replace("\n", " | "))
+
+        # ---- 4. GraphDB.__exit__ discards an open transaction ------------------------------
+        # The second road to the same partial state, one level out from atomic(): close() used to
+        # commit unconditionally, so `if exc[0] is None` above it decided nothing.
+        dbp = os.path.join(tmp, "crash.db")
+        try:
+            with graphdb.GraphDB(dbp, restore_learning=False, allow_new=True) as db:
+                _write_rulings(db, "crash", 5)
+                raise ValueError("the caller died holding an open transaction")
+        except ValueError:
+            pass
+        T("MUST FIRE  leaving a `with GraphDB(...)` block on an exception DISCARDS the open "
+          "transaction instead of committing it", _count(dbp, "KnownWrong") == 0,
+          "KnownWrong rows=%d" % _count(dbp, "KnownWrong"))
+        with graphdb.GraphDB(dbp, restore_learning=False) as db:
+            _write_rulings(db, "clean", 5)
+        T("CLEAN TWIN  leaving the same block NORMALLY still commits every row",
+          _count(dbp, "KnownWrong") == 5, "KnownWrong rows=%d" % _count(dbp, "KnownWrong"))
+
+        # ---- 4b. the REAL importer, whose sweep commits inside the unit ---------------------
+        db = graphdb.GraphDB(os.path.join(tmp, "real-kw.db"), restore_learning=False,
+                             allow_new=True)
+        saved_gro = importers.GROCERY
+        try:
+            importers.GROCERY = _real_known_wrong_fixture(db, tmp)
+            res = None
+            try:
+                with db.atomic("known_wrong"):
+                    res = importers.import_known_wrong(db, TS, "run:st")
+                    raise ValueError("the importer's LAST entry is malformed")
+            except graphdb.GraphDBUnitNotAtomic as e:
+                res = "UNIT NOT ATOMIC: %s" % e
+            except ValueError:
+                pass
+            n_kw = db.conn.execute(
+                "SELECT COUNT(*) FROM nodes WHERE type='KnownWrong'").fetchone()[0]
+            status = db.conn.execute(
+                "SELECT match_status FROM price_observations WHERE id='obs:fixture:1'"
+            ).fetchone()[0]
+            T("MUST FIRE  the REAL import_known_wrong rolls back WHOLE even though its retro sweep "
+              "commits inside the unit - db.commit() is a no-op there, db.conn.commit() would not be",
+              n_kw == 0 and status == "include_hit",
+              "KnownWrong=%d obs.match_status=%r res=%r" % (n_kw, status, res))
+        finally:
+            importers.GROCERY = saved_gro
+            db.conn.close()
+
+        # ---- 5. units do not nest ----------------------------------------------------------
+        db = graphdb.GraphDB(os.path.join(tmp, "nest.db"), restore_learning=False, allow_new=True)
+        try:
+            nested = "no refusal"
+            try:
+                with db.atomic("outer"):
+                    with db.atomic("inner"):
+                        pass
+            except RuntimeError as e:
+                nested = str(e)
+            T("MUST NOT FIRE  nesting two units is REFUSED rather than silently rolling back to "
+              "the wrong place", "do not nest" in nested, nested[:70])
+        finally:
+            db.conn.close()
+
+        # ---- 6. nothing tracked was touched ------------------------------------------------
+        live = os.path.join(REPO, "graph", "sqlite", "graph.db")
+        T("CLEAN TWIN  the suite is hermetic: every case ran on a temp database, and the live "
+          "graph/sqlite/graph.db was never opened by it",
+          graphdb.DB_PATH.startswith(tmp) and os.path.abspath(dbp).startswith(tmp),
+          "DB_PATH=%s live_exists=%s" % (graphdb.DB_PATH, os.path.exists(live)))
+    except Exception as e:                                # noqa: BLE001
+        _fails.append("suite raised: %r" % (e,))
+        print("  FAILED suite raised: %r" % (e,))
+    finally:
+        graphdb.DB_PATH = saved_path
+        graphdb.GraphDB._append_jsonl = saved_append
+        importers.LANE_IMPORTERS = saved_lanes
+        shutil.rmtree(tmp, ignore_errors=True)
+
+    if _ran != CASES and not _fails:
+        # A LITERAL CASE LIST KNOWS ITS OWN NUMBER, so a shortfall is a defect and not a smaller
+        # tree (.claude/rules/ops-and-gates.md).
+        _fails.append("ran %d of %d cases" % (_ran, CASES))
