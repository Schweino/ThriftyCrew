+    # file is not a captured slice, and the three advances that proved it - Sam's and Fareway on
+    # 2026-08-22, Walmart on 2026-08-30 - each stepped over seven terms nothing had asked for.
+    $slice = @(Get-CursorSlice -All $all -From $from -Count $plan.RotationTerms)
+    $cov = Get-SliceCoverage -Store $Store -Today $todayS -OutDir $OutDir -Slice $slice -AskedTerms $AskedTerms
+    $step = $plan.RotationTerms
+    $covWhy = "covered $(@($cov.Covered).Count) of $($slice.Count) slice term(s) [$($cov.Evidence)]"
+    if ($Force) {
+      $covWhy = "-Force: the slice was not checked ($covWhy)"
+    } elseif ($cov.Blind) {
+      # A COULD-NOT-LOOK IS NOT A FAILURE, and it is not a pass either - it is the old behaviour, said
+      # out loud. The lane that needs this branch is the one that commits before writing (Baker's);
+      # give it -AskedTerms and it stops needing it.
