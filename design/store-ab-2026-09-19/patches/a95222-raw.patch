   if (-not $OutDir) { $OutDir = Join-Path $script:PolicyRoot 'out' }
@@ -1387,11 +1646,43 @@ function Step-CaptureCursor {
     if ($all.Count -le 0) {
       return [pscustomobject]@{ Store = $Store; Advanced = $false; From = $from; To = $from; Reason = 'no terms' }
