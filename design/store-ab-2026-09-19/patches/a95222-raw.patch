+      deals = @(New-CovRow $covSlice[0] '2026-08-28') } | ConvertTo-Json -Depth 5))
+  $covRec = Get-SliceCoverage -Store "Sam's Club" -Today '2026-08-28' -OutDir $covOut -Slice $covSlice
+  if ($covRec.Evidence -eq 'receipts' -and $covRec.LastCovered -eq 1 -and (@($covRec.Covered) -contains $covSlice[1]) -and (@($covRec.Missing) -contains $covSlice[2])) {
+    Ok "CLEAN TWIN receipts win: '$($covSlice[1])' answered EMPTY counts as covered, '$($covSlice[2])' BLOCKED does not"
+  } else { Bad "receipts read wrong: evidence=$($covRec.Evidence) last=$($covRec.LastCovered) covered=[$(@($covRec.Covered) -join ', ')]" }
+
+  # MUST FIRE: a term inside a receipt must not be matched loosely. 'apples' and 'apple juice' are
+  # different terms and different commodities; a substring match would have covered the slice here.
+  [IO.File]::WriteAllText((Join-Path $covOut ("sams\sams-deals-2026-08-29.json")), (@{
+      capture_terms = @(@{ term = ($covSlice[0] + ' juice'); outcome = 'success'; row_count = 4 })
+      deals = @() } | ConvertTo-Json -Depth 5))
+  $covNear = Get-SliceCoverage -Store "Sam's Club" -Today '2026-08-29' -OutDir $covOut -Slice $covSlice
+  if (@($covNear.Covered).Count -eq 0) { Ok "MUST FIRE  '$($covSlice[0]) juice' does not cover '$($covSlice[0])' - a near term is a different term" }
+  else { Bad "a near term was counted as coverage: [$(@($covNear.Covered) -join ', ')]" }
+
 } finally { Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue }
 
 Write-Output ("CAPTURE-POLICY " + $(if ($fail) { "FAILED ($fail)" } else { 'PASSED' }))
