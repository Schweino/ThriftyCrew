+function Get-CaptureEvidencePath {
+  <#
+    .SYNOPSIS The file(s) a store's capture for -Today lands in: its everyday file, its deals file, or both.
+    .DESCRIPTION Reads stores.json's own regular_prefix and deals_glob, so the mapping is not duplicated.
+                 Returns the paths whether or not they exist - the caller says what an absent one means.
+  #>
+  [CmdletBinding()]
+  param([Parameter(Mandatory)][string]$Store, [string]$Today = '', [string]$OutDir = '')
+  if (-not $OutDir) { $OutDir = Join-Path $script:PolicyRoot 'out' }
+  $todayS = if ($Today) { $Today } else { (Get-Date).ToString('yyyy-MM-dd') }
+  $paths = New-Object System.Collections.Generic.List[string]
+  $prefix = $null; $dealsGlob = $null
+  try {
+    $sj = Get-PolicyJson 'stores.json'
+    foreach ($s in $sj.stores) {
+      if ([string]$s.name -eq $Store) { $prefix = [string]$s.regular_prefix; $dealsGlob = [string]$s.deals_glob; break }
+    }
+  } catch { }
+  if ($prefix) { [void]$paths.Add((Join-Path $OutDir ("regular\{0}-regular-{1}.json" -f $prefix, $todayS))) }
+  if ($dealsGlob) {
+    $rel = ($dealsGlob -replace '^out[\\/]', '') -replace '/', '\'
+    [void]$paths.Add((Join-Path $OutDir ($rel -replace '\*', $todayS)))
+  }
+  return $paths.ToArray()
+}
+
+function Read-CaptureTermReceipts {
+  <#
+    .SYNOPSIS The capture_terms array of a capture file's TEXT, or $null when it carries none.
+    .DESCRIPTION Cuts the array out by matching its brackets and parses that alone, because the files
+                 that carry receipts are the big ones (Baker's is ~8 MB) and the cursor is committed
+                 inside a lock. Quotes and escapes are tracked so a bracket inside a term cannot end
+                 the array early. $null means NO capture_terms property - which is a different answer
+                 from an empty array, and the caller treats them differently.
+  #>
+  [CmdletBinding()]
+  param([Parameter(Mandatory)][AllowEmptyString()][string]$Text)
+  $a = $Text.IndexOf('"capture_terms"')
+  if ($a -lt 0) { return $null }
+  $open = $Text.IndexOf('[', $a)
+  if ($open -lt 0) { return $null }
+  $depth = 0; $inStr = $false; $esc = $false; $end = -1
+  for ($i = $open; $i -lt $Text.Length; $i++) {
+    $c = $Text[$i]
+    if ($esc) { $esc = $false; continue }
+    if ($inStr) {
+      if ($c -eq '\') { $esc = $true }
+      elseif ($c -eq '"') { $inStr = $false }
+      continue
+    }
+    if ($c -eq '"') { $inStr = $true; continue }
+    if ($c -eq '[') { $depth++ ; continue }
+    if ($c -eq ']') { $depth-- ; if ($depth -le 0) { $end = $i; break } }
+  }
+  if ($end -lt 0) { return $null }
+  $frag = $Text.Substring($open, $end - $open + 1)
+  $parsed = $null
+  try { $parsed = ConvertFrom-Json $frag } catch { return $null }
+  # assign, THEN wrap - a one-element JSON array comes back unwrapped ([[ps-json-array-collapse]])
+  return @($parsed)
+}
+
+function Get-CursorSlice {
+  <#
+    .SYNOPSIS The -Count terms a cursor at -From is sitting on, in rotation order.
+    .DESCRIPTION The one place that turns (cursor, rotation size) into terms, so the advance decision
+                 and its fixtures cannot describe two different slices.
+  #>
+  [CmdletBinding()]
+  param([Parameter(Mandatory)][AllowEmptyCollection()]$All, [int]$From = 0, [int]$Count = 0)
+  $items = @($All)
+  $out = New-Object System.Collections.Generic.List[string]
+  if ($items.Count -le 0 -or $Count -le 0) { return $out.ToArray() }
+  $start = (($From % $items.Count) + $items.Count) % $items.Count
+  for ($k = 0; $k -lt $Count; $k++) { [void]$out.Add([string]$items[(($start + $k) % $items.Count)].term) }
+  return $out.ToArray()
+}
+
+function Get-SliceCoverage {
+  <#
+    .SYNOPSIS Which terms of -Slice this store's capture for -Today actually covered, and on what evidence.
+    .DESCRIPTION Pure read. See the block above for the evidence tiers and why the weakest one under-counts.
+    .PARAMETER AskedTerms  what the lane put to the store this run, when the lane knows (strongest tier).
+    .OUTPUTS @{ Store; Today; Slice; Covered; Missing; Flags; LastCovered; Evidence; Blind; File; Why }
+  #>
+  [CmdletBinding()]
+  param(
+    [Parameter(Mandatory)][string]$Store,
+    [Parameter(Mandatory)][AllowEmptyCollection()][string[]]$Slice,
+    [string]$Today = '',
+    [string]$OutDir = '',
+    [AllowEmptyCollection()][string[]]$AskedTerms = @()
+  )
+  if (-not $OutDir) { $OutDir = Join-Path $script:PolicyRoot 'out' }
+  $todayS = if ($Today) { $Today } else { (Get-Date).ToString('yyyy-MM-dd') }
+  # A LOCAL WITH ITS OWN NAME. PowerShell names are case-insensitive, so a local $slice IS the [string[]]
+  # parameter $Slice, and writing through it is the typed-parameter shadow audit-typed-param-shadow ratchets.
+  $want = @($Slice)
+  $res = [pscustomobject]@{
+    Store = $Store; Today = $todayS; Slice = $want; Covered = @(); Missing = $want
+    Flags = @(); LastCovered = -1; Evidence = 'none'; Blind = $true; File = ''; Why = ''
+  }
+  # Case-insensitively, because a term's spelling reaches a row through the store's own echo.
+  $covered = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
+
+  $asked = @(@($AskedTerms) | Where-Object { $_ })
+  if ($asked.Count -gt 0) {
+    foreach ($t in $asked) { [void]$covered.Add(([string]$t).Trim()) }
+    $res.Evidence = 'asked'; $res.Blind = $false
+    $res.Why = "the lane reported $($asked.Count) term(s) asked this run"
+  } else {
+    $paths = @(Get-CaptureEvidencePath -Store $Store -Today $todayS -OutDir $OutDir)
+    $present = @($paths | Where-Object { Test-Path -LiteralPath $_ })
+    if ($present.Count -eq 0) {
+      $res.Why = if ($paths.Count -eq 0) { "stores.json declares no capture file for $Store, so its slice cannot be checked" }
+                 else { "no capture file for $todayS to read (" + (($paths | ForEach-Object { Split-Path $_ -Leaf }) -join ', ') + ')' }
+      return $res
+    }
+    $res.File = ($present | ForEach-Object { Split-Path $_ -Leaf }) -join ', '
+    $sawTerm = $false; $sawAsOf = $false
+    $fresh = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
+    $any = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
+    $receiptSeen = $false; $receiptAsked = 0; $receiptTotal = 0
+    foreach ($p in $present) {
+      $txt = ''
+      try { $txt = [IO.File]::ReadAllText($p) } catch { continue }
+      $rec = Read-CaptureTermReceipts -Text $txt
+      if ($null -ne $rec) {
+        $receiptSeen = $true
+        foreach ($ct in @($rec)) {
+          if ($null -eq $ct) { continue }
+          $receiptTotal++
+          if ($script:SliceAskedOutcomes -contains [string]$ct.outcome) {
+            $receiptAsked++
+            $tt = ([string]$ct.term).Trim(); if ($tt) { [void]$covered.Add($tt) }
+          }
+        }
+        continue      # receipts beat rows for this file: they can say ASKED AND EMPTY, rows cannot
+      }
+      $doc = $null
+      try { $doc = ConvertFrom-Json $txt } catch { continue }
+      $rows = if ($doc.PSObject.Properties['deals']) { @($doc.deals) } else { @($doc) }
+      foreach ($r in @($rows)) {
+        if ($null -eq $r -or -not ($r -is [psobject])) { continue }
+        $tp = $r.PSObject.Properties['found_by_term']
+        if (-not $tp) { continue }
+        $tt = ([string]$tp.Value).Trim()
+        if (-not $tt) { continue }
+        $sawTerm = $true
+        [void]$any.Add($tt)
+        $ap = $r.PSObject.Properties['as_of']
+        $av = if ($ap) { ([string]$ap.Value).Trim() } else { '' }
+        if ($av) { $sawAsOf = $true }
+        if ($av -and [string]::Equals($av, $todayS, [StringComparison]::Ordinal)) { [void]$fresh.Add($tt) }
+      }
+    }
+    if ($receiptSeen) {
+      $res.Evidence = 'receipts'; $res.Blind = $false
+      $res.Why = "capture_terms says $receiptAsked of $receiptTotal term(s) were asked and answered"
+    } elseif ($sawTerm) {
+      $res.Evidence = 'rows'; $res.Blind = $false
+      # A file whose rows carry as_of is judged on TODAY'S rows only: a carry file holds rows from every
+      # earlier day of the quarter, and those say nothing about what was captured today.
+      $src = if ($sawAsOf) { $fresh } else { $any }
+      foreach ($t in $src) { [void]$covered.Add($t) }
+      $res.Why = if ($sawAsOf) { "$($fresh.Count) term(s) have a row dated $todayS ($($any.Count) term(s) in the file altogether)" }
+                 else { "$($any.Count) term(s) named in the file, which dates no row, so every one is read as today's" }
+    } else {
+      $res.Why = "the capture ($($res.File)) carries no capture_terms and no found_by_term, so which terms it covered cannot be read"
+      return $res
+    }
+  }
+
+  $flags = New-Object System.Collections.Generic.List[bool]
+  $hit = New-Object System.Collections.Generic.List[string]
+  $miss = New-Object System.Collections.Generic.List[string]
+  $last = -1
+  for ($i = 0; $i -lt $want.Count; $i++) {
+    $t = ([string]$want[$i]).Trim()
+    $isHit = ($t -and $covered.Contains($t))
+    [void]$flags.Add([bool]$isHit)
+    if ($isHit) { [void]$hit.Add($t); $last = $i } else { [void]$miss.Add($t) }
+  }
+  $res.Flags = $flags.ToArray()
+  $res.Covered = $hit.ToArray()
+  $res.Missing = $miss.ToArray()
+  $res.LastCovered = $last
+  return $res
+}
