+    # UPPER bound, so a line stamped in the future sails through it and would excuse the lag for as long as the
+    # stamp stays ahead of the clock - the date-laundering direction the CONTENT-CURRENCY block already refuses.
+    $r.why = ("the newest held run in the chain log is stamped {0}, which is AFTER this check's own clock, so it cannot be evidence about anything" -f $r.newest.ToString('yyyy-MM-ddTHH:mm:ss'))
+    return $r
+  }
+  if ($r.ageH -gt $MaxAgeHours) {
+    $r.why = ("all {0} run(s) since {1} were HELD, but the newest was {2}, {3}h ago and past the row's own {4}h, so the hold is not CURRENT and cannot excuse anything - the chain itself may have stopped" -f $r.runs, $SinceDate, $r.newest.ToString('yyyy-MM-ddTHH:mm:ss'), $r.ageH, $MaxAgeHours)
+    return $r
+  }
+  # THE CLAIM IS MADE POSITIVELY, not by having survived the branches above (mutation probe, 2026-09-19). With
+  # the runs-eq-0 branch removed, every count was zero and this branch claimed a hold over NOTHING - and threw on
+  # $r.newest rather than saying so, which is a case killed by an accident instead of by its own assertion.
+  if ($r.held_runs -lt 1 -or $null -eq $r.newest) {
+    $r.why = ("nothing in the chain log since {0} can be read as a held run, so no hold is proven" -f $SinceDate)
+    return $r
+  }
