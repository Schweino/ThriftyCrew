+  return $r
+}
+function Get-ChainHoldVerdict {
+  # THE LIVE HALF, kept thin: read the chain's own log and judge it. Only the ship-path lines are kept, so the
+  # cost does not grow with the log (2.3 MB and 18.9k lines on 2026-09-19). The LOCKED-<date> sidecars a
+  # lock-diverted run writes are read too: the next run that can write the primary folds them back in, and
+  # until it does they are the only record of that run (check-ad-cycles.ps1's SIDECAR-RECOVERY block).
+  param([string]$RepoRoot, [string]$SinceDate, [double]$MaxAgeHours, [datetime]$Now)
+  $primary = Join-Path (Join-Path $RepoRoot 'grocery') 'ad-cycle-log.txt'
+  $files = New-Object System.Collections.Generic.List[string]
+  if (Test-Path -LiteralPath $primary) { $files.Add($primary) }
+  $sides = @(Get-ChildItem (Join-Path (Join-Path $RepoRoot 'grocery') 'ad-cycle-log.LOCKED-*.txt') -ErrorAction SilentlyContinue | Sort-Object Name)
+  foreach ($s in $sides) { $files.Add($s.FullName) }
+  $keep = New-Object System.Collections.Generic.List[string]
+  foreach ($p in $files.ToArray()) {
+    # Shared ReadWrite, because a run may be appending to this very file while the heartbeat reads it.
+    try {
+      $fs = [IO.File]::Open($p, 'Open', 'Read', 'ReadWrite')
+      try {
+        $sr = New-Object IO.StreamReader($fs, $true)
+        while ($null -ne ($ln = $sr.ReadLine())) { if ($ln.Contains('SHIP PATH COMPLETE')) { $keep.Add($ln) } }
+      } finally { $fs.Dispose() }
+    } catch { }
+  }
+  $v = Test-WriterHeldByChain -Text (($keep.ToArray()) -join "`n") -SinceDate $SinceDate -MaxAgeHours $MaxAgeHours -Now $Now
+  if ($files.Count -eq 0) { $v.held = $false; $v.why = ("no chain log exists at {0}, so nothing can explain the lag" -f $primary) }
+  return $v
+}
