+    $visStart = $script:cases
+    try {
+      $pubProbe  = Test-RemoteIsPrivate -Url ("http://localhost:$($visFx.Port)/pub.git")  -TimeoutSec 10
+      $privProbe = Test-RemoteIsPrivate -Url ("http://localhost:$($visFx.Port)/priv.git") -TimeoutSec 10
+      $forbProbe = Test-RemoteIsPrivate -Url ("http://localhost:$($visFx.Port)/forb.git") -TimeoutSec 10
+      $goneProbe = Test-RemoteIsPrivate -Url ("http://localhost:$($visFx.Port)/gone.git") -TimeoutSec 10
+      $oddProbe  = Test-RemoteIsPrivate -Url ("http://localhost:$($visFx.Port)/odd.git")  -TimeoutSec 10
+
+      T 'MUST-FIRE  a host that serves the repository anonymously (HTTP 200) is read as PUBLIC - the control, without which a 401 proves nothing' `
+        ($pubProbe.State -eq 'public') ("got " + $pubProbe.State + ': ' + $pubProbe.Detail)
+      T 'CLEAN TWIN a 401 is read as PRIVATE' `
+        ($privProbe.State -eq 'private') ("got " + $privProbe.State + ': ' + $privProbe.Detail)
+      T 'CLEAN TWIN a 403 is read as PRIVATE' `
+        ($forbProbe.State -eq 'private') ("got " + $forbProbe.State + ': ' + $forbProbe.Detail)
+      T 'CLEAN TWIN a 404 is read as PRIVATE (GitHub hides a private repository behind one)' `
+        ($goneProbe.State -eq 'private') ("got " + $goneProbe.State + ': ' + $goneProbe.Detail)
+      T 'MUST-FIRE  a status this check does not recognise is UNVERIFIED, never private - it must not invent "safe"' `
+        ($oddProbe.State -eq 'unverified') ("got " + $oddProbe.State + ': ' + $oddProbe.Detail)
+
+      # THE MECHANISM, not the verdict: what the probe actually put on the wire. A pure status-code
+      # table cannot see a wrong URL or a leaked credential, and both would make the verdict lie.
+      $seenPub = $null
+      if ($visFx.Shared.Seen.Count -ge 1) { $seenPub = $visFx.Shared.Seen[0] }
+      T 'MUST-FIRE  the probe asks for git''s info/refs UNDER THE REMOTE''S OWN PATH, so the verdict is about that repository' `
+        (($null -ne $seenPub) -and ([string]$seenPub.Path -eq '/pub.git/info/refs?service=git-upload-pack')) `
+        ("server saw: " + $(if ($seenPub) { [string]$seenPub.Path } else { '<no request arrived>' }))
+
+      # NO CREDENTIALS, and the hostile case is a remote URL that CARRIES them: git remotes routinely
+      # do (https://x-access-token:TOKEN@host/...). A probe that forwarded them would get 200 for a
+      # private repository and report it public, which is the failure that ends belief in this check.
+      $credProbe = Test-RemoteIsPrivate -Url ("http://carol:s3cret@localhost:$($visFx.Port)/priv.git") -TimeoutSec 10
+      $seenCred = $null
+      if ($visFx.Shared.Seen.Count -ge 6) { $seenCred = $visFx.Shared.Seen[5] }
+      T 'MUST-FIRE  a remote URL carrying credentials is still probed ANONYMOUSLY - no Authorization header reaches the host, and it still reads private' `
+        (($null -ne $seenCred) -and ([string]$seenCred.Auth -eq '') -and ($credProbe.State -eq 'private')) `
+        ("state=" + $credProbe.State + " auth=[" + $(if ($seenCred) { [string]$seenCred.Auth } else { '<no request arrived>' }) + ']')
+
+      # A trailing slash is how plenty of remotes are spelled; it must not become a doubled slash,
+      # which is a DIFFERENT path and so a verdict about a different thing.
+      # ASSERT ON THE URL THE CHECK BUILT, NOT ONLY ON WHAT THE SERVER SAW. System.Uri collapses
+      # '//' in a path on its way out, so the server sees the right thing either way: the first
+      # version of this case read the server's record alone and SURVIVED the mutant that removes
+      # the strip (probe 2026-09-19, 7 mutants, this was the one survivor). The reported Detail is
+      # where an unstripped URL is still visible, and it is also what a human reads in the finding.
+      $slashProbe = Test-RemoteIsPrivate -Url ("http://localhost:$($visFx.Port)/pub.git/") -TimeoutSec 10
+      $seenSlash = $null
+      if ($visFx.Shared.Seen.Count -ge 7) { $seenSlash = $visFx.Shared.Seen[6] }
+      T 'CLEAN TWIN a trailing slash on the remote URL probes the SAME path, not a doubled one' `
+        (($null -ne $seenSlash) -and ([string]$seenSlash.Path -eq '/pub.git/info/refs?service=git-upload-pack') `
+         -and ($slashProbe.State -eq 'public') -and (([string]$slashProbe.Detail) -notmatch '\.git//')) `
+        ("server saw: " + $(if ($seenSlash) { [string]$seenSlash.Path } else { '<no request arrived>' }) +
+         ' | check reported: ' + [string]$slashProbe.Detail)
+
+      # A HOST THAT WILL NOT ANSWER. Taken on the fixture's own port with the listener already down,
+      # so the refusal is produced here rather than by whatever a name server or a captive portal
+      # feels like doing: an invented hostname is another answer somebody else owns.
+      Close-VisibilityFixture $visFx
+      $deadProbe = Test-RemoteIsPrivate -Url ("http://127.0.0.1:$($visFx.Port)/pub.git") -TimeoutSec 5
+      T 'MUST-FIRE  a host that refuses the connection is UNVERIFIED, never private - a could-not-look must not settle it' `
+        ($deadProbe.State -eq 'unverified') ("got " + $deadProbe.State + ': ' + $deadProbe.Detail)
+
+      $visRan = ($script:cases - $visStart) + 1
+      T "CLEAN TWIN the seeing arm ran exactly the $VIS_CASES case(s) the blind arm reports as not covered" `
+        ($visRan -eq $VIS_CASES) ("ran=$visRan declared=$VIS_CASES - move `$VIS_CASES with the case list")
+    } finally { Close-VisibilityFixture $visFx }
   }
