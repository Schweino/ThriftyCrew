+  # day Brad makes that repository private this case goes red, run-gates fails and every push on the
+  # box is refused - for a change nobody made to any code, on a fact this guard has no business
+  # depending on. Its twin was the live memory remote, which is the very thing the live run is FOR:
+  # the self-test and production were asserting the same external state, so one flip broke both and
+  # neither could tell the other's failure from its own.
+  #
+  # The rule itself is NOT duplicated here - there is one Test-RemoteIsPrivate and this drives it end
+  # to end, the way Get-MemoryReachability is driven over disk and over a past commit. What changes is
+  # only WHO ANSWERS: a System.Net.HttpListener on a loopback port, serving a frozen status table that
+  # cannot change meaning under us and needs no network at all. That buys back what a pure decision
+  # table could never assert - that the probe really builds git's info/refs URL, really issues the
+  # request, and really sends NO credentials - and it costs one runspace.
+  #
+  # The live path is untouched: it still probes the real allowlisted remote over the real network, and
+  # still treats a could-not-look as BLIND.
+  $VIS_CASES = 10   # cases in the block below. The blind arm reports this as what it did NOT cover,
+                    # and the seeing arm's last case re-derives it, so adding a case without moving
+                    # this constant goes red (2026-09-12 blind-marker ruling, ops-and-gates.md).
+
+  function New-VisibilityFixture {
+    <# Serve the probe's decision table over real HTTP on a loopback port.
+
+       Returns $null when the listener cannot bind - a could-not-look, never a failure and never a
+       pass. Port 0 picks a free ephemeral port, so concurrent run-gates runs on this box cannot
+       collide, and nothing off this machine can reach a localhost prefix. #>
+    $port = 0
+    try {
+      $probeSock = New-Object System.Net.Sockets.TcpListener([Net.IPAddress]::Loopback, 0)
+      $probeSock.Start()
+      $port = ([Net.IPEndPoint]$probeSock.LocalEndpoint).Port
+      $probeSock.Stop()
+    } catch { return $null }
+    $lsn = New-Object System.Net.HttpListener
+    $lsn.Prefixes.Add("http://localhost:$port/")
+    try { $lsn.Start() } catch { return $null }
+    $shared = [hashtable]::Synchronized(@{ Seen = (New-Object System.Collections.ArrayList) })
+    $rs = [runspacefactory]::CreateRunspace()
+    $rs.Open()
+    $rs.SessionStateProxy.SetVariable('shared', $shared)
+    $rs.SessionStateProxy.SetVariable('lsn', $lsn)
+    $shell = [powershell]::Create()
+    $shell.Runspace = $rs
+    $null = $shell.AddScript({
+      while ($true) {
+        try { $ctx = $lsn.GetContext() } catch { break }
+        $rq = $ctx.Request
+        # RECORD BEFORE ANSWERING: what the probe actually sent is half of what these cases assert.
+        [void]$shared.Seen.Add([pscustomobject]@{
+          Path = [string]$rq.Url.PathAndQuery
+          Auth = [string]$rq.Headers['Authorization']
+          Ua   = [string]$rq.UserAgent })
+        # THE FROZEN TABLE. One repository name per status a real git host can answer with.
+        $ap = [string]$rq.Url.AbsolutePath
+        $code = 500
+        if     ($ap -like '/pub.git/*')  { $code = 200 }   # public: anonymous clone is served
+        elseif ($ap -like '/priv.git/*') { $code = 401 }   # GitHub's answer for a private repository
+        elseif ($ap -like '/forb.git/*') { $code = 403 }
+        elseif ($ap -like '/gone.git/*') { $code = 404 }
+        elseif ($ap -like '/odd.git/*')  { $code = 418 }   # a status this check does not recognise
+        $resp = $ctx.Response
+        $resp.StatusCode = $code
+        if ($code -eq 401) { $resp.AddHeader('WWW-Authenticate', 'Basic realm="fixture"') }
+        $body = [Text.Encoding]::ASCII.GetBytes("fixture`n")
+        $resp.ContentLength64 = $body.Length
+        try { $resp.OutputStream.Write($body, 0, $body.Length) } catch { }
+        $resp.Close()
+      }
+    })
+    $async = $shell.BeginInvoke()
+    return [pscustomobject]@{ Port = $port; Listener = $lsn; Shell = $shell; Runspace = $rs
+                              Async = $async; Shared = $shared; Stopped = $false }
+  }
+
+  function Close-VisibilityFixture {
+    # IDEMPOTENT ON PURPOSE: the closed-port case needs the listener down while the block is still
+    # running, and the finally must still be safe to call afterwards.
+    param($Fx)
+    if (-not $Fx -or $Fx.Stopped) { return }
+    $Fx.Stopped = $true
+    try { $Fx.Listener.Stop() } catch { }
+    try { $Fx.Listener.Close() } catch { }
+    # Generous HANG GUARD, never a bar on how fast it ran: Stop() makes GetContext throw at once.
+    if (-not $Fx.Async.AsyncWaitHandle.WaitOne(20000)) { try { $Fx.Shell.Stop() } catch { } }
+    try { $Fx.Shell.Dispose() } catch { }
+    try { $Fx.Runspace.Dispose() } catch { }
+  }
+
+  $visFx = New-VisibilityFixture
+  if (-not $visFx) {
+    # A could-not-look is never a pass. Say what it did not cover, not just that it noticed.
+    T ("BLIND  no loopback HTTP listener could be bound, so the visibility probe's decision table was " +
+       "NOT exercised this run: $VIS_CASES case(s) not covered (this is not a pass)") $true ''
   } else {
-    T 'MUST-FIRE  a PUBLIC repository is detected as public (the control - without this a 401 proves nothing)' `
-      ($pubProbe.State -eq 'public') ("got " + $pubProbe.State + ': ' + $pubProbe.Detail)
