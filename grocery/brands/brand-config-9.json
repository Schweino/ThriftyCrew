                                                           "Spectrum"
                                                       ]
                                        },
                        "fruit-punch":  {
                                            "label":  "Fruit Punch",
                                            "unit":  "floz",
                                            "queries":  [
                                                            "fruit punch",
                                                            "hawaiian punch"
