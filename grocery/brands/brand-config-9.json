                                                            ],
                                                "include":  "vanilla\\s+extract|pure\\s+vanilla\\b",
                                                "exclude":  "\\bbean\\b|almond|yog|creamer|\\bice\\b",
                                                "brands":  [
                                                               "McCormick",
                                                               "Watkins"
                                                           ]
