                                                             "cocoa powder",
                                                             "baking cocoa"
                                                         ],
                                             "include":  "cocoa\\s+powder|baking\\s+cocoa|100%\\s+cacao",
                                             "exclude":  "\\bhot\\b|\\bmix\\b|krispies|cereal|instant",
                                             "brands":  [
                                                            "Hershey\u0027s",
                                                            "Nestle",
                                                            "Ghirardelli"
                                                        ]
                                         },
                        "vanilla-extract":  {
                                                "label":  "Vanilla Extract",
