                                            "include":  "heavy\\s+(?:whipping\\s+)?cream|whipping\\s+cream",
                                            "exclude":  "whipped|\\bsour\\b|\\bcheese\\b|topping",
                                            "brands":  [
                                                           "Land O Lakes",
                                                           "Horizon"
