                                     "include":  "iodized\\s+salt|table\\s+salt|\\bsalt\\b",
                                     "exclude":  "salted|chips|vinegar|epsom|\\bbath\\b|caramel|seasoning|\\bsea\\s+salt\\s+(?:caramel|chocolate)|\\bbutter\\b|\\bnuts?\\b|grinder|lamp|no\\s+salt|\\bcorn\\b|unsalted|salt[-\\s]?free|del\\s+monte|peanut",
                                     "brands":  [
