{
    "commodities":  {
                        "canned-pinto-beans":  {
                                                   "label":  "Canned Pinto Beans",
                                                   "unit":  "oz",
                                                   "queries":  [
                                                                   "pinto beans"
                                                               ],
                                                   "include":  "pinto\\s+beans?",
                                                   "exclude":  "\\bdry\\b|\\bdried\\b|refried|\\bsoup\\b|chili",
                                                   "brands":  [
                                                                  "Bush\u0027s",
                                                                  "La Preferida",
                                                                  "Rosarita"
                                                              ]
                                               },
                        "frozen-corn":  {
                                            "label":  "Frozen Corn",
                                            "unit":  "oz",
                                            "queries":  [
                                                            "frozen corn"
                                                        ],
                                            "include":  "frozen\\s+(?:sweet\\s+)?corn|steamable\\s+corn|corn\\b.{0,20}\\bfrozen\\b|super\\s+sweet\\s+corn\\b.{0,15}\\bbag|cut\\s+(?:golden\\s+)?corn|steamables?\\b.{0,20}corn|super\\s+sweet\\s+corn|frozen\\b.{0,25}\\bcorn\\b|corn\\b.{0,20}\\bsteamable\\b",
                                            "exclude":  "\\bcob\\b|fresh|\\bcanned\\b|cream|\\bdogs?\\b",
                                            "brands":  [
                                                           "Birds Eye",
                                                           "Green Giant"
                                                       ]
                                        },
                        "frozen-broccoli":  {
                                                "label":  "Frozen Broccoli",
                                                "unit":  "oz",
                                                "queries":  [
                                                                "frozen broccoli"
                                                            ],
                                                "include":  "frozen\\s+broccoli|broccoli\\s+florets\\b.{0,25}(?:frozen|steam)|steamable\\s+broccoli|broccoli\\s+cuts|cut\\s+broccoli",
                                                "exclude":  "fresh|cheese|\\brice\\b|\\bsoup\\b",
                                                "brands":  [
                                                               "Birds Eye",
                                                               "Green Giant"
                                                           ]
                                            },
                        "cocoa-powder":  {
                                             "label":  "Cocoa Powder (baking)",
