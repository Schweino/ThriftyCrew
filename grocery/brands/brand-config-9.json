                                                    "Diamond Crystal"
                                                ]
                                 },
                        "egg-noodles":  {
                                            "label":  "Egg Noodles",
                                            "unit":  "oz",
                                            "queries":  [
                                                            "egg noodles"
                                                        ],
                                            "include":  "egg\\s+noodles?|egg\\s+pasta",
