[
  { "id": "chicken-breast", "label": "Boneless Skinless Chicken Breast", "unit": "lb",
    "include": ["boneless,?\\s*skinless\\s+chicken\\s+breast", "chicken\\s+breast[^,]*boneless", "b\\.?s\\.?b\\.?\\s+chicken"],
    "exclude": ["thigh", "tender", "strip", "nugget", "breaded", "canned", "salad", "cooked", "wing", "patty", "patties", "ground", "thin[\\s-]*sliced", "skewer", "twister", "bone[\\s-]*in", "split"] },

  { "id": "chicken-thighs", "label": "Chicken Thighs / Drumsticks", "unit": "lb",
    "include": ["chicken\\s+(thigh|drumstick|leg)", "(thigh|drumstick)s?[^,]*chicken"],
    "exclude": ["boneless skinless.*breast", "breaded", "cooked", "nugget"] },

  { "id": "ground-beef-8020", "label": "80/20 Ground Beef", "unit": "lb",
    "include": ["ground\\s+beef[^.]*80", "80%?\\s*lean[^.]*20%?\\s*fat", "80/20\\s+ground", "ground\\s+chuck"],
    "exclude": ["turkey", "meatball", "patty", "patties", "93%", "90%", "96%", "85%", "85/15", "organic", "grass[\\s-]*fed"] },

  { "id": "ground-turkey", "label": "Ground Turkey", "unit": "lb",
    "include": ["ground\\s+turkey"],
    "exclude": ["beef", "patty", "patties"] },

  { "id": "bacon", "label": "Bacon", "unit": "lb",
    "include": ["\\bbacon\\b"],
    "exclude": ["bits", "ranch", "bacon\\s+cheese", "canadian", "turkey bacon"] },

  { "id": "pork-chops", "label": "Pork Chops", "unit": "lb",
    "include": ["pork\\b.{0,25}\\bchops?\\b", "\\bchops?\\b.{0,20}\\bpork\\b"],
    "exclude": ["breaded", "stuffed", "cooked", "seasoned", "marinated"] },

  { "id": "eggs", "label": "Large Eggs (dozen)", "unit": "dozen",
    "include": ["\\beggs?\\b", "dozen\\s+egg", "grade\\s*a\\s+egg"],
    "exclude": ["eggo", "eggplant", "egg\\s+roll", "noodle", "egg\\s+bite", "egg\\s+white", "substitute", "scrambl", "deviled", "\\bnog\\b", "hard[\\s-]?cooked", "peeled", "salad"] },

  { "id": "milk", "label": "Milk (gallon)", "unit": "gallon",
    "include": ["\\bmilk\\b", "gallon\\s+milk"],
    "exclude": ["almond", "\\boat\\b", "\\bsoy\\b", "coconut", "chocolate\\s+milk", "evaporated", "condensed", "buttermilk", "milkbone", "cream"] },

  { "id": "butter", "label": "Butter", "unit": "lb",
    "include": ["\\bbutter\\b"],
    "exclude": ["peanut", "almond\\s+butter", "cashew", "body", "cookie", "buttermilk", "butterscotch", "apple\\s+butter", "bread", "pickle", "plant", "crock", "brummel", "imperial", "\\bballs?\\b", "not\\s+butter", "spread", "canola", "\\boil\\b"] },

  { "id": "cottage-cheese", "label": "Cottage Cheese", "unit": "oz",
    "include": ["cottage\\s+cheese"],
    "exclude": [] },

  { "id": "sour-cream", "label": "Sour Cream", "unit": "oz",
    "include": ["sour\\s+cream"],
    "exclude": ["dip"] },

  { "id": "cream-cheese", "label": "Cream Cheese", "unit": "oz",
    "include": ["cream\\s+cheese"],
    "exclude": ["frosting"] },

  { "id": "shredded-cheese", "label": "Shredded / Block Cheese", "unit": "oz",
    "include": ["shredded\\s+cheese", "chunk\\s+cheese", "cheese\\s+chunk", "block\\s+cheese", "(cheddar|mozzarella|colby|monterey|jack)\\s+cheese", "cheese[^,]*(cheddar|mozzarella|colby)"],
    "exclude": ["cottage", "cream\\s+cheese", "cheesecake", "cheese\\s+cake", "macaroni", "cracker", "string", "cheese\\s+dip", "sauce", "slice", "spread", "snack"] },

  { "id": "yogurt", "label": "Yogurt", "unit": "oz",
    "include": ["yog(?:h)?urt"],
    "exclude": ["covered", "bar", "pretzel", "raisin", "cheese", "shred"] },

  { "id": "bananas", "label": "Bananas", "unit": "lb",
    "include": ["banana"],
    "exclude": ["bread", "pudding", "chip", "muffin"] },

  { "id": "strawberries", "label": "Strawberries", "unit": "oz",
    "include": ["strawberr"],
    "exclude": ["cream", "\\bjam\\b", "preserve", "flavored", "yog(?:h)?urt", "\\bbar\\b", "spread"] },

  { "id": "blueberries", "label": "Blueberries", "unit": "oz", "pint_oz": 11.2,
    "include": ["blueberr"],
    "exclude": ["muffin", "waffle", "pancake", "\\bjam\\b", "preserve", "yog(?:h)?urt", "\\bbar\\b", "spread", "syrup"] },

  { "id": "avocados", "label": "Avocados", "unit": "each",
    "include": ["avocado"],
    "exclude": ["\\boil\\b", "guacamole"] },

  { "id": "russet-potatoes", "label": "Russet Potatoes", "unit": "lb",
    "include": ["russet\\s+potato", "potato[^,]*russet", "baker\\s+potato", "\\brusset\\b"],
    "exclude": ["sweet\\s+potato", "chip", "\\btot\\b", "salad", "tater", "frozen", "instant"] },

  { "id": "onions", "label": "Yellow / Sweet Onions", "unit": "lb",
    "include": ["\\bonion", "vidalia"],
    "exclude": ["green\\s+onion", "onion\\s+ring", "onion\\s+powder", "red\\s+onion", "soup"] },

  { "id": "apples", "label": "Apples", "unit": "lb",
    "include": ["\\bapple(s)?\\b", "honeycrisp", "gala\\s+apple", "fuji\\s+apple"],
    "exclude": ["pineapple", "apple\\s+juice", "applesauce", "apple\\s+sauce", "caramel", "\\bpie\\b", "cider"] },

  { "id": "grapes", "label": "Grapes", "unit": "lb",
    "include": ["\\bgrape(s)?\\b"],
    "exclude": ["grapefruit", "grape\\s+juice", "grape\\s+tomato", "jelly", "\\bjam\\b"] },

  { "id": "sweet-corn", "label": "Sweet Corn (ear)", "unit": "each",
    "include": ["sweet\\s+corn", "corn\\s+on\\s+the\\s+cob", "fresh\\s+corn"],
    "exclude": ["popcorn", "corn\\s+bread", "cornbread", "cornflake", "tortilla", "corn\\s+dog", "canned", "cream\\s+corn", "corn\\s+chip", "syrup", "starch", "firecracker", "jamaican", "street", "rice\\s+cake", "steam", "crisp", "grill\\s+ready", "green\\s+giant"] },

  { "id": "watermelon", "label": "Whole Watermelon", "unit": "each",
    "include": ["whole.*watermelon", "seedless\\s+watermelon", "watermelon"],
    "exclude": ["cut", "sliced", "chunk", "cup", "candy", "flavored"] },

  { "id": "peaches", "label": "Peaches", "unit": "lb",
    "include": ["peach(es)?"],
    "exclude": ["ring", "cobbler", "canned", "\\bpie\\b", "yogurt", "flavored", "cling", "sliced", "\\bjar\\b", "preserve", "\\bcup"] },

  { "id": "bread", "label": "Bread (loaf)", "unit": "each",
    "include": ["\\bbread\\b", "sandwich\\s+loaf", "white\\s+loaf", "wheat\\s+loaf"],
    "exclude": ["breadstick", "cornbread", "crumb", "pita", "naan", "\\bbun", "banana\\s+bread", "garlic\\s+bread", "pudding", "flatbread", "dough"] },

  { "id": "peanut-butter", "label": "Peanut Butter", "unit": "oz",
    "include": ["peanut\\s+butter"],
    "exclude": ["\\bcup", "cookie", "cracker", "\\bbar\\b", "cereal", "pretzel", "filled", "\\bball", "granola"] },

  { "id": "orange-juice", "label": "Orange Juice", "unit": "floz",
    "include": ["orange\\s+juice"],
    "exclude": ["drink", "punch", "soda"] },

  { "id": "coffee", "label": "Coffee (ground/beans)", "unit": "oz",
    "include": ["\\bcoffee\\b", "ground\\s+coffee", "coffee\\s+beans"],
    "exclude": ["creamer", "filter", "\\bmug\\b", "iced\\s+coffee", "\\bpod", "k-?cup", "ready\\s+to\\s+drink", "\\brtd\\b", "cold\\s+brew\\s+can"] },

  { "id": "laundry-detergent", "label": "Laundry Detergent (Arm & Hammer OxiClean)", "unit": "floz",
    "include": ["arm\\s*(?:&|&amp;|and)\\s*hammer.{0,60}(?:oxi\\s*-?\\s*clean|odor\\s*blasters?)", "(?:oxi\\s*-?\\s*clean|odor\\s*blasters?).{0,60}arm\\s*(?:&|&amp;|and)\\s*hammer"],
    "exclude": ["\\bpods?\\b", "\\bpaks?\\b", "\\bpacs?\\b", "\\bpowder\\b", "\\bsheets?\\b", "stain\\s*remover", "\\bspray\\b", "\\bscent\\s*booster", "in-?wash", "\\bdish\\b", "unit\\s*dose", "\\btabs?\\b"] }
]
