{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tc-grocery-public",
  "main": "apps/public/src/index.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.thriftycrew.com/api/v2/*", "zone_name": "thriftycrew.com" },
    { "pattern": "www.thriftycrew.com/v2/*", "zone_name": "thriftycrew.com" },
    { "pattern": "www.thriftycrew.com/member-status*", "zone_name": "thriftycrew.com" },
    { "pattern": "www.thriftycrew.com/member-status/*", "zone_name": "thriftycrew.com" },
    { "pattern": "www.thriftycrew.com/v3-member-status*", "zone_name": "thriftycrew.com" }
  ],
  "compatibility_date": "2026-08-11",
  "services": [
    { "binding": "CONTROL", "service": "tc-grocery-v3" }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
