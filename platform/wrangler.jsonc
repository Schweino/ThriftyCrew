{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tc-grocery-v3",
  "main": "apps/api/src/index.ts",
  "workers_dev": false,
  "routes": [],
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "limits": {
    "cpu_ms": 120000
  },
  "assets": {
    "directory": "./apps/site/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/internal/*", "/v2/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tc-grocery-v3",
      "database_id": "a567ae53-a582-498f-b4c2-2d8843096b75",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "tc-grocery-v3-evidence"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "tc-grocery-v3-backups"
    },
    {
      "binding": "BACKUPS_SECONDARY",
      "bucket_name": "tc-grocery-v3-backups-secondary"
    },
    {
      "binding": "ARCHIVE",
      "bucket_name": "tc-grocery-v3-archive"
    }
  ],
  "workflows": [
    {
      "name": "tc-grocery-v3-d1-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "D1BackupWorkflow"
    },
    {
      "name": "tc-grocery-v3-d1-restore-drill",
      "binding": "RESTORE_WORKFLOW",
      "class_name": "D1RestoreDrillWorkflow"
    },
    {
      "name": "tc-grocery-v3-capture-validation",
      "binding": "CAPTURE_VALIDATION_WORKFLOW",
      "class_name": "CaptureValidationWorkflow"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "FUNNEL_ANALYTICS",
      "dataset": "tc_grocery_funnel"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://tc-grocery-public.curly-unit-51a6.workers.dev",
    "GHOST_ADMIN_ORIGIN": "https://map-to-success.ghost.io",
    "GHOST_PUBLIC_ORIGIN": "https://www.thriftycrew.com",
    "GITHUB_OIDC_AUDIENCE": "tc-grocery-v3",
    "GITHUB_OIDC_REPOSITORY": "Schweino/SimpleMoneyPlaybook",
    "GITHUB_OIDC_REPOSITORY_ID": "1293567395",
    "GITHUB_OIDC_WORKFLOW_REF": "Schweino/SimpleMoneyPlaybook/.github/workflows/platform-v3.yml@refs/heads/main",
    "GITHUB_OIDC_WORKFLOW_REFS": "[\"Schweino/SimpleMoneyPlaybook/.github/workflows/platform-v3.yml@refs/heads/main\",\"Schweino/SimpleMoneyPlaybook/.github/workflows/platform-restore.yml@refs/heads/main\"]",
    "GITHUB_OIDC_AGENT_RUNNER_REF": "Schweino/SimpleMoneyPlaybook/.github/workflows/platform-agent-runner.yml@refs/heads/main",
    "GITHUB_REPOSITORY": "Schweino/SimpleMoneyPlaybook",
    "GITHUB_WORKFLOW_FILE": "platform-v3.yml",
    "GITHUB_ACTIONS_DISPATCH_ENABLED": "0",
    "OPS_ALERT_URL": "https://feed.thriftycrew.com/ops-alert",
    "CLOUDFLARE_ACCOUNT_ID": "bdf84c0d4146b198e8a14a59d08701ed",
    "D1_DATABASE_ID": "a567ae53-a582-498f-b4c2-2d8843096b75",
    "D1_DATABASE_LIMIT_BYTES": "10737418240",
    "R2_EVIDENCE_BUCKET": "tc-grocery-v3-evidence"
  }
}
