---
interface Props {
  canonicalPath: string;
  beta?: boolean;
}

const { canonicalPath, beta = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f35" />
    <meta name="description" content="Compare normalized grocery prices across Omaha stores." />
    <link rel="canonical" href={`https://thriftycrew.com${canonicalPath}`} />
    <title>Omaha Grocery Price Board | Thrifty Crew</title>
  </head>
  <body>
    <a class="skip-link" href="#price-board">Skip to prices</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Thrifty Crew home">
        <span class="brand-mark" aria-hidden="true">TC</span>
        <span><strong>Thrifty Crew</strong><small>Omaha grocery intelligence</small></span>
      </a>
      <div class="header-meta">
        {beta && <span class="beta-badge">Beta</span>}
        <a class="join-link" href="/#/portal/signup" data-telemetry="signup_click">Join</a>
        <span class="freshness" id="freshness">Loading current release…</span>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">THE PRICE BOARD</p>
          <h1 id="page-title">See what groceries really cost.</h1>
          <p class="lede">Every package normalized to the same unit, across seven Omaha stores. No coupon math hidden in the fine print.</p>
        </div>
        <aside class="hero-note">
          <span aria-hidden="true">↘</span>
          <p><strong>The crown marks the cheapest.</strong><br />Member-only prices are labeled, and you can hide them.</p>
        </aside>
      </section>

      <section class="toolbar" aria-label="Price board controls">
        <label class="search-field">
          <span>Find an item</span>
          <input id="search" type="search" placeholder="Try eggs, chicken, coffee…" autocomplete="off" />
        </label>
        <label class="select-field">
          <span>Sort by</span>
          <select id="sort">
            <option value="category">Category</option>
            <option value="alphabetical">A–Z</option>
            <option value="price">Lowest unit price</option>
          </select>
        </label>
        <label class="membership-toggle">
          <input id="membership" type="checkbox" />
          <span class="toggle" aria-hidden="true"></span>
          Hide club-only prices
        </label>
      </section>

      <nav class="categories" id="categories" aria-label="Grocery categories"></nav>

      <section id="price-board" class="board" aria-live="polite" aria-busy="true">
        <div class="loading-card">
          <span class="spinner" aria-hidden="true"></span>
          <p>Loading the latest guarded release…</p>
        </div>
      </section>
    </main>

    <footer>
      <p><strong>Price fairly. Shop clearly.</strong></p>
      <p>Prices are normalized from current shelf and weekly-ad observations. Availability and in-store totals can change.</p>
    </footer>

    <script>
      interface Category { id: string; label: string; sortOrder?: number }
      interface StoreRow { store: string; perUnitMicros: number; unit: string; membership: boolean; member_label: string; item: string; ad: string; productUrl?: string }
      interface Commodity { id: string; label: string; unit: string; categoryId: string; cheapest: { store: string; perUnitMicros: number } | null; stores: StoreRow[] }
      interface BoardData { generatedAt: string; categories: Category[]; commodities: Commodity[] }
      interface BoardState { board: BoardData | null; category: string; query: string; sort: string; hideMembership: boolean }
      interface BoardResponse { ok: boolean; error?: string; releaseId?: string; publishedAt?: string; board: BoardData }

      function requiredElement<T extends Element>(selector: string): T {
        const node = document.querySelector<T>(selector);
        if (!node) throw new Error(`Required page element is missing: ${selector}`);
        return node;
      }

      const state: BoardState = { board: null, category: "all", query: "", sort: "category", hideMembership: false };
      const boardElement = requiredElement<HTMLElement>("#price-board");
      const categoriesElement = requiredElement<HTMLElement>("#categories");
      const freshnessElement = requiredElement<HTMLElement>("#freshness");
      const searchInput = requiredElement<HTMLInputElement>("#search");
      const sortSelect = requiredElement<HTMLSelectElement>("#sort");
      const membershipInput = requiredElement<HTMLInputElement>("#membership");
      const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 4 });
      let releaseId: string | undefined;

      function sendEvent(event: "view" | "tool_use" | "signup_click" | "join_attempt", product?: string) {
        const body = JSON.stringify({ event, path: location.pathname, memberTier: "anonymous", releaseId, product });
        if (navigator.sendBeacon) {
          navigator.sendBeacon("/api/v2/events", new Blob([body], { type: "application/json" }));
          return;
        }
        void fetch("/api/v2/events", { method: "POST", headers: { "content-type": "application/json" }, body, keepalive: true });
      }

      const safeUrl = (value: string | undefined): string | null => {
        if (!value) return null;
        try {
          const parsed = new URL(value);
          return parsed.protocol === "https:" ? parsed.href : null;
        } catch { return null; }
      };

      const unitLabel = (unit: string): string => ({ fl_oz: "fl oz", gal: "gal" } as Record<string, string>)[unit] || unit;
      const priceLabel = (micros: number, unit: string): string => `${money.format(micros / 1_000_000)} / ${unitLabel(unit)}`;
      function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = "", text?: string): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function renderCategories() {
        if (!state.board) return;
        categoriesElement.replaceChildren();
        const options = [{ id: "all", label: "All items" }, ...state.board.categories];
        for (const category of options) {
          const button = el("button", category.id === state.category ? "category active" : "category", category.label);
          button.type = "button";
          button.dataset.category = category.id;
          button.setAttribute("aria-pressed", String(category.id === state.category));
          button.addEventListener("click", () => { state.category = category.id; renderCategories(); renderBoard(); sendEvent("tool_use", `category:${category.id}`); });
          categoriesElement.append(button);
        }
      }

      function visibleCommodities(): Commodity[] {
        if (!state.board) return [];
        const board = state.board;
        const query = state.query.trim().toLowerCase();
        const categoryOrder = new Map<string, number>(board.categories.map((category, index) => [category.id, index]));
        const rows = board.commodities.filter((item) =>
          (state.category === "all" || item.categoryId === state.category)
          && (!query || item.label.toLowerCase().includes(query) || item.stores.some((store) => store.item.toLowerCase().includes(query)))
        );
        return rows.sort((left, right) => {
          if (state.sort === "alphabetical") return left.label.localeCompare(right.label);
          if (state.sort === "price") {
            if (!left.cheapest && !right.cheapest) return left.label.localeCompare(right.label);
            if (!left.cheapest) return 1;
            if (!right.cheapest) return -1;
            return left.cheapest.perUnitMicros - right.cheapest.perUnitMicros || left.label.localeCompare(right.label);
          }
          return (categoryOrder.get(left.categoryId) ?? 999) - (categoryOrder.get(right.categoryId) ?? 999) || left.label.localeCompare(right.label);
        });
      }

      function storeCard(store: StoreRow, bestStore: string | null): HTMLElement {
        const winner = store.store === bestStore;
        const card = el("article", `store-card${winner ? " winner" : ""}${store.membership ? " membership" : ""}`);
        const top = el("div", "store-card-top");
        top.append(el("span", "store-name", store.store));
        if (winner) top.append(el("span", "crown", "♛ Cheapest"));
        else if (store.membership) top.append(el("span", "member-pill", store.member_label || "Membership"));
        card.append(top);
        card.append(el("strong", "price", priceLabel(store.perUnitMicros, store.unit)));
        card.append(el("span", "package-price", store.ad));
        card.append(el("p", "product-name", store.item));
        const link = safeUrl(store.productUrl);
        if (link) {
          const anchor = el("a", "product-link", "See item ↗");
          anchor.href = link;
          anchor.target = "_blank";
          anchor.rel = "noopener noreferrer";
          card.append(anchor);
        }
        return card;
      }

      function commodityCard(item: Commodity): HTMLElement {
        const visibleStores = item.stores.filter((store) => !state.hideMembership || !store.membership);
        const visibleBest = visibleStores.reduce<StoreRow | null>((best, store) => !best || store.perUnitMicros < best.perUnitMicros ? store : best, null);
        const card = el("section", "commodity-card");
        const heading = el("header", "commodity-heading");
        const titleWrap = el("div");
        const title = el("h2", "commodity-title", item.label);
        titleWrap.append(title, el("span", "comparison-unit", `Compared per ${unitLabel(item.unit)}`));
        heading.append(titleWrap);
        const best = el("div", "best-summary");
        if (visibleBest) {
          best.append(el("span", "best-label", "Best today"), el("strong", "", priceLabel(visibleBest.perUnitMicros, item.unit)), el("span", "", visibleBest.store));
        } else {
          best.append(el("span", "best-label", "Current coverage"), el("strong", "", "No verified price"), el("span", "", "Check back after the next capture"));
        }
        heading.append(best);
        card.append(heading);
        const stores = el("div", "store-grid");
        for (const store of visibleStores) stores.append(storeCard(store, visibleBest?.store ?? null));
        if (visibleStores.length === 0) stores.append(el("p", "empty-store-row", "No eligible current observations are available for this item."));
        card.append(stores);
        return card;
      }

      function renderBoard() {
        const rows = visibleCommodities();
        boardElement.replaceChildren();
        boardElement.setAttribute("aria-busy", "false");
        if (rows.length === 0) {
          const empty = el("div", "empty-state");
          empty.append(el("strong", "", "No matching groceries"), el("p", "", "Try another search or choose a different category."));
          boardElement.append(empty);
          return;
        }
        const resultCount = el("p", "result-count", `${rows.length} ${rows.length === 1 ? "item" : "items"}`);
        boardElement.append(resultCount);
        for (const item of rows) boardElement.append(commodityCard(item));
      }

      async function loadBoard() {
        try {
          const response = await fetch("/api/v2/board", { headers: { accept: "application/json" } });
          const result = await response.json() as BoardResponse;
          if (!response.ok || !result.ok) throw new Error(result.error || `Request failed (${response.status})`);
          state.board = result.board;
          releaseId = result.releaseId;
          const stamp = new Date(result.publishedAt || result.board.generatedAt);
          freshnessElement.textContent = `Guarded release · ${stamp.toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" })}`;
          renderCategories();
          renderBoard();
          sendEvent("view", "price-board");
        } catch (error) {
          boardElement.setAttribute("aria-busy", "false");
          boardElement.replaceChildren();
          const panel = el("div", "error-state");
          panel.append(el("strong", "", "The price board could not load."), el("p", "", error instanceof Error ? error.message : "Unknown error"));
          const retry = el("button", "retry", "Try again");
          retry.type = "button";
          retry.addEventListener("click", loadBoard);
          panel.append(retry);
          boardElement.append(panel);
          freshnessElement.textContent = "Release unavailable";
        }
      }

      let searchTimer: number | undefined;
      searchInput.addEventListener("input", () => {
        state.query = searchInput.value;
        renderBoard();
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => sendEvent("tool_use", "search"), 500);
      });
      sortSelect.addEventListener("change", () => { state.sort = sortSelect.value; renderBoard(); sendEvent("tool_use", `sort:${state.sort}`); });
      membershipInput.addEventListener("change", () => { state.hideMembership = membershipInput.checked; renderBoard(); sendEvent("tool_use", "membership-filter"); });
      document.querySelector("[data-telemetry='signup_click']")?.addEventListener("click", () => sendEvent("signup_click", "header-join"));
      loadBoard();
    </script>
  </body>
</html>

<style is:global>
  :root { --ink:#173f35; --ink-soft:#557168; --paper:#f7f3e8; --card:#fffdf7; --line:#d9d5c8; --lime:#d8ed76; --orange:#ff7849; --blue:#cce8ed; color-scheme:light; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  * { box-sizing:border-box; }
  body { margin:0; color:var(--ink); background:var(--paper); min-width:320px; }
  button,input,select { font:inherit; }
  .skip-link { position:absolute; left:-9999px; top:8px; z-index:10; background:white; color:var(--ink); padding:10px 14px; border-radius:8px; }
  .skip-link:focus { left:8px; }
  .site-header { min-height:82px; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:14px clamp(18px,5vw,76px); border-bottom:1px solid rgba(23,63,53,.16); background:rgba(247,243,232,.95); position:sticky; top:0; z-index:5; backdrop-filter:blur(12px); }
  .brand { display:flex; gap:12px; align-items:center; color:inherit; text-decoration:none; }
  .brand-mark { display:grid; place-items:center; width:42px; height:42px; border-radius:14px 14px 5px 14px; background:var(--ink); color:var(--lime); font-weight:900; letter-spacing:-.05em; }
  .brand strong,.brand small { display:block; }
  .brand strong { font-size:17px; letter-spacing:-.02em; }
  .brand small { color:var(--ink-soft); font-size:12px; margin-top:2px; }
  .header-meta { display:flex; align-items:center; justify-content:flex-end; gap:10px; text-align:right; font-size:12px; color:var(--ink-soft); }
  .join-link { color:white; background:var(--ink); border-radius:999px; padding:8px 13px; font-weight:850; text-decoration:none; }
  .beta-badge,.member-pill { border:1px solid currentColor; border-radius:999px; padding:4px 8px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; font-size:10px; }
  main { width:min(1500px,100%); margin:0 auto; padding:0 clamp(16px,4vw,64px) 70px; }
  .hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(250px,380px); gap:48px; align-items:end; padding:clamp(54px,8vw,110px) 0 50px; }
  .eyebrow { font-size:12px; letter-spacing:.2em; font-weight:900; margin:0 0 18px; }
  h1 { max-width:850px; margin:0; font-family:Georgia,"Times New Roman",serif; font-size:clamp(48px,7.5vw,112px); font-weight:500; line-height:.88; letter-spacing:-.065em; }
  .lede { max-width:720px; font-size:clamp(17px,2vw,22px); line-height:1.5; color:var(--ink-soft); margin:28px 0 0; }
  .hero-note { display:flex; gap:14px; align-items:flex-start; background:var(--lime); border:1px solid var(--ink); border-radius:28px 28px 8px 28px; padding:22px; box-shadow:5px 5px 0 var(--ink); transform:rotate(-1deg); }
  .hero-note>span { font-size:30px; line-height:1; }
  .hero-note p { margin:0; line-height:1.45; }
  .toolbar { display:grid; grid-template-columns:minmax(230px,1fr) 200px auto; gap:14px; align-items:end; padding:18px; background:var(--ink); color:white; border-radius:22px 22px 8px 22px; }
  .search-field,.select-field { display:grid; gap:7px; font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  input[type="search"],select { width:100%; min-height:48px; border:1px solid rgba(255,255,255,.3); border-radius:12px; background:#fff; color:var(--ink); padding:0 14px; outline:none; }
  input[type="search"]:focus,select:focus { box-shadow:0 0 0 4px rgba(216,237,118,.45); }
  .membership-toggle { display:flex; align-items:center; gap:10px; min-height:48px; padding:0 10px; font-size:13px; font-weight:700; cursor:pointer; }
  .membership-toggle input { position:absolute; opacity:0; pointer-events:none; }
  .toggle { width:42px; height:24px; padding:3px; border-radius:999px; border:1px solid rgba(255,255,255,.5); background:rgba(255,255,255,.14); transition:.2s; }
  .toggle::after { content:""; display:block; width:16px; height:16px; background:white; border-radius:50%; transition:.2s; }
  .membership-toggle input:checked + .toggle { background:var(--lime); }
  .membership-toggle input:checked + .toggle::after { transform:translateX(18px); background:var(--ink); }
  .categories { display:flex; gap:8px; overflow-x:auto; padding:22px 2px 18px; scrollbar-width:thin; }
  .category { flex:0 0 auto; padding:10px 14px; border:1px solid var(--line); border-radius:999px; color:var(--ink); background:transparent; font-weight:750; font-size:13px; cursor:pointer; }
  .category:hover,.category.active { color:white; background:var(--ink); border-color:var(--ink); }
  .board { display:grid; gap:14px; }
  .result-count { margin:4px 2px 0; color:var(--ink-soft); font-size:13px; font-weight:750; }
  .commodity-card { background:var(--card); border:1px solid var(--line); border-radius:20px 20px 7px 20px; overflow:hidden; }
  .commodity-heading { display:flex; justify-content:space-between; gap:20px; align-items:center; padding:22px 24px; border-bottom:1px solid var(--line); }
  .commodity-title { font-family:Georgia,"Times New Roman",serif; font-size:clamp(24px,3vw,36px); line-height:1; margin:0; font-weight:500; letter-spacing:-.035em; }
  .comparison-unit { display:block; color:var(--ink-soft); font-size:12px; margin-top:7px; }
  .best-summary { min-width:150px; display:grid; text-align:right; font-size:13px; }
  .best-summary strong { font-size:20px; }
  .best-label { color:var(--ink-soft); font-size:10px; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
  .store-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); }
  .empty-store-row { grid-column:1/-1; margin:0; padding:20px; color:var(--ink-soft); background:#f7f3ea; }
  .store-card { min-height:204px; padding:18px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); position:relative; display:flex; flex-direction:column; align-items:flex-start; }
  .store-card.winner { background:linear-gradient(150deg,var(--lime),#eef7bd); }
  .store-card.membership:not(.winner) { background:linear-gradient(150deg,#edf7f8,var(--blue)); }
  .store-card-top { width:100%; display:flex; align-items:center; justify-content:space-between; gap:7px; min-height:25px; }
  .store-name { font-size:12px; font-weight:900; text-transform:uppercase; letter-spacing:.07em; }
  .crown { font-size:10px; font-weight:900; text-transform:uppercase; }
  .price { display:block; font-family:Georgia,"Times New Roman",serif; font-size:25px; letter-spacing:-.035em; margin-top:16px; }
  .package-price { color:var(--ink-soft); font-size:11px; margin-top:2px; }
  .product-name { color:var(--ink-soft); font-size:12px; line-height:1.4; margin:14px 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .product-link { margin-top:auto; color:var(--ink); font-size:12px; font-weight:850; text-underline-offset:3px; }
  .loading-card,.empty-state,.error-state { display:grid; place-items:center; text-align:center; min-height:260px; padding:30px; border:1px dashed var(--ink-soft); border-radius:20px; }
  .loading-card p,.empty-state p,.error-state p { color:var(--ink-soft); }
  .spinner { width:30px; height:30px; border:3px solid var(--line); border-top-color:var(--ink); border-radius:50%; animation:spin .8s linear infinite; }
  .retry { border:0; border-radius:999px; padding:11px 16px; background:var(--ink); color:white; font-weight:800; cursor:pointer; }
  footer { display:flex; justify-content:space-between; gap:30px; padding:32px clamp(18px,5vw,76px); background:var(--ink); color:white; }
  footer p { margin:0; max-width:640px; color:rgba(255,255,255,.72); font-size:13px; line-height:1.5; }
  footer p:first-child { color:var(--lime); font-family:Georgia,"Times New Roman",serif; font-size:22px; }
  @keyframes spin { to { transform:rotate(360deg); } }
  @media (max-width:850px) { .hero { grid-template-columns:1fr; gap:32px; } .hero-note { max-width:470px; } .toolbar { grid-template-columns:1fr 1fr; } .membership-toggle { grid-column:1/-1; } }
  @media (max-width:560px) { .site-header { min-height:70px; padding:11px 16px; } .brand small { display:none; } .header-meta { max-width:190px; flex-wrap:wrap; gap:5px 8px; } .freshness { order:3; flex:0 0 100%; max-width:none; font-size:10px; } main { padding-inline:12px; } .hero { padding-top:48px; } .hero-note { margin-right:7px; } .toolbar { grid-template-columns:1fr; padding:12px; border-radius:16px 16px 6px 16px; } .membership-toggle { grid-column:auto; } .commodity-heading { align-items:flex-start; padding:18px; } .best-summary { min-width:auto; } .store-grid { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; } .store-card { min-width:76vw; max-width:290px; scroll-snap-align:start; } footer { flex-direction:column; } }
  @media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; animation-duration:.01ms!important; transition-duration:.01ms!important; } }
</style>
