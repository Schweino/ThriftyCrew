{
  "name": "@thriftycrew/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "run": "tsx src/runner.ts",
    "fixture": "tsx src/runner.ts --fixture",
    "eval": "tsx src/eval.ts",
    "eval:fixtures": "tsx src/eval.ts --fixtures-only"
  },
  "dependencies": {
    "@openai/agents": "0.14.3",
    "@openai/codex-sdk": "0.147.0",
    "@thriftycrew/contracts": "workspace:*",
    "@thriftycrew/daily": "workspace:*",
    "@thriftycrew/domain": "workspace:*",
    "zod": "4.4.3"
  }
}
