{
  "name": "@thriftycrew/grocery-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.16 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:current": "vitest run apps/daily/src/legacy.test.ts",
    "test:watch": "vitest",
    "check": "pnpm config:check && pnpm schedules:check && pnpm agents:check && pnpm agents:eval:fixtures && pnpm migrations:check && pnpm deploy:verify:selftest && pnpm efficiency:check:selftest && pnpm typecheck && pnpm test && pnpm build",
    "tc": "pnpm --filter @thriftycrew/operator tc",
    "config:generate": "pnpm tc config generate",
    "config:check": "pnpm tc config check",
    "schedules:check": "pnpm tc schedules check",
    "agents:check": "pnpm tc agents check",
    "agents:eval:fixtures": "pnpm --filter @thriftycrew/agents eval:fixtures",
    "migrations:check": "node scripts/check-migrations.mjs",
    "deploy:verify:selftest": "node scripts/verify-deployment.mjs --self-test",
    "efficiency:check": "node scripts/d1-efficiency-report.mjs",
    "efficiency:check:selftest": "node scripts/d1-efficiency-report.mjs --self-test",
    "codex:runtime:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-codex-node-override.ps1",
    "codex:runtime:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-codex-node-override.ps1 -CheckOnly",
    "restore:prepare": "node scripts/prepare-d1-restore.mjs",
    "restore:rows": "node scripts/restore-d1-recovery-rows.mjs",
    "db:migrate:local": "wrangler d1 migrations apply tc-grocery-v3 --local",
    "db:reset:local": "wrangler d1 migrations apply tc-grocery-v3 --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply tc-grocery-v3 --remote",
    "deploy": "node scripts/deploy.mjs",
    "dev": "pnpm --filter @thriftycrew/api dev",
    "dev:site": "pnpm --filter @thriftycrew/site dev",
    "bridge:current": "pnpm --filter @thriftycrew/daily bridge:current",
    "replay:current": "pnpm --filter @thriftycrew/daily replay:current"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "@types/node": "24.10.11",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
