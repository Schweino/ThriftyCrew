{
  "rules": [
    {
      "id": "Default Multipart Abort Rule",
      "enabled": true,
      "conditions": {},
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 604800 }
      }
    },
    {
      "id": "Archive batch evidence then expire",
      "enabled": true,
      "conditions": { "prefix": "batches/" },
      "storageClassTransitions": [
        { "storageClass": "InfrequentAccess", "condition": { "type": "Age", "maxAge": 2592000 } }
      ],
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 34560000 }
      }
    },
    {
      "id": "Archive release payloads then expire",
      "enabled": true,
      "conditions": { "prefix": "releases/" },
      "storageClassTransitions": [
        { "storageClass": "InfrequentAccess", "condition": { "type": "Age", "maxAge": 2592000 } }
      ],
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 34560000 }
      }
    },
    {
      "id": "Bound encrypted capture journal recovery points",
      "enabled": true,
      "conditions": { "prefix": "capture-journals/" },
      "storageClassTransitions": [
        { "storageClass": "InfrequentAccess", "condition": { "type": "Age", "maxAge": 604800 } }
      ],
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 3888000 }
      }
    }
  ]
}
