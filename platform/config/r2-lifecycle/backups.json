{
  "rules": [
    {
      "id": "Default Multipart Abort Rule",
      "enabled": true,
      "conditions": {},
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 604800 }
      }
    },
    {
      "id": "Archive weekly D1 exports then expire",
      "enabled": true,
      "conditions": { "prefix": "d1/" },
      "storageClassTransitions": [
        { "storageClass": "InfrequentAccess", "condition": { "type": "Age", "maxAge": 2592000 } }
      ],
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 7776000 }
      }
    },
    {
      "id": "Expire hot recovery checkpoints",
      "enabled": true,
      "conditions": { "prefix": "d1-checkpoints/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 7776000 }
      }
    },
    {
      "id": "Expire restore staging fallback",
      "enabled": true,
      "conditions": { "prefix": "restore-" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 604800 }
      }
    }
  ]
}
