{
  "version": 1,
  "agentId": "recipe-mapper",
  "thresholdMillis": 950,
  "cases": [
    {
      "id": "known-alias",
      "input": { "ingredient": "2 cans garbanzo beans", "sourceServings": 4, "targetServings": 14, "commodities": [{ "id": "chickpeas", "name": "Canned chickpeas" }] },
      "expect": { "decision": "chickpeas", "mustMention": ["garbanzo"] }
    },
    {
      "id": "unknown-commodity",
      "input": { "ingredient": "1 tablespoon dragonfruit powder", "sourceServings": 4, "targetServings": 14, "commodities": [{ "id": "apples", "name": "Apples" }] },
      "expect": { "decision": "unmapped", "mustMention": ["dragonfruit"] }
    },
    {
      "id": "missing-yield",
      "input": { "ingredient": "2 lb chicken breast", "sourceServings": null, "targetServings": 14, "commodities": [{ "id": "chicken-breast", "name": "Chicken breast" }] },
      "expect": { "decision": "chicken-breast", "mustMention": ["yield"] }
    },
    {
      "id": "standard-unmodified-grocery-form",
      "input": { "ingredient": "1 onion and 2 cloves chopped garlic", "sourceServings": 4, "targetServings": 14, "commodities": [{ "id": "onions", "name": "Yellow or sweet onions" }, { "id": "garlic", "name": "Fresh garlic" }] },
      "expect": { "decision": "mapped", "mustMention": ["onions", "garlic"] }
    },
    {
      "id": "explicit-form-conflict",
      "input": { "ingredient": "1 tablespoon jarred minced garlic", "sourceServings": 4, "targetServings": 14, "commodities": [{ "id": "garlic", "name": "Fresh garlic" }] },
      "expect": { "decision": "unmapped", "mustMention": ["jarred"] }
    },
    {
      "id": "insubstantial-accompaniment",
      "input": {
        "sourceServings": 4,
        "targetServings": 14,
        "ingredients": [
          { "name": "whole chicken", "scaledGrams": 6350, "commodityId": "whole-chicken" },
          { "name": "onion", "scaledGrams": 525, "commodityId": "onions" }
        ],
        "mealComponents": [
          { "role": "main", "commodityIds": ["whole-chicken"] },
          { "role": "substantial-accompaniment", "commodityIds": ["onions"] }
        ]
      },
      "expect": { "decision": "unmapped", "mustMention": ["980", "accompaniment"] }
    }
  ]
}
