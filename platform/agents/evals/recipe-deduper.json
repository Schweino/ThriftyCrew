    {
      "id": "near-duplicate-concepts",
      "input": {
        "catalog": [],
        "candidates": [
          { "id": "candidate-1", "title": "Creamy Salsa Chicken Rice", "proteinClass": "chicken", "method": "slow cooker", "ingredients": ["chicken", "salsa", "rice"] },
          { "id": "candidate-2", "title": "Slow Cooker Tex-Mex Chicken Bowl", "proteinClass": "chicken", "method": "slow cooker", "ingredients": ["chicken", "salsa", "rice"] }
        ]
      },
      "expect": { "decision": "duplicate", "mustMention": ["flavor"] }
