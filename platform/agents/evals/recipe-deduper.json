        "catalog": [],
        "candidates": [
          { "id": "candidate-1", "title": "Bean Chili", "proteinClass": "beans", "method": "stovetop simmer", "ingredients": ["beans", "tomatoes"] },
          { "id": "candidate-2", "title": "Lemon Chicken Orzo", "proteinClass": "chicken", "method": "oven bake", "ingredients": ["chicken", "lemon", "orzo"] }
