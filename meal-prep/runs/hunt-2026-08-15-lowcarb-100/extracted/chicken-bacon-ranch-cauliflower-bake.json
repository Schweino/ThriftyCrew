  "ingredients": [
    { "raw": "8 ounces cooked chicken breast shredded or diced (about 2 cups)", "item": "cooked chicken breast", "qty": "8", "unit": "ounces", "prep": "shredded or diced", "optional": false, "section": null },
    { "raw": "1 Tbsp salted butter", "item": "salted butter", "qty": "1", "unit": "Tbsp", "prep": null, "optional": false, "section": null },
    { "raw": "2 cups chopped raw cauliflower", "item": "raw cauliflower", "qty": "2", "unit": "cups", "prep": "chopped", "optional": false, "section": null },
    { "raw": "2 oz cream cheese", "item": "cream cheese", "qty": "2", "unit": "oz", "prep": null, "optional": false, "section": null },
    { "raw": "\u2153 cup heavy cream", "item": "heavy cream", "qty": "1/3", "unit": "cup", "prep": null, "optional": false, "section": null },
    { "raw": "1 cup shredded cheddar cheese divided", "item": "shredded cheddar cheese", "qty": "1", "unit": "cup", "prep": "divided", "optional": false, "section": null },
    { "raw": "1 tsp ranch dressing mix dry", "item": "ranch dressing mix", "qty": "1", "unit": "tsp", "prep": "dry", "optional": false, "section": null },
    { "raw": "\u00bc cup bacon bits", "item": "bacon bits", "qty": "1/4", "unit": "cup", "prep": null, "optional": false, "section": null }
  ],
  "instructions": [
    "Shred chicken and chop cauliflower; set aside. Spray a 6 cup baking dish with cooking spray. (Mine is a Pyrex that is 8\"x6\", but any oven safe dish will work.) Preheat oven to 350 degrees.",
    "In a saucepan over medium heat, saute cauliflower in butter until crisp tender, about 5-8 minutes.",
    "Turn heat to low. Add cream cheese and cream; cook and stir until the cream cheese is completely melted.",
    "Stir in chicken, 1/2 cup of cheddar cheese, dry ranch dressing mix, and bacon.",
    "Spread mixture in prepared baking dish. Sprinkle remaining 1/2 cup cheese over the top.",
    "Bake at 350\u00b0 for about 15 minutes, or until cheese is melted and casserole is hot and bubbly."
  ],
