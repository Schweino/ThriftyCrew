/smp-feed.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800
  Content-Type: application/json; charset=utf-8

# This week's free-dinner rotation (rotate-free-dinners.ps1). The join interstitial on every recipe page
# fetches it to decide whether THIS page is one of the free ones - without CORS the fetch fails silently
# and free pages fall back to the returning-visitors-only behavior (exactly the bug on launch day).
/free-dinners.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900
  Content-Type: application/json; charset=utf-8

# Per-item weekly price history for the board's "history" modal. Served here instead of embedded in the
# board post: it was a 252 KB inline blob shipped to EVERY visitor (on mobile) to support an occasional
# click, and it pushed the post payload past Ghost's upsert timeout (503). Fetched lazily on first open.
/price-history.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800
  Content-Type: application/json; charset=utf-8

# Per-row store-chip HTML for the board's expandable breakdown. Served here instead of inlined in the post:
# .pg-stores is display:none until a row opens, so it was ~1.1 MB of hidden markup that pushed the Ghost upsert
# past its processing timeout (503 = board unpublishable). The post keeps each row's cheapest-price answer.
/board.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800
  Content-Type: application/json; charset=utf-8
