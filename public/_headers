/smp-feed.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800
  Content-Type: application/json; charset=utf-8

# This week's free-dinner rotation (rotate-free-dinners.ps1). The join interstitial on every recipe page
# fetches it to decide whether THIS page is one of the free ones - without CORS the fetch fails silently
# and free pages fall back to the returning-visitors-only behavior (exactly the bug on launch day).
/free-dinners.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900
  Content-Type: application/json; charset=utf-8

# Per-item weekly price history for the board's "history" modal. Served here instead of embedded in the
# board post: it was a 252 KB inline blob shipped to EVERY visitor (on mobile) to support an occasional
# click, and it pushed the post payload past Ghost's upsert timeout (503). Fetched lazily on first open.
/price-history.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800
  Content-Type: application/json; charset=utf-8

# Per-row store-chip HTML for the board's expandable breakdown. Served here instead of inlined in the post:
# .pg-stores is display:none until a row opens, so it was ~1.1 MB of hidden markup that pushed the Ghost upsert
# past its processing timeout (503 = board unpublishable). The post keeps each row's cheapest-price answer.
/board.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800
  Content-Type: application/json; charset=utf-8

# Per-recipe data for the Meal Plan Builder tool (gen-planner-data.ps1). Served here instead of embedded in
# the members post: it was ~815 KB at 513 recipes and heading past Ghost's ~1.6 MB lexical-upsert 503 ceiling
# at ~1000 recipes (same failure class as board.json/price-history above). The tool fetches it at load time.
# MEMBERS ONLY since 2026-09-18 (Brad): worker/index.js answers this path itself and serves it only to a paid
# member's Ghost identity token, with its own private headers. These lines are the fallback, and say so.
/planner-data.json
  Access-Control-Allow-Origin: https://www.thriftycrew.com
  Cache-Control: private, no-store
  Content-Type: application/json; charset=utf-8

# The live-price fill for every page that is not a recipe card (articles, the homepage quote, tools), GENERATED from the
# recipe card template by meal-prep/pipeline/build-live-price-script.ps1. Same cache as the feed it reads.
/tc-live-price.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800
  Content-Type: application/javascript; charset=utf-8
